<!--
    VSYNC / TEARING WARNING
    ──────────────────────────────────────────────────────────────────
    Do NOT add `AllowsTransparency="True"` back to this window.
    It forces WS_EX_LAYERED (layered window) on the HWND, which disables
    DWM Multi-Plane Overlay and Independent Flip for every other window
    on the desktop — including the foreground game. NVIDIA driver-level
    VSync relies on MPO/Independent Flip, so a layered transparent window
    system-wide breaks the driver's VSync and causes hard tearing on
    NVIDIA GPUs while Systema is running.
    Use WindowChrome (below) for custom chrome; use DWMWA_WINDOW_CORNER_PREFERENCE
    from MainWindow.xaml.cs for Win11 rounded corners. Never AllowsTransparency.
-->
<Window x:Class="Systema.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Systema.ViewModels"
        xmlns:views="clr-namespace:Systema.Views"
        xmlns:conv="clr-namespace:Systema.Core.Converters"
        Title="Systema" Height="820" Width="1280"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource BgPrimaryBrush}"
        WindowStartupLocation="CenterScreen"
        Activated="Window_Activated"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">
    <WindowChrome.WindowChrome>
        <!-- Custom chrome without the VSync-breaking layered-window path.
             CaptionHeight=0: our own title bar handles drag via MouseLeftButtonDown.
             ResizeBorderThickness=0: the window is fixed-size (ResizeMode=NoResize) so
             there is no resize grip.
             GlassFrameThickness=0 + UseAeroCaptionButtons=False: no native caption. -->
        <WindowChrome CaptionHeight="0"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Builds each page once and reuses it (Views/PageViewCache.cs), from the DataTemplates below. -->
        <views:PageViewCache x:Key="PageViews"/>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MemoryViewModel}">
            <views:MemoryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ServicesViewModel}">
            <views:ServicesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VisualViewModel}">
            <views:VisualView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GameBoosterViewModel}">
            <views:GameBoosterView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ToolsViewModel}">
            <views:ToolsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TaskSleepViewModel}">
            <views:TaskSleepView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BloatwareViewModel}">
            <views:BloatwareView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GraphicsViewModel}">
            <views:GraphicsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AudioViewModel}">
            <views:AudioView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:IntelGpuViewModel}">
            <views:IntelView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NvidiaGpuViewModel}">
            <views:NvidiaView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DellViewModel}">
            <views:DellView/>
        </DataTemplate>

        <!-- ── Ctrl+K search ─────────────────────────────────────────────── -->
        <!-- The search box in the title bar. It's a button that opens the palette, like the
             Settings app's search, so the title bar keeps no live text field. -->
        <Style x:Key="TitleSearchBox" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ControlFillBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlStrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="IBeam"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="10,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ControlFillHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chromeless input for the palette; the palette itself is the frame. -->
        <Style x:Key="SearchInputBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBlueBrush}"/>
            <Setter Property="SelectionOpacity" Value="0.35"/>
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Result rows: a subtle highlight under the pointer and an accent pill on the row that
             Enter will open, the same selection language as the nav and the dropdowns. -->
        <Style x:Key="SearchResultsList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid Margin="0,1">
                                        <Border x:Name="Bg" CornerRadius="4" Background="Transparent"/>
                                        <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Background="{StaticResource AccentBlueBrush}" Opacity="0"/>
                                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource PopupItemHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource SubtleSelectedBrush}"/>
                                            <Setter TargetName="Pill" Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Rounded corners are provided by DWM on Win11 via DwmSetWindowAttribute in
         MainWindow.xaml.cs. No Border CornerRadius / DropShadowEffect here — both
         would require layered-window mode which breaks VSync system-wide. -->
    <Border Background="{StaticResource BgPrimaryBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">

        <Grid>
            <!-- Flat charcoal base. The decorative backdrop (gradient wash, radial
                 glows, tiled grid, radar rings) was removed: it cost four large
                 RadialGradientBrushes plus a tiled DrawingBrush composited on every
                 frame, and the flat ground reads cleaner. -->

            <Grid>
            <Grid.RowDefinitions>
                <!-- 38px: close to the Win11 caption height (32) while still giving the
                     brand mark room. Was 48, which read as a heavy band across the top. -->
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== TITLE BAR ===== -->
            <!-- Windows 11 caption: same colour as the window, so the title bar, nav pane and
                 page read as one surface, the way the Settings app does. -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgPrimaryBrush}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App mark + name in the Windows 11 caption style (12px, regular weight) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="16,0">
                        <!-- The Systema logo (the same logo.ico the tray and taskbar use, set in
                             MainWindow.xaml.cs). The accent square only shows if it can't load. -->
                        <Grid Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Border x:Name="TitleLogoFallback" Width="14" Height="14" CornerRadius="4"
                                    Background="{StaticResource AccentBlueBrush}"/>
                            <Image x:Name="TitleLogo" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                        <TextBlock Text="Systema" FontSize="12"
                                   FontFamily="{StaticResource SmallFont}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="Beta" FontSize="12"
                                   FontFamily="{StaticResource SmallFont}"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- (Download + Discord moved to the sidebar footer, bottom-left.)
                         This middle column stays empty so it remains a draggable title-bar area. -->
                    <!-- Search box (Ctrl+K). Fixed width and centred, so the title bar either side
                         of it is still a drag area. -->
                    <Button x:Name="SearchBox" Grid.Column="1" Width="360" Height="28"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Style="{StaticResource TitleSearchBox}"
                            Click="SearchBox_Click" ToolTip="Search every setting (Ctrl+K)">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"
                                  Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center">
                                <Path.Data>
                                    <GeometryGroup>
                                        <EllipseGeometry Center="10.5,10.5" RadiusX="6.5" RadiusY="6.5"/>
                                        <LineGeometry StartPoint="15.3,15.3" EndPoint="20,20"/>
                                    </GeometryGroup>
                                </Path.Data>
                            </Path>
                            <TextBlock Grid.Column="1" Text="Search settings" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Border Grid.Column="2" BorderBrush="{StaticResource ControlStrokeBrush}" BorderThickness="1"
                                    CornerRadius="3" Padding="5,0" VerticalAlignment="Center">
                                <TextBlock Text="Ctrl K" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"/>
                            </Border>
                        </Grid>
                    </Button>

                    <!-- Window Buttons.
                         No Maximize — the window is fixed-size (ResizeMode=NoResize).
                         No Minimize — it ran the same Hide()-to-tray code as Close, so it was a
                         second control that did an identical thing. Close hides to tray; the tray
                         icon restores, and tray "Exit" fully quits. -->
                    <!-- Flush to the corner, full caption height, as Windows 11 draws it. -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Top">
                        <Button Click="CloseButton_Click" ToolTip="Close to tray"
                                Style="{StaticResource CaptionCloseButton}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== CONTENT AREA ===== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== SIDEBAR ===== -->
                <!-- Windows 11 nav pane: it sits on the window base with no divider, exactly as
                     in the Settings app. No live BlurEffect or translucent overlay: a GPU
                     pixel-shader effect on an unsigned binary is a needless SmartScreen and
                     Defender heuristic risk, and the Settings look doesn't need one. -->
                <Border Grid.Column="0"
                        Background="{StaticResource BgSidebarBrush}"
                        BorderThickness="0"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                        <!-- The list and its selection indicator share one Grid so the indicator
                             scrolls with the items. The indicator is drawn on a Canvas above the
                             list and moved by MainWindow.xaml.cs when ActiveSection changes. -->
                        <Grid>
                        <StackPanel x:Name="NavList" Margin="8,12,8,0">
                            <!-- Crisp vector line-icons. Shared style sets the stroke look; each
                                 Path supplies its own 24x24 geometry, scaled by a Viewbox so the
                                 stroke stays sharp at any DPI. -->
                            <StackPanel.Resources>
                                <Style x:Key="NavIcon" TargetType="Path">
                                    <Setter Property="Stroke" Value="{StaticResource TextPrimaryBrush}"/>
                                    <Setter Property="StrokeThickness" Value="1.5"/>
                                    <Setter Property="StrokeLineJoin" Value="Round"/>
                                    <Setter Property="StrokeStartLineCap" Value="Round"/>
                                    <Setter Property="StrokeEndLineCap" Value="Round"/>
                                    <Setter Property="Fill" Value="Transparent"/>
                                </Style>
                            </StackPanel.Resources>

                            <!-- Auto Pilot — home / landing (CommandParameter + Tag stay "Dashboard" as the internal nav key) -->
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                                    Tag="Dashboard" Style="{StaticResource NavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <Path Style="{StaticResource NavIcon}"
                                              Data="M3 10.5 L12 3 L21 10.5 M5.5 9 V19.5 A1 1 0 0 0 6.5 20.5 H17.5 A1 1 0 0 0 18.5 19.5 V9 M9.5 20.5 V14.5 H14.5 V20.5"/>
                                    </Viewbox>
                                    <TextBlock Text="Home"/>
                                </StackPanel>
                            </Button>

                            <!-- Memory &amp; Startup — grid -->
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Memory"
                                    Tag="Memory" Style="{StaticResource NavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <Path Style="{StaticResource NavIcon}"
                                              Data="M4 5 H20 A1 1 0 0 1 21 6 V18 A1 1 0 0 1 20 19 H4 A1 1 0 0 1 3 18 V6 A1 1 0 0 1 4 5 Z M3 12 H21 M12 5 V19"/>
                                    </Viewbox>
                                    <TextBlock Text="Memory &amp; Startup"/>
                                </StackPanel>
                            </Button>

                            <!-- Cleanup &amp; Privacy — droplet -->
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Services"
                                    Tag="Services" Style="{StaticResource NavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <Path Style="{StaticResource NavIcon}"
                                              Data="M12 3 C12 3 5.5 10 5.5 14.5 A6.5 6.5 0 0 0 18.5 14.5 C18.5 10 12 3 12 3 Z"/>
                                    </Viewbox>
                                    <TextBlock Text="Cleanup &amp; Privacy"/>
                                </StackPanel>
                            </Button>

                            <!-- Visual &amp; Power — lightning -->
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Visual"
                                    Tag="Visual" Style="{StaticResource NavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <Path Style="{StaticResource NavIcon}"
                                              Data="M13 2.5 L4.5 13.5 H11 L11 21.5 L19.5 10.5 H13 L13 2.5 Z"/>
                                    </Viewbox>
                                    <TextBlock Text="Visual &amp; Power"/>
                                </StackPanel>
                            </Button>

                            <!-- Game Booster — share / network -->
                            <Button Command="{Binding NavigateCommand}" CommandParameter="GameBooster"
                                    Tag="GameBooster" Style="{StaticResource NavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <Path Style="{StaticResource NavIcon}"
                                              Data="M8.8 10.8 L15.2 6.9 M8.8 13.2 L15.2 17.1 M15 6 A2.2 2.2 0 1 0 19.4 6 A2.2 2.2 0 1 0 15 6 Z M4.6 12 A2.2 2.2 0 1 0 9 12 A2.2 2.2 0 1 0 4.6 12 Z M15 18 A2.2 2.2 0 1 0 19.4 18 A2.2 2.2 0 1 0 15 18 Z"/>
                                    </Viewbox>
                                    <TextBlock Text="Game Booster"/>
                                </StackPanel>
                            </Button>

                            <!-- System Tweaks — shield + check -->
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Tools"
                                    Tag="Tools" Style="{StaticResource NavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <Path Style="{StaticResource NavIcon}"
                                              Data="M12 3 L19 6 V11.5 C19 16 16 19.5 12 21 C8 19.5 5 16 5 11.5 V6 L12 3 Z M9.3 12 L11 13.7 L14.7 10"/>
                                    </Viewbox>
                                    <TextBlock Text="System Tweaks"/>
                                </StackPanel>
                            </Button>

                            <!-- Systema Engine (Task Sleep + Launch Boost + responsiveness) — sparkles -->
                            <Button Command="{Binding NavigateCommand}" CommandParameter="TaskSleep"
                                    Tag="TaskSleep" Style="{StaticResource NavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <Path Style="{StaticResource NavIcon}"
                                              Data="M12 3 L13.6 9.4 L20 11 L13.6 12.6 L12 19 L10.4 12.6 L4 11 L10.4 9.4 Z M18 16 L18.6 18.4 L21 19 L18.6 19.6 L18 22 L17.4 19.6 L15 19 L17.4 18.4 Z"/>
                                    </Viewbox>
                                    <TextBlock Text="Systema Engine"/>
                                </StackPanel>
                            </Button>

                            <!-- App Cleanup — gamepad -->
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Bloatware"
                                    Tag="Bloatware" Style="{StaticResource NavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <Path Style="{StaticResource NavIcon}"
                                              Data="M8 9 H16 A5 5 0 0 1 21 14 A2 2 0 0 1 17.4 15.2 L16 13.5 H8 L6.6 15.2 A2 2 0 0 1 3 14 A5 5 0 0 1 8 9 Z M6.7 11.7 V13.7 M5.7 12.7 H7.7 M15 12 A0.55 0.55 0 1 0 15.01 12 Z M16.8 13.7 A0.55 0.55 0 1 0 16.81 13.7 Z"/>
                                    </Viewbox>
                                    <TextBlock Text="App Cleanup"/>
                                </StackPanel>
                            </Button>

                            <!-- Graphics — monitor with frame -->
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Graphics"
                                    Tag="Graphics" Style="{StaticResource NavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <Path Style="{StaticResource NavIcon}"
                                              Data="M3.5 4 H20.5 A0.5 0.5 0 0 1 21 4.5 V16.5 A0.5 0.5 0 0 1 20.5 17 H3.5 A0.5 0.5 0 0 1 3 16.5 V4.5 A0.5 0.5 0 0 1 3.5 4 Z M7 20 H17 M12 17 V20 M7.5 13.5 L10 9.5 L12 12.5 L14 8 L16.5 13.5"/>
                                    </Viewbox>
                                    <TextBlock Text="Graphics"/>
                                </StackPanel>
                            </Button>

                            <!-- Audio — speaker with sound waves -->
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Audio"
                                    Tag="Audio" Style="{StaticResource NavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <Path Style="{StaticResource NavIcon}"
                                              Data="M4 9 H7 L11 5 V19 L7 15 H4 Z M15 9 A4 4 0 0 1 15 15 M17.5 7 A7.5 7.5 0 0 1 17.5 17"/>
                                    </Viewbox>
                                    <TextBlock Text="Audio"/>
                                </StackPanel>
                            </Button>

                            <!-- Separator before hardware section -->
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="8,12"
                                    Visibility="{Binding HasOnDeviceSections, Converter={StaticResource BoolToVis}}"/>

                            <!-- Intel Graphics — monitor -->
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Intel"
                                    Tag="Intel" Style="{StaticResource NavButton}"
                                    Visibility="{Binding IsIntelGpuPresent, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <Path Style="{StaticResource NavIcon}"
                                              Data="M3.5 5 H20.5 A0.5 0.5 0 0 1 21 5.5 V15.5 A0.5 0.5 0 0 1 20.5 16 H3.5 A0.5 0.5 0 0 1 3 15.5 V5.5 A0.5 0.5 0 0 1 3.5 5 Z M8 20 H16 M12 16 V20"/>
                                    </Viewbox>
                                    <TextBlock Text="Intel Graphics"/>
                                </StackPanel>
                            </Button>

                            <!-- Nvidia Graphics — only on systems with an NVIDIA GPU -->
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Nvidia"
                                    Tag="Nvidia" Style="{StaticResource NavButton}"
                                    Visibility="{Binding IsNvidiaGpuPresent, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <Path Style="{StaticResource NavIcon}"
                                              Data="M3.5 5 H20.5 A0.5 0.5 0 0 1 21 5.5 V15.5 A0.5 0.5 0 0 1 20.5 16 H3.5 A0.5 0.5 0 0 1 3 15.5 V5.5 A0.5 0.5 0 0 1 3.5 5 Z M8 20 H16 M12 16 V20"/>
                                    </Viewbox>
                                    <TextBlock Text="Nvidia Graphics"/>
                                </StackPanel>
                            </Button>

                            <!-- Dell — display -->
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Dell"
                                    Tag="Dell" Style="{StaticResource NavButton}"
                                    Visibility="{Binding IsDellPresent, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <Path Style="{StaticResource NavIcon}"
                                              Data="M4.5 5 H19.5 A0.5 0.5 0 0 1 20 5.5 V18.5 A0.5 0.5 0 0 1 19.5 19 H4.5 A0.5 0.5 0 0 1 4 18.5 V5.5 A0.5 0.5 0 0 1 4.5 5 Z M9 10 H15 V14 H9 Z"/>
                                    </Viewbox>
                                    <TextBlock Text="Dell"/>
                                </StackPanel>
                            </Button>

                            <!-- Separator before Settings -->
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="8,12"/>

                            <!-- Settings — gear -->
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Settings"
                                    Tag="Settings" Style="{StaticResource NavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <Path Style="{StaticResource NavIcon}"
                                              Data="M9 12 A3 3 0 1 0 15 12 A3 3 0 1 0 9 12 Z M12 3.5 V6 M12 18 V20.5 M3.5 12 H6 M18 12 H20.5 M5.6 5.6 L7.4 7.4 M16.6 16.6 L18.4 18.4 M18.4 5.6 L16.6 7.4 M7.4 16.6 L5.6 18.4"/>
                                    </Viewbox>
                                    <TextBlock Text="Settings"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Windows 11 selection pill: one indicator that slides to the active item.
                             Hidden until it has been placed, so it never flashes at the top. -->
                        <Canvas x:Name="NavCanvas" IsHitTestVisible="False">
                            <Border x:Name="NavIndicator" Canvas.Left="11" Width="3" Height="16"
                                    CornerRadius="1.5" Opacity="0"
                                    Background="{StaticResource AccentBlueBrush}">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="NavIndicatorShift"/>
                                </Border.RenderTransform>
                            </Border>
                        </Canvas>
                        </Grid>
                        </ScrollViewer>

                        <!-- ===== UPDATE / VERSION FOOTER CARD =====
                             Binds to the shared SettingsVm so the check/download/install state
                             is identical to the Settings → Updates card (single source of truth). -->
                        <Border Grid.Row="1" Margin="8,8,8,12" Padding="12,10"
                                Background="{StaticResource BgCardBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="Systema v0.7.348" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,7"/>

                                <!-- Live status: green check + status text from the updater -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                    <Viewbox Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Top">
                                        <Path Data="M3 12.5 L9 18 L21 5"
                                              Stroke="{StaticResource AccentGreenBrush}" StrokeThickness="2.6"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" Fill="Transparent"/>
                                    </Viewbox>
                                    <!-- Wrap rather than ellipsize: a clipped version number
                                         ("v0.7.25…") reads as broken, two short lines do not. -->
                                    <TextBlock Text="{Binding SettingsVm.UpdateStatus}"
                                               Style="{StaticResource CaptionText}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" MaxWidth="139"
                                               VerticalAlignment="Center"
                                               ToolTip="{Binding SettingsVm.UpdateStatus}"/>
                                </StackPanel>

                                <!-- Check for updates — same command as Settings → Updates -->
                                <Button Content="Check for updates" Style="{StaticResource GhostButton}"
                                        HorizontalAlignment="Stretch" Padding="0,6" FontSize="11"
                                        Command="{Binding SettingsVm.CheckForUpdatesCommand}"
                                        IsEnabled="{Binding SettingsVm.CanCheckNow}"/>

                                <!-- Install updates — only when an update is downloaded and ready -->
                                <Button Content="Install updates" Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Stretch" Padding="0,6" FontSize="11" Margin="0,6,0,0"
                                        Command="{Binding SettingsVm.InstallNowCommand}"
                                        Visibility="{Binding SettingsVm.IsReadyToInstall, Converter={StaticResource BoolToVis}}"/>

                                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,10,0,8"/>

                                <!-- Download + Discord (moved here from the title bar) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Click="DownloadButton_Click"
                                            Style="{StaticResource GhostButton}" Padding="4,5" FontSize="11"
                                            Margin="0,0,3,0" ToolTip="Open the Systema releases page on GitHub">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                       Margin="0,0,5,0" Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="Download" Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Click="DiscordButton_Click"
                                            Style="{StaticResource GhostButton}" Padding="4,5" FontSize="11"
                                            Margin="3,0,0,0" ToolTip="Join the Systema Discord">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                       Margin="0,0,5,0" Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="Discord" Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ===== MAIN CONTENT =====
                     Page transition: each new page fades in while rising 14px, over 250 ms on a
                     decelerate curve (WinUI's ControlNormalAnimationDuration and its "fast out,
                     slow in" easing). NotifyOnTargetUpdated raises Binding.TargetUpdated only when
                     CurrentView actually changes, so clicking the page you're already on does
                     nothing and the periodic auto-refresh never re-animates the page. -->
                <ContentControl x:Name="PageHost"
                                Grid.Column="1"
                                Content="{Binding CurrentView, NotifyOnTargetUpdated=True, Converter={StaticResource PageViews}}"
                                Background="Transparent">
                    <ContentControl.RenderTransform>
                        <TranslateTransform/>
                    </ContentControl.RenderTransform>
                    <ContentControl.Triggers>
                        <EventTrigger RoutedEvent="Binding.TargetUpdated">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="0" To="1" Duration="0:0:0.25">
                                        <DoubleAnimation.EasingFunction>
                                            <QuinticEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                     From="14" To="0" Duration="0:0:0.25">
                                        <DoubleAnimation.EasingFunction>
                                            <QuinticEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ContentControl.Triggers>
                </ContentControl>
            </Grid>

            <!-- ===== SEARCH PALETTE (Ctrl+K) =====
                 Covers the whole window. Clicking the dimmed area, pressing Esc, or picking a
                 result closes it. Results come from Core/SettingsSearchIndex; picking a setting
                 opens its page and briefly outlines the setting (MainWindow.xaml.cs). -->
            <Grid x:Name="SearchOverlay" Grid.RowSpan="2" Visibility="Collapsed"
                  Background="#66000000"
                  MouseLeftButtonDown="SearchOverlay_MouseLeftButtonDown">
                <Border x:Name="SearchPanel" Width="560" VerticalAlignment="Top" Margin="0,52,0,0"
                        Background="{StaticResource PopupBrush}"
                        BorderBrush="{StaticResource PopupStrokeBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="SearchPanelShift"/>
                    </Border.RenderTransform>
                    <StackPanel>
                        <Grid Height="48" Margin="16,0,16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0"
                                  Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center">
                                <Path.Data>
                                    <GeometryGroup>
                                        <EllipseGeometry Center="10.5,10.5" RadiusX="6.5" RadiusY="6.5"/>
                                        <LineGeometry StartPoint="15.3,15.3" EndPoint="20,20"/>
                                    </GeometryGroup>
                                </Path.Data>
                            </Path>
                            <TextBlock x:Name="SearchPlaceholder" Grid.Column="1"
                                       Text="Search settings, or type what you want"
                                       FontSize="15" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Foreground="{StaticResource TextTertiaryBrush}"/>
                            <TextBox x:Name="SearchInput" Grid.Column="1"
                                     Style="{StaticResource SearchInputBox}"
                                     TextChanged="SearchInput_TextChanged"
                                     PreviewKeyDown="SearchInput_PreviewKeyDown"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource PopupStrokeBrush}"/>
                        <ListBox x:Name="SearchResults" MaxHeight="360" Margin="6"
                                 Style="{StaticResource SearchResultsList}"
                                 PreviewMouseLeftButtonUp="SearchResults_PreviewMouseLeftButtonUp">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title, Mode=OneWay}" FontSize="14"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Where, Mode=OneWay}"
                                                   FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextTertiaryBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="SearchEmpty" Visibility="Collapsed" Margin="22,4,22,18"
                                   TextWrapping="Wrap" Style="{StaticResource CaptionText}"
                                   Text="Nothing matches that. Settings that can't apply to this PC are left out of search."/>
                    </StackPanel>
                </Border>
            </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
