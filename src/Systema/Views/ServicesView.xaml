<UserControl x:Class="Systema.Views.ServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Systema.Core.Converters"
             xmlns:models="clr-namespace:Systema.Models"
             Background="Transparent">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <!-- One segment of the Off · Manual · On control. Inactive = muted text on a
             transparent pill; the active state is applied per-button via a ColorState
             DataTrigger (it sets Background + Foreground), which the template surfaces
             through TemplateBinding. -->
        <Style x:Key="SegmentButton" TargetType="Button">
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding"    Value="15,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dims a section while Auto-Pilot manages it. -->
        <Style x:Key="ManagedSection" TargetType="StackPanel">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAutoPilotActive}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="Opacity"   Value="0.4"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Clickable category card (overview drill-down). -->
        <Style x:Key="CategoryCardButton" TargetType="Button">
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource BgCardBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="16,15">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,28">

            <!-- Header -->
            <TextBlock Text="Cleanup &amp; Privacy" Style="{StaticResource HeadingLarge}"/>
            <TextBlock Text="A quick read on what's running in the background, with one-click cleanup and plain-language categories."
                       Style="{StaticResource CaptionText}" Margin="0,4,0,20"/>

            <!-- ════════════════ OVERVIEW (dashboard) ════════════════ -->
            <StackPanel Visibility="{Binding IsOverview, Converter={StaticResource BoolToVis}}">

                <!-- Status tiles -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource BgSurfaceBrush}" CornerRadius="12" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="Background tasks" Style="{StaticResource CaptionText}"/>
                            <TextBlock Text="{Binding TotalBackgroundTasks}" FontSize="26" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource BgSurfaceBrush}" CornerRadius="12" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="Recommended off" Style="{StaticResource CaptionText}"/>
                            <TextBlock Text="{Binding RecommendedOffCount}" FontSize="26" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentYellowBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Background="{StaticResource BgSurfaceBrush}" CornerRadius="12" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="Already optimized" Style="{StaticResource CaptionText}"/>
                            <TextBlock Text="{Binding AlreadyOptimizedCount}" FontSize="26" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentGreenBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Recommended-cleanup card — single on/off toggle (drives the same
                     PrivacyCleanupApplied state the Dashboard reads). -->
                <Border CornerRadius="14" Padding="20,18" Margin="0,0,0,24"
                        Background="{StaticResource BgCardBrush}"
                        BorderBrush="{StaticResource AccentBlueBrush}" BorderThickness="2">
                    <StackPanel Style="{StaticResource ManagedSection}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                <TextBlock Text="Service Cleanup" Style="{StaticResource HeadingSmall}"/>
                                <TextBlock Text="{Binding RecommendedSummaryText}" Style="{StaticResource CaptionText}"
                                           TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      IsChecked="{Binding PrivacyCleanupApplied}"/>
                        </Grid>

                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                Margin="0,16,0,0" Padding="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,7,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PrivacyCleanupApplied}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding RecommendedStatusText}" Style="{StaticResource CaptionText}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="A restore point is created first."
                                           Style="{StaticResource CaptionText}" Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- No Telemetry Pro — kills ALL Windows telemetry (policy + services + tasks). -->
                <Border CornerRadius="14" Padding="20,18" Margin="0,0,0,24"
                        Background="{StaticResource BgCardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel Style="{StaticResource ManagedSection}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                <TextBlock Text="No Telemetry Pro" Style="{StaticResource HeadingSmall}"/>
                                <TextBlock Text="Turns off every Windows telemetry channel at once, as far as your edition allows. It sets the do not collect policies, disables the telemetry services (DiagTrack, error reporting, diagnostics hub), switches off the telemetry scheduled tasks, and stops typing, handwriting, and app inventory collection. Pro and Education get the fuller policy set. Fully reversible."
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      IsChecked="{Binding NoTelemetryPro}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                    Visibility="{Binding HasNoTelemetryStatus, Converter={StaticResource BoolToVis}}">
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,7,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NoTelemetryPro}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding NoTelemetryStatusText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Category cards (Privacy & data removed — the Recommended cleanup toggle covers it). -->
                <TextBlock Text="Browse by category" Style="{StaticResource HeadingMedium}" Margin="2,0,0,12"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource CategoryCardButton}"
                            Command="{Binding OpenCategoryCommand}" CommandParameter="performance">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Services" Style="{StaticResource HeadingSmall}"/>
                                <TextBlock Text="{Binding PerformanceCategorySubtitle}" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="&#x203A;" FontSize="20" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>
                    </Button>

                    <!-- Opens Windows' own "Turn Windows features on or off" panel directly (one click). -->
                    <Button Grid.Column="2" Style="{StaticResource CategoryCardButton}"
                            Command="{Binding OpenWindowsFeaturesCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Windows extras" Style="{StaticResource HeadingSmall}"/>
                                <TextBlock Text="Add or remove in Windows" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="&#x2197;" FontSize="18" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- ════════════════ PERFORMANCE detail (services) ════════════════ -->
            <StackPanel Visibility="{Binding IsPerformanceCategory, Converter={StaticResource BoolToVis}}">
                <Button Content="&#x2190; Back" Command="{Binding BackToOverviewCommand}"
                        Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,0,0,14"/>
                <TextBlock Text="Services" Style="{StaticResource HeadingMedium}" Margin="2,0,0,2"/>
                <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="2,0,0,10"
                           Text="Background services Windows runs for you. Each one explains what it does — pick how it starts:"/>
                <StackPanel Orientation="Horizontal" Margin="2,0,0,16">
                    <Ellipse Width="9" Height="9" Fill="{StaticResource AccentRedBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="Off — not using resources" Style="{StaticResource CaptionText}" Margin="0,0,16,0"/>
                    <Ellipse Width="9" Height="9" Fill="{StaticResource AccentYellowBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="Manual — starts only when needed" Style="{StaticResource CaptionText}" Margin="0,0,16,0"/>
                    <Ellipse Width="9" Height="9" Fill="{StaticResource AccentGreenBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="On — running" Style="{StaticResource CaptionText}"/>
                </StackPanel>

                <StackPanel Style="{StaticResource ManagedSection}">
                    <Border Style="{StaticResource Card}" Padding="0">
                        <ItemsControl ItemsSource="{Binding Services}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="16,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyText}"
                                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <Border CornerRadius="6" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                            Background="#22378ADD"
                                                            Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="Recommended" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource AccentBlueBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <!-- What it does (+ optional caution note in italic). -->
                                                <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="560"
                                                           HorizontalAlignment="Left">
                                                    <Run Text="{Binding Description, Mode=OneWay}"/><Run Text=" "/><Run
                                                        Text="{Binding Tooltip, Mode=OneWay}"
                                                        Foreground="{StaticResource AccentYellowBrush}" FontStyle="Italic"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Off · Manual · On segmented control. The active segment is
                                                 highlighted by the service's current start type (ColorState). -->
                                            <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="9" Padding="3"
                                                    Background="{StaticResource BgSurfaceBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Off"
                                                            Command="{Binding DataContext.DisableServiceCommand,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ColorState}" Value="{x:Static models:ServiceColorState.Red}">
                                                                        <Setter Property="Background" Value="#33C7556B"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Content="Manual"
                                                            Command="{Binding DataContext.SetManualCommand,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ColorState}" Value="{x:Static models:ServiceColorState.Yellow}">
                                                                        <Setter Property="Background" Value="#33C8A654"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource AccentYellowBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Content="On"
                                                            Command="{Binding DataContext.EnableServiceCommand,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ColorState}" Value="{x:Static models:ServiceColorState.Green}">
                                                                        <Setter Property="Background" Value="#335C9C7C"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Footer (always visible) -->
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Refresh" Style="{StaticResource GhostButton}"
                        Command="{Binding RefreshCommand}"/>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
