<UserControl x:Class="Systema.Views.ServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Systema.Core.Converters"
             Background="Transparent">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Dims a section while Auto-Pilot manages it. -->
        <Style x:Key="ManagedSection" TargetType="StackPanel">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAutoPilotActive}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="Opacity"   Value="0.4"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Clickable category card (overview drill-down). -->
        <Style x:Key="CategoryCardButton" TargetType="Button">
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource BgCardBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="16,15">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,28">

            <!-- Header -->
            <TextBlock Text="Cleanup &amp; Privacy" Style="{StaticResource HeadingLarge}"/>
            <TextBlock Text="Stop background services you don't need, and stop Windows collecting data about you."
                       Style="{StaticResource CaptionText}" Margin="0,4,0,20"/>

            <!-- ════════════════ OVERVIEW (dashboard) ════════════════ -->
            <StackPanel Visibility="{Binding IsOverview, Converter={StaticResource BoolToVis}}">


                <!-- Recommended-cleanup card — single on/off toggle (drives the same
                     PrivacyCleanupApplied state the Dashboard reads).
                     Both action cards now carry the SAME border weight: the old 2px accent
                     ring here implied this one mattered more, which was never true. -->
                <Border CornerRadius="12" Padding="20,18" Margin="0,0,0,14"
                        Background="{StaticResource BgCardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel Style="{StaticResource ManagedSection}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                <TextBlock Text="Service Cleanup" Style="{StaticResource HeadingSmall}"/>
                                <TextBlock Text="{Binding RecommendedSummaryText}" Style="{StaticResource CaptionText}"
                                           TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      IsChecked="{Binding PrivacyCleanupApplied}"/>
                        </Grid>

                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                Margin="0,16,0,0" Padding="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,7,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PrivacyCleanupApplied}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding RecommendedStatusText}" Style="{StaticResource CaptionText}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="A restore point is created first."
                                           Style="{StaticResource CaptionText}" Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- No Telemetry Pro — kills ALL Windows telemetry (policy + services + tasks).
                     The plain summary leads; the channel-by-channel detail moved behind a
                     disclosure so the card is scannable instead of a 60-word paragraph. -->
                <Border CornerRadius="12" Padding="20,18" Margin="0,0,0,24"
                        Background="{StaticResource BgCardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel Style="{StaticResource ManagedSection}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                <TextBlock Text="No Telemetry Pro" Style="{StaticResource HeadingSmall}"/>
                                <TextBlock Text="Stops Windows collecting and sending data about how you use your PC. Fully reversible."
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      IsChecked="{Binding NoTelemetryPro}"/>
                        </Grid>

                        <!-- What this turns off (disclosure) -->
                        <Button Command="{Binding ToggleTelemetryDetailsCommand}" Style="{StaticResource ExpanderButton}"
                                HorizontalContentAlignment="Left" Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="12.5" Foreground="{StaticResource AccentBlueBrush}"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="What this turns off"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TelemetryDetailsExpanded}" Value="True">
                                                    <Setter Property="Text" Value="Hide details"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock FontSize="10" Margin="7,0,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#x25BC;"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TelemetryDetailsExpanded}" Value="True">
                                                    <Setter Property="Text" Value="&#x25B2;"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <StackPanel Margin="0,8,0,0"
                                    Visibility="{Binding TelemetryDetailsExpanded, Converter={StaticResource BoolToVis}}">
                            <StackPanel.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </StackPanel.RenderTransform>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TelemetryDetailsExpanded}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0" To="1" Duration="0:0:0.18"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                         From="-6" To="0" Duration="0:0:0.18">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                       Text="&#x2022;  The &quot;do not collect&quot; policies, as far as your Windows edition allows"/>
                            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="&#x2022;  The telemetry services: DiagTrack, error reporting, and the diagnostics hub"/>
                            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="&#x2022;  The scheduled tasks that upload diagnostic data"/>
                            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="&#x2022;  Typing, handwriting, and app inventory collection"/>
                            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       Text="Windows Pro and Education get the fuller policy set."/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                    Visibility="{Binding HasNoTelemetryStatus, Converter={StaticResource BoolToVis}}">
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,7,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NoTelemetryPro}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding NoTelemetryStatusText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Both cards hand off to a Windows tool, so the heading says so. "Browse by
                     category" described an in-app drill-down that no longer exists. -->
                <TextBlock Text="Manage in Windows" Style="{StaticResource HeadingMedium}" Margin="2,0,0,4"/>
                <TextBlock Text="For anything beyond the toggles above, these open the tools Windows provides."
                           Style="{StaticResource CaptionText}" Margin="2,0,0,12"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Opens Windows' own Services console (services.msc) rather than an
                         in-app list, so per-service changes happen in the tool Windows
                         actually owns. -->
                    <Button Grid.Column="0" Style="{StaticResource CategoryCardButton}"
                            Command="{Binding OpenServicesMscCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Services" Style="{StaticResource HeadingSmall}"/>
                                <TextBlock Text="Open the Windows Services app" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="&#x2197;" FontSize="16" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>
                    </Button>

                    <!-- Opens Windows' own "Turn Windows features on or off" panel directly (one click). -->
                    <Button Grid.Column="2" Style="{StaticResource CategoryCardButton}"
                            Command="{Binding OpenWindowsFeaturesCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Windows extras" Style="{StaticResource HeadingSmall}"/>
                                <TextBlock Text="Add or remove in Windows" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="&#x2197;" FontSize="18" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>
                    </Button>
                </Grid>
            </StackPanel>


            <!-- Footer (always visible) -->
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Refresh" Style="{StaticResource GhostButton}"
                        Command="{Binding RefreshCommand}"/>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
