<UserControl x:Class="Systema.Views.ServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Systema.Core.Converters"
             xmlns:ctl="clr-namespace:Systema.Controls"
             Background="Transparent">

    <!-- Windows 11 Settings layout: one SettingsCard per setting, grouped under headers, and
         the Windows tools as "opens in Windows" link rows. Same bindings and text as before. -->

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Dims a section while Auto-Pilot manages it. -->
        <Style x:Key="ManagedSection" TargetType="StackPanel">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAutoPilotActive}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="Opacity"   Value="0.4"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A row that opens a Windows tool: the whole card is the button and lights up softly
             under the pointer, like Settings' "Related settings" links. -->
        <Style x:Key="CategoryCardButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin"                     Value="0,0,0,4"/>
            <Setter Property="FocusVisualStyle"           Value="{x:Null}"/>
            <Setter Property="ctl:Motion.Entrance"        Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="bd" Background="{DynamicResource CardLayerBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="18,14" MinHeight="68">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="Hover" CornerRadius="6" Background="{DynamicResource ControlFillBrush}"
                                    Opacity="0" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="0.6" Duration="0:0:0.083"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.167"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,28">

            <!-- ===== HEADER ===== -->
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="Cleanup &amp; privacy" Style="{StaticResource HeadingLarge}"/>
                <TextBlock Text="Stop background services you don't need, and stop Windows collecting data about you."
                           Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- ════════════════ OVERVIEW ════════════════ -->
            <StackPanel Visibility="{Binding IsOverview, Converter={StaticResource BoolToVis}}">

                <TextBlock Text="Privacy and background services" Style="{StaticResource SettingsGroupHeader}"/>

                <!-- Recommended cleanup: single on/off toggle (drives the same
                     PrivacyCleanupApplied state the Dashboard reads). -->
                <StackPanel Style="{StaticResource ManagedSection}">
                    <ctl:SettingsCard Header="Service cleanup" RecommendKey="PrivacyCleanup">
                        <ctl:SettingsCard.Description>
                            <StackPanel>
                                <TextBlock Text="{Binding RecommendedSummaryText}" Style="{StaticResource CardDescription}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,7,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PrivacyCleanupApplied}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource AccentGreenBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding RecommendedStatusText}" Style="{StaticResource CaptionText}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="A restore point is created first." Style="{StaticResource CardNote}"/>
                            </StackPanel>
                        </ctl:SettingsCard.Description>
                        <CheckBox Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding PrivacyCleanupApplied}"/>
                    </ctl:SettingsCard>

                    <!-- No Telemetry Pro: kills ALL Windows telemetry (policy + services + tasks).
                         The plain summary leads; the channel-by-channel detail sits behind a
                         disclosure so the card stays scannable. -->
                    <ctl:SettingsCard Header="No Telemetry Pro" RecommendKey="NoTelemetryPro">
                        <ctl:SettingsCard.Description>
                            <StackPanel>
                                <TextBlock Text="Stops Windows collecting and sending data about how you use your PC. Fully reversible."
                                           Style="{StaticResource CardDescription}"/>

                                <!-- What this turns off (disclosure) -->
                                <Button Command="{Binding ToggleTelemetryDetailsCommand}" Style="{StaticResource ExpanderButton}"
                                        HorizontalAlignment="Left" HorizontalContentAlignment="Left" Margin="-4,6,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="4,3">
                                        <TextBlock FontSize="12.5" Foreground="{DynamicResource AccentBlueBrush}"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="What this turns off"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TelemetryDetailsExpanded}" Value="True">
                                                            <Setter Property="Text" Value="Hide details"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Path Style="{StaticResource ExpanderChevron}" Margin="8,1,0,0"
                                              ctl:Motion.Flipped="{Binding TelemetryDetailsExpanded}"/>
                                    </StackPanel>
                                </Button>

                                <StackPanel Margin="0,6,0,0"
                                            Visibility="{Binding TelemetryDetailsExpanded, Converter={StaticResource BoolToVis}}">
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform Y="0"/>
                                    </StackPanel.RenderTransform>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TelemetryDetailsExpanded}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 From="0" To="1" Duration="0:0:0.25"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                                 From="-6" To="0" Duration="0:0:0.25">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <QuinticEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Style="{StaticResource CardDescription}"
                                               Text="&#x2022;  The &quot;do not collect&quot; policies, as far as your Windows edition allows"/>
                                    <TextBlock Style="{StaticResource CardDescription}" Margin="0,4,0,0"
                                               Text="&#x2022;  The telemetry services: DiagTrack, error reporting, and the diagnostics hub"/>
                                    <TextBlock Style="{StaticResource CardDescription}" Margin="0,4,0,0"
                                               Text="&#x2022;  The scheduled tasks that upload diagnostic data"/>
                                    <TextBlock Style="{StaticResource CardDescription}" Margin="0,4,0,0"
                                               Text="&#x2022;  Typing, handwriting, and app inventory collection"/>
                                    <TextBlock Style="{StaticResource CardDescription}" Margin="0,8,0,0"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               Text="Windows Pro and Education get the fuller policy set."/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                            Visibility="{Binding HasNoTelemetryStatus, Converter={StaticResource BoolToVis}}">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,7,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NoTelemetryPro}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource AccentGreenBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding NoTelemetryStatusText}" Style="{StaticResource CaptionText}"
                                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </ctl:SettingsCard.Description>
                        <CheckBox Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding NoTelemetryPro}"/>
                    </ctl:SettingsCard>
                </StackPanel>

                <!-- Both rows hand off to a Windows tool, so the heading says so. -->
                <TextBlock Text="Manage in Windows" Style="{StaticResource SettingsGroupHeader}" Margin="2,24,0,2"/>
                <TextBlock Text="For anything beyond the toggles above, these open the tools Windows provides."
                           Style="{StaticResource CaptionText}" Margin="2,0,0,8" TextWrapping="Wrap"/>

                <!-- Opens Windows' own Services console (services.msc) rather than an in-app list,
                     so per-service changes happen in the tool Windows actually owns. -->
                <Button Style="{StaticResource CategoryCardButton}" Command="{Binding OpenServicesMscCommand}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Services" Style="{StaticResource BodyText}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Open the Windows Services app" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="&#x2197;" FontSize="16" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>
                </Button>

                <!-- Opens Windows' own "Turn Windows features on or off" panel directly (one click). -->
                <Button Style="{StaticResource CategoryCardButton}" Command="{Binding OpenWindowsFeaturesCommand}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Windows extras" Style="{StaticResource BodyText}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Add or remove in Windows" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="&#x2197;" FontSize="16" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>
                </Button>
            </StackPanel>

            <!-- Footer (always visible) -->
            <Grid Margin="2,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
                <Button Grid.Column="1" Content="Refresh" Style="{StaticResource GhostButton}"
                        Command="{Binding RefreshCommand}"/>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
