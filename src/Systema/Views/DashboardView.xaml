<UserControl x:Class="Systema.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Systema.Core.Converters"
             xmlns:vm="clr-namespace:Systema.ViewModels"
             Background="Transparent">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,28">

            <!-- ===== HEADER ===== -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Auto Pilot" Style="{StaticResource HeadingLarge}"/>
                    <TextBlock Text="Your PC, optimized and kept that way."
                               Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,4,0,0">
                    <Border Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="10,5" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,7,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource AccentYellowBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAdministrator}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding AdminBadgeText}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource SmallFont}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="10,5">
                        <TextBlock Text="v0.7.318" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource SmallFont}"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ===== STATUS CARD (master switch + collapsible detail) ===== -->
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,28">
                <StackPanel>

                    <!-- Master switch row -->
                    <Grid Margin="22,18,22,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12"
                                Background="#1A38BDF8" VerticalAlignment="Center">
                            <Viewbox Width="21" Height="21">
                                <Path Data="M12 3 L13.6 9.4 L20 11 L13.6 12.6 L12 19 L10.4 12.6 L4 11 L10.4 9.4 Z"
                                      Fill="{StaticResource AccentBlueBrush}"/>
                            </Viewbox>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,16,0">
                            <TextBlock Text="Auto Pilot" Style="{StaticResource HeadingSmall}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AutoPilotActive}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding AutoPilotStatusLine}" Style="{StaticResource CaptionText}"
                                           VerticalAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                  IsChecked="{Binding AutoPilotModeEnabled}"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}"/>

                    <!-- Show details disclosure -->
                    <Button Command="{Binding ToggleSeeWhatsOnCommand}" Style="{StaticResource ExpanderButton}"
                            HorizontalContentAlignment="Stretch">
                        <Grid Margin="22,12,22,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontSize="12.5" VerticalAlignment="Center"
                                       Foreground="{StaticResource AccentBlueBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Show details"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SeeWhatsOnExpanded}" Value="True">
                                                <Setter Property="Text" Value="Hide details"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="1" FontSize="10" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#x25BC;"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SeeWhatsOnExpanded}" Value="True">
                                                <Setter Property="Text" Value="&#x25B2;"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Button>

                    <!-- Dropdown: what Auto Pilot has turned on.
                         Fades and eases down on open so the panel arrives rather than
                         snapping in. Closing stays instant — a lingering collapse just
                         feels like lag. -->
                    <StackPanel Margin="22,2,22,18"
                                Visibility="{Binding SeeWhatsOnExpanded, Converter={StaticResource BoolToVis}}">
                        <StackPanel.RenderTransform>
                            <TranslateTransform Y="0"/>
                        </StackPanel.RenderTransform>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SeeWhatsOnExpanded}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0" To="1" Duration="0:0:0.18"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                     From="-6" To="0" Duration="0:0:0.18">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ItemsControl ItemsSource="{Binding AutoPilotChecklist}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AutoPilotItem}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,9">
                                        <TextBlock FontSize="12" Margin="0,0,9,0" VerticalAlignment="Center" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text"       Value="&#x25CB;"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                            <Setter Property="Text"       Value="&#x2713;"/>
                                                            <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Label}" FontSize="12.5" VerticalAlignment="Center"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- ===== SUGGESTIONS ===== -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Suggestions for this PC" Style="{StaticResource HeadingMedium}" Margin="0,0,0,4"/>
                    <TextBlock Text="One at a time. Apply what you like, skip the rest."
                               Style="{StaticResource CaptionText}" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Padding="12,7" VerticalAlignment="Center"
                        Click="DismissedBtn_Click"
                        Visibility="{Binding HasDismissed, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Path Width="24" Height="24" Stretch="Uniform"
                                  Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M4 13 h3 l3 3 h4 l3 -3 h3 M5 19 h14 a2 2 0 0 0 2 -2 v-11 a2 2 0 0 0 -2 -2 h-14 a2 2 0 0 0 -2 2 v11 a2 2 0 0 0 2 2 z"/>
                        </Viewbox>
                        <TextBlock Text="Dismissed" FontSize="12.5" VerticalAlignment="Center"/>
                        <Border CornerRadius="9" Background="#1A38BDF8" Padding="7,1" Margin="8,0,0,0"
                                MinWidth="20" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DismissedCount}" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Foreground="{StaticResource AccentBlueBrush}"/>
                        </Border>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Focus card: ONE suggestion, stepped through with the arrows -->
            <Border Style="{StaticResource Card}" Padding="0"
                    Visibility="{Binding HasRecommendations, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <StackPanel Margin="26,22,26,20">

                        <Border CornerRadius="4" Padding="7,2" HorizontalAlignment="Left"
                                Background="#1A22C55E" BorderBrush="{StaticResource AccentGreenBrush}" BorderThickness="1">
                            <TextBlock Text="{Binding CurrentRecommendation.Safety}" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentGreenBrush}"/>
                        </Border>

                        <TextBlock Text="{Binding CurrentRecommendation.Title}" Style="{StaticResource HeadingMedium}"
                                   TextWrapping="Wrap" Margin="0,12,0,0"/>

                        <TextBlock Text="{Binding CurrentRecommendation.WhyBody}" Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" Margin="0,10,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>

                        <!-- Trade-off pulled out of the paragraph so the caveat is not buried -->
                        <Border CornerRadius="7" Padding="13,10" Margin="0,14,0,0"
                                MaxWidth="620" HorizontalAlignment="Left"
                                Background="#14F59E0B" BorderBrush="#3AF59E0B" BorderThickness="1"
                                Visibility="{Binding CurrentRecommendation.HasTradeoff, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="TRADE-OFF" FontSize="9.5" FontWeight="Bold"
                                           Foreground="{StaticResource AccentYellowBrush}"/>
                                <TextBlock Text="{Binding CurrentRecommendation.Tradeoff}" FontSize="12.5"
                                           TextWrapping="Wrap" Margin="0,5,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <Border Height="1" Background="{StaticResource BorderBrush}"/>

                    <!-- Actions + queue navigation -->
                    <Grid Margin="26,14,26,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Content="Apply" Style="{StaticResource PrimaryButton}" Padding="24,8"
                                    Command="{Binding ApplyRecommendationCommand}"
                                    CommandParameter="{Binding CurrentRecommendation}"/>
                            <Button Content="Not now" Style="{StaticResource GhostButton}" Padding="18,8" Margin="10,0,0,0"
                                    Command="{Binding DismissRecommendationCommand}"
                                    CommandParameter="{Binding CurrentRecommendation}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostButton}" Content="&#x2039;" Padding="14,1"
                                    FontSize="17" FontWeight="Bold" ToolTip="Previous suggestion"
                                    Command="{Binding PrevRecCommand}" IsEnabled="{Binding CanGoPrevRec}"/>
                            <TextBlock Text="{Binding RecPositionText}" FontSize="11.5" Margin="12,0,12,0"
                                       VerticalAlignment="Center" MinWidth="46" TextAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Button Style="{StaticResource GhostButton}" Content="&#x203A;" Padding="14,1"
                                    FontSize="17" FontWeight="Bold" ToolTip="Next suggestion"
                                    Command="{Binding NextRecCommand}" IsEnabled="{Binding CanGoNextRec}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Empty / all-set state -->
            <Border Style="{StaticResource Card}"
                    Visibility="{Binding HasRecommendations, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                <StackPanel HorizontalAlignment="Center" Margin="0,18,0,18">
                    <Border Width="52" Height="52" CornerRadius="26" Background="#1A22C55E"
                            HorizontalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock Text="&#x2713;" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource AccentGreenBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="You're all set" Style="{StaticResource HeadingSmall}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Auto Pilot is keeping your PC tuned. We'll add a suggestion here if something new comes up."
                               Style="{StaticResource CaptionText}" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Subtle status line -->
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}"
                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="2,16,0,0"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
