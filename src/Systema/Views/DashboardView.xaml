<UserControl x:Class="Systema.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Systema.Core.Converters"
             xmlns:vm="clr-namespace:Systema.ViewModels"
             Background="Transparent">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,28">

            <!-- ===== HEADER ===== -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Auto Pilot" Style="{StaticResource HeadingLarge}"/>
                    <TextBlock Text="Your PC, optimized and kept that way."
                               Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,4,0,0">
                    <Border Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="10,5" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,7,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource AccentYellowBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAdministrator}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding AdminBadgeText}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="10,5">
                        <TextBlock Text="v0.7.191" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ===== ZONE 1: AUTO PILOT ===== -->
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,26">
                <StackPanel>

                    <!-- Master switch row -->
                    <Grid Margin="22,20,22,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="14"
                                Background="#1A4C8CF0" VerticalAlignment="Center">
                            <Viewbox Width="24" Height="24">
                                <Path Data="M12 3 L13.6 9.4 L20 11 L13.6 12.6 L12 19 L10.4 12.6 L4 11 L10.4 9.4 Z"
                                      Fill="{StaticResource AccentBlueBrush}"/>
                            </Viewbox>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,16,0">
                            <TextBlock Text="Auto Pilot" Style="{StaticResource HeadingMedium}"/>
                            <TextBlock Text="Automatically apply the best optimizers for your hardware."
                                       Style="{StaticResource CaptionText}" Margin="0,3,0,0" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                  IsChecked="{Binding AutoPilotModeEnabled}"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}"/>

                    <!-- Status strip -->
                    <StackPanel Orientation="Horizontal" Margin="22,13,22,13">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,9,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AutoPilotActive}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding AutoPilotStatusLine}" Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource BorderBrush}"/>

                    <!-- See what's on disclosure -->
                    <Button Command="{Binding ToggleSeeWhatsOnCommand}" Style="{StaticResource ExpanderButton}"
                            HorizontalContentAlignment="Stretch">
                        <Grid Margin="22,13,22,13">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="See what Auto Pilot turned on" FontSize="13"
                                       VerticalAlignment="Center" Foreground="{StaticResource AccentBlueBrush}"/>
                            <TextBlock Grid.Column="1" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#x25BC;"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SeeWhatsOnExpanded}" Value="True">
                                                <Setter Property="Text" Value="&#x25B2;"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Button>

                    <!-- Collapsible checklist of active optimizations -->
                    <StackPanel Margin="22,0,22,16"
                                Visibility="{Binding SeeWhatsOnExpanded, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding AutoPilotChecklist}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AutoPilotItem}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text"       Value="&#x25CB;"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                            <Setter Property="Text"       Value="&#x2713;"/>
                                                            <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource CaptionText}"
                                                   VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- ===== ZONE 2: RECOMMENDED ===== -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Recommended for your PC" Style="{StaticResource HeadingMedium}" Margin="0,0,0,4"/>
                    <TextBlock Text="Optional tweaks for your hardware. Apply what you like, dismiss the rest."
                               Style="{StaticResource CaptionText}" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Padding="12,7" VerticalAlignment="Center"
                        Click="DismissedBtn_Click"
                        Visibility="{Binding HasDismissed, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Path Width="24" Height="24" Stretch="Uniform"
                                  Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M4 13 h3 l3 3 h4 l3 -3 h3 M5 19 h14 a2 2 0 0 0 2 -2 v-11 a2 2 0 0 0 -2 -2 h-14 a2 2 0 0 0 -2 2 v11 a2 2 0 0 0 2 2 z"/>
                        </Viewbox>
                        <TextBlock Text="Dismissed" FontSize="12.5" VerticalAlignment="Center"/>
                        <Border CornerRadius="9" Background="#1A4C8CF0" Padding="7,1" Margin="8,0,0,0"
                                MinWidth="20" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DismissedCount}" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Foreground="{StaticResource AccentBlueBrush}"/>
                        </Border>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Recommendation cards -->
            <ItemsControl ItemsSource="{Binding Recommendations}"
                          Visibility="{Binding HasRecommendations, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:Recommendation}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource HeadingSmall}"/>
                                    <Border CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                            Background="#1A5C9C7C" BorderBrush="{StaticResource AccentGreenBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding Safety}" FontSize="9" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentGreenBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Why}" Style="{StaticResource CaptionText}"
                                           TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="Apply" Style="{StaticResource PrimaryButton}" Padding="22,8"
                                            Command="{Binding DataContext.ApplyRecommendationCommand,
                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="Dismiss" Style="{StaticResource GhostButton}" Padding="18,8" Margin="10,0,0,0"
                                            Command="{Binding DataContext.DismissRecommendationCommand,
                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Empty / all-set state -->
            <Border Style="{StaticResource Card}"
                    Visibility="{Binding HasRecommendations, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                <StackPanel HorizontalAlignment="Center" Margin="0,18,0,18">
                    <Border Width="52" Height="52" CornerRadius="26" Background="#1A5C9C7C"
                            HorizontalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock Text="&#x2713;" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource AccentGreenBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="You're all set" Style="{StaticResource HeadingSmall}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Auto Pilot is keeping your PC tuned. We'll add a suggestion here if something new comes up."
                               Style="{StaticResource CaptionText}" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Subtle status line -->
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}"
                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="2,16,0,0"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
