<UserControl x:Class="Systema.Views.VisualView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Systema.Core.Converters"
             xmlns:ctl="clr-namespace:Systema.Controls"
             Background="Transparent">

    <!-- Windows 11 Settings layout: the style picker as selectable tiles, then one SettingsCard
         per setting, grouped under headers. The individual effects open under an expander row,
         like Settings > Accessibility > Visual effects. Same bindings and text as before. -->

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Dims a section while Auto-Pilot manages it. -->
        <Style x:Key="ManagedSection" TargetType="StackPanel">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAutoPilotActive}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="Opacity"   Value="0.4"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Selectable "visual style" card. Selected state = accent border (driven per-card
             by an ActivePreset DataTrigger). -->
        <Style x:Key="StyleCard" TargetType="Button">
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="BorderBrush"                Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness"            Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment"   Value="Top"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource BgCardBrush}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="16,14">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One segment of the Off · Balanced · Max battery control. Active state applied
             per-button via an ActiveBatteryMode DataTrigger. -->
        <Style x:Key="BatterySegment" TargetType="Button">
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding"    Value="16,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,28">

            <!-- ===== HEADER ===== -->
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="Visual &amp; Power" Style="{StaticResource HeadingLarge}"/>
                <TextBlock Text="Pick how snappy Windows feels, and how it uses power."
                           Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- ══════════════════════════════ Visual style picker ══════════════════════════════ -->
            <TextBlock Text="Visual style" Style="{StaticResource SettingsGroupHeader}"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Maximum speed = "none" preset -->
                <Button Grid.Column="0" Command="{Binding ApplyNoAnimationsCommand}"
                        ToolTip="Turn off ALL animations for maximum speed">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource StyleCard}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActivePreset}" Value="none">
                                    <Setter Property="BorderBrush"     Value="{StaticResource AccentBlueBrush}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel>
                        <TextBlock Text="Maximum speed" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                        <TextBlock Text="All animations off." Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>

                <!-- Balanced = "speed" preset -->
                <Button Grid.Column="2" Command="{Binding ApplyOptimizeForSpeedCommand}"
                        ToolTip="Drop heavy window/menu animations but keep controls, font smoothing, and drag content">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource StyleCard}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActivePreset}" Value="speed">
                                    <Setter Property="BorderBrush"     Value="{StaticResource AccentBlueBrush}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel>
                        <TextBlock Text="Balanced" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                        <TextBlock Text="Snappy, keeps the key effects." Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>

                <!-- Full Windows look = "default" preset -->
                <Button Grid.Column="4" Command="{Binding ApplyWindowsDefaultCommand}"
                        ToolTip="Restore all Windows animation defaults">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource StyleCard}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActivePreset}" Value="default">
                                    <Setter Property="BorderBrush"     Value="{StaticResource AccentBlueBrush}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel>
                        <TextBlock Text="Full Windows look" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                        <TextBlock Text="All default animations." Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ══════════════════════════════ Power ══════════════════════════════ -->
            <TextBlock Text="Power" Style="{StaticResource SettingsGroupHeader}"/>

            <ctl:SettingsCard Header="Performance mode" RecommendKey="PerformanceMode">
                <ctl:SettingsCard.Description>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardDescription}">
                            Stops Windows slowing your CPU down during gaming or heavy work, so it stays
                            at full speed. Comes back on its own every time you plug in after running on battery.
                        </TextBlock>
                        <!-- Laptop-only caution (HasBattery). Thermal throttling is a different
                             thing from the Windows throttling above, and on a thin laptop it can
                             undo the gain entirely, so say so plainly. -->
                        <TextBlock Style="{StaticResource CardNoteWarn}"
                                   Visibility="{Binding HasBattery, Converter={StaticResource BoolToVis}}"
                                   Text="On a laptop this can backfire. Full speed makes more heat, and once the chip gets too hot it throttles itself harder than it would have, so you can end up slower as well as warmer and shorter on battery. Only turn it on if your laptop cools well and sits out in the open, not on a bed, a couch, or your lap."/>
                        <TextBlock Style="{StaticResource CardNote}">
                            <Run Text="Active plan: "/><Run Text="{Binding ActivePowerPlan, Mode=OneWay}"
                                                            Foreground="{StaticResource AccentBlueBrush}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>
                </ctl:SettingsCard.Description>
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" FontSize="14">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text"       Value="Off"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PerformanceModeEnabled}" Value="True">
                                        <Setter Property="Text"       Value="On"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <CheckBox IsChecked="{Binding PerformanceModeEnabled, Mode=TwoWay}"
                              VerticalAlignment="Center" ToolTipService.ShowOnDisabled="True">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox" BasedOn="{StaticResource ToggleSwitch}">
                                <Setter Property="ToolTip" Value="When on: High Performance plan stays active and restores automatically after charging"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPerformanceModeAutoPiloted}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="Opacity"   Value="0.4"/>
                                        <Setter Property="ToolTip"   Value="Managed by Auto Pilot. Turn off Auto Pilot Mode to change it."/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>
                </StackPanel>
            </ctl:SettingsCard>

            <!-- Battery Mode (laptops only). Collapses cleanly on desktops with no battery. -->
            <StackPanel Style="{StaticResource ManagedSection}"
                        Visibility="{Binding HasBattery, Converter={StaticResource BoolToVis}}">
                <ctl:SettingsCard Header="Battery mode" Badge="Laptop">
                    <ctl:SettingsCard.Description>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardDescription}">
                                Choose how your CPU behaves on battery. Plugged-in performance is always unchanged.
                            </TextBlock>

                            <!-- Off · Balanced no turbo · Max life segmented control -->
                            <Border CornerRadius="6" Padding="3" HorizontalAlignment="Left" Margin="0,12,0,0"
                                    Background="{StaticResource BgSurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <!-- Shown only when Performance Mode is on: keep full speed on battery too. -->
                                    <Button Command="{Binding SetBatteryModeCommand}" CommandParameter="performance" Content="Performance"
                                            Visibility="{Binding PerformanceModeEnabled, Converter={StaticResource BoolToVis}}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource BatterySegment}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActiveBatteryMode}" Value="performance">
                                                        <Setter Property="Background" Value="#3322C55E"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Command="{Binding SetBatteryModeCommand}" CommandParameter="" Content="Off">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource BatterySegment}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActiveBatteryMode}" Value="">
                                                        <Setter Property="Background" Value="#3360CDFF"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Command="{Binding SetBatteryModeCommand}" CommandParameter="balanced" Content="Balanced no turbo">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource BatterySegment}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActiveBatteryMode}" Value="balanced">
                                                        <Setter Property="Background" Value="#3360CDFF"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Command="{Binding SetBatteryModeCommand}" CommandParameter="max" Content="Max life">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource BatterySegment}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActiveBatteryMode}" Value="max">
                                                        <Setter Property="Background" Value="#3360CDFF"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Active-mode descriptions -->
                            <TextBlock Margin="0,10,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CardDescription}">
                                        <Setter Property="Text" Value="No limits. Full performance all the time."/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveBatteryMode}" Value="performance">
                                                <Setter Property="Text" Value="Runs at full speed on battery too. Expect more heat and shorter battery life."/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveBatteryMode}" Value="balanced">
                                                <Setter Property="Text" Value="Stops turbo-boost while on battery. Plugged-in performance unchanged."/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveBatteryMode}" Value="max">
                                                <Setter Property="Text" Value="Caps CPU to 80% on battery for maximum runtime. Plugged-in performance unchanged."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- AC-power notice: only when a mode is set but the cap is dormant -->
                            <Border Background="#1AF59E0B" BorderBrush="{StaticResource AccentYellowBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,10,0,0"
                                    HorizontalAlignment="Left" MaxWidth="680"
                                    Visibility="{Binding IsOnAcWithBatteryPlanActive, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                           Foreground="{StaticResource AccentYellowBrush}">
                                    <Run FontWeight="SemiBold" Text="On AC: "/>
                                    <Run Text="the CPU cap is set but dormant. It activates automatically the next time you unplug."/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </ctl:SettingsCard.Description>
                </ctl:SettingsCard>
            </StackPanel>

            <!-- ══════════════════════════════ Customize individual effects ══════════════════════════════ -->
            <TextBlock Text="Effects" Style="{StaticResource SettingsGroupHeader}"/>

            <Border Style="{StaticResource ListRowCard}" Padding="0">
                <Button Command="{Binding ToggleIndividualControlsCommand}"
                        Style="{StaticResource ExpanderButton}">
                    <Grid Margin="18,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Customize individual effects" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource CardDescription}" Margin="0,2,0,0">
                                Fine-tune each of the 15 Windows animation effects. The style picker above covers most people.
                            </TextBlock>
                        </StackPanel>
                        <Path Grid.Column="1" Style="{StaticResource ExpanderChevron}" Margin="12,0,2,0"
                              ctl:Motion.Flipped="{Binding ShowIndividualControls}"/>
                    </Grid>
                </Button>
            </Border>

            <StackPanel ctl:Motion.RevealOnShow="True"
                        Visibility="{Binding ShowIndividualControls, Converter={StaticResource BoolToVis}}">

                <!-- Apply / Cancel: shown when changes are pending -->
                <Border Style="{StaticResource ListRowCard}" BorderBrush="{StaticResource AccentYellowBrush}"
                        Visibility="{Binding HasPendingChanges, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Apply changes" Style="{StaticResource PrimaryButton}"
                                Margin="0,0,8,0" Command="{Binding ApplyChangesCommand}"/>
                        <Button Content="Cancel" Style="{StaticResource GhostButton}"
                                Command="{Binding CancelChangesCommand}"/>
                        <TextBlock Text="You have unsaved changes." Style="{StaticResource CaptionText}"
                                   Foreground="{StaticResource AccentYellowBrush}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Animations -->
                <TextBlock Text="Animations" Style="{StaticResource SettingsGroupHeader}" Margin="2,12,0,8"/>

                <ctl:SettingsCard Header="Animate buttons and UI elements"
                                  Description="Fade-in effects for list items and menus inside windows.">
                    <CheckBox Style="{StaticResource ToggleSwitch}"
                              IsChecked="{Binding AnimateControlsEnabled, Mode=TwoWay}"/>
                </ctl:SettingsCard>

                <ctl:SettingsCard Header="Animate windows when minimizing and maximizing"
                                  Description="The window zoom-in/out effect when opening or minimizing. Disabling this gives the biggest visible speed improvement.">
                    <CheckBox Style="{StaticResource ToggleSwitch}"
                              IsChecked="{Binding AnimateWindowsEnabled, Mode=TwoWay}"/>
                </ctl:SettingsCard>

                <ctl:SettingsCard Header="Fade or slide menus into view"
                                  Description="Context menus appear instantly when this is disabled.">
                    <CheckBox Style="{StaticResource ToggleSwitch}"
                              IsChecked="{Binding FadeMenusEnabled, Mode=TwoWay}"/>
                </ctl:SettingsCard>

                <ctl:SettingsCard Header="Fade or slide tooltips into view"
                                  Description="Tooltips appear instantly when disabled.">
                    <CheckBox Style="{StaticResource ToggleSwitch}"
                              IsChecked="{Binding TooltipAnimationEnabled, Mode=TwoWay}"/>
                </ctl:SettingsCard>

                <ctl:SettingsCard Header="Fade out menu items after clicking"
                                  Description="Selection fade effect for menus.">
                    <CheckBox Style="{StaticResource ToggleSwitch}"
                              IsChecked="{Binding FadeOutMenuItemsEnabled, Mode=TwoWay}"/>
                </ctl:SettingsCard>

                <ctl:SettingsCard Header="Slide open combo boxes"
                                  Description="Combo box dropdowns animate open instead of appearing instantly.">
                    <CheckBox Style="{StaticResource ToggleSwitch}"
                              IsChecked="{Binding ComboBoxAnimationEnabled, Mode=TwoWay}"/>
                </ctl:SettingsCard>

                <ctl:SettingsCard Header="Smooth-scroll list boxes"
                                  Description="Lists scroll smoothly instead of jumping by line.">
                    <CheckBox Style="{StaticResource ToggleSwitch}"
                              IsChecked="{Binding ListboxSmoothScrollingEnabled, Mode=TwoWay}"/>
                </ctl:SettingsCard>

                <!-- Shadows -->
                <TextBlock Text="Shadows" Style="{StaticResource SettingsGroupHeader}" Margin="2,16,0,8"/>

                <ctl:SettingsCard Header="Show shadows under windows"
                                  Description="Drop shadows around window borders.">
                    <CheckBox Style="{StaticResource ToggleSwitch}"
                              IsChecked="{Binding WindowShadowEnabled, Mode=TwoWay}"/>
                </ctl:SettingsCard>

                <ctl:SettingsCard Header="Show shadow under mouse cursor"
                                  Description="Adds a small drop shadow beneath the pointer.">
                    <CheckBox Style="{StaticResource ToggleSwitch}"
                              IsChecked="{Binding CursorShadowEnabled, Mode=TwoWay}"/>
                </ctl:SettingsCard>

                <ctl:SettingsCard Header="Drop shadows on desktop icon text"
                                  Description="Text shadows under icon names on the desktop.">
                    <CheckBox Style="{StaticResource ToggleSwitch}"
                              IsChecked="{Binding IconLabelShadowEnabled, Mode=TwoWay}"/>
                </ctl:SettingsCard>

                <!-- Windows, taskbar and text -->
                <TextBlock Text="Windows, taskbar and text" Style="{StaticResource SettingsGroupHeader}" Margin="2,16,0,8"/>

                <ctl:SettingsCard Header="Show content while moving windows" RecommendKey="DragContents"
                                  Description="Shows the full window content while you drag it. Turning it off shows only an outline.">
                    <CheckBox Style="{StaticResource ToggleSwitch}"
                              IsChecked="{Binding ShowDragContentsEnabled, Mode=TwoWay}"/>
                </ctl:SettingsCard>

                <ctl:SettingsCard Header="Desktop peek preview"
                                  Description="Hover over the Show Desktop button (far right of taskbar) to preview the desktop.">
                    <CheckBox Style="{StaticResource ToggleSwitch}"
                              IsChecked="{Binding AeroPeekEnabled, Mode=TwoWay}"/>
                </ctl:SettingsCard>

                <ctl:SettingsCard Header="Taskbar hover previews"
                                  Description="Show window thumbnail when hovering taskbar buttons.">
                    <CheckBox Style="{StaticResource ToggleSwitch}"
                              IsChecked="{Binding TaskbarThumbnailPreviewsEnabled, Mode=TwoWay}"/>
                </ctl:SettingsCard>

                <ctl:SettingsCard Header="Show folder type watermarks"
                                  Description="Folder-type watermark images in Explorer windows.">
                    <CheckBox Style="{StaticResource ToggleSwitch}"
                              IsChecked="{Binding ListviewWatermarkEnabled, Mode=TwoWay}"/>
                </ctl:SettingsCard>

                <!-- Smooth font edges: locked (and dimmed) under the Maximum speed preset -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActivePreset}" Value="none">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ctl:SettingsCard Header="Smooth text rendering (ClearType)" RecommendKey="ClearType"
                                      Description="Makes text sharper and easier to read on screen.">
                        <CheckBox IsChecked="{Binding SmoothFontsEnabled, Mode=TwoWay}">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox" BasedOn="{StaticResource ToggleSwitch}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActivePreset}" Value="none">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>
                    </ctl:SettingsCard>
                </Grid>

            </StackPanel>

            <!-- Status bar -->
            <Grid Margin="2,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}"/>
                <Button Grid.Column="1" Content="Refresh" Style="{StaticResource GhostButton}"
                        Command="{Binding RefreshCommand}"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
