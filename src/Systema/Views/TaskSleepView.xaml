<UserControl x:Class="Systema.Views.TaskSleepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Systema.Core.Converters"
             xmlns:core="clr-namespace:Systema.Core">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:IntEqualConverter x:Key="IntEqualConverter"/>

        <!-- Toggle-style radio button for aggressiveness selector -->
        <Style x:Key="ToggleRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" CornerRadius="6" Padding="10,8"
                                Background="#12FFFFFF" BorderThickness="1" BorderBrush="#18FFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#7395B5"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox style for threshold inputs -->
        <Style x:Key="ThresholdInput" TargetType="TextBox"
               BasedOn="{StaticResource DarkTextBox}">
            <Setter Property="Width"                   Value="64"/>
            <Setter Property="TextAlignment"           Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height"                  Value="32"/>
            <Setter Property="core:NumericTextBox.IsNumericOnly" Value="True"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32">

            <!-- ===== HEADER ===== -->
            <TextBlock Text="Systema Engine" Style="{StaticResource HeadingLarge}"/>
            <TextBlock Text="Sleeps idle apps, speeds up launches, and keeps the app you're using responsive — automatically."
                       Style="{StaticResource CaptionText}" Margin="0,4,0,16"/>

            <!-- ===== STATUS HERO ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,9,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource HeadingMedium}">
                                        <Setter Property="Text" Value="Engine is off"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                <Setter Property="Text" Value="Engine is on"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource BgSurfaceBrush}" CornerRadius="10" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="Apps napping" Style="{StaticResource CaptionText}"/>
                                <TextBlock Text="{Binding AppsNappingCount}" FontSize="24" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBlueBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{StaticResource BgSurfaceBrush}" CornerRadius="10" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="Active apps" Style="{StaticResource CaptionText}"/>
                                <TextBlock Text="{Binding ActiveAppsCount}" FontSize="24" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentGreenBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== LAUNCH BOOST CARD ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <!-- Whole card grays out when Task Sleep itself is off — Launch Boost
                     cannot run without the Task Sleep engine. -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanUseLaunchBoost}" Value="False">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Setter Property="Opacity"   Value="0.5"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Button Command="{Binding ToggleLaunchBoostSectionCommand}" Style="{StaticResource ExpanderButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Launch Boost" Style="{StaticResource HeadingMedium}"/>
                                <Border BorderBrush="{StaticResource AccentGreenBrush}" BorderThickness="1" CornerRadius="3"
                                        Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="SAFE" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AccentGreenBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#x25BC;"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowLaunchBoost}" Value="True">
                                                <Setter Property="Text" Value="&#x25B2;"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Button>

                    <StackPanel Visibility="{Binding ShowLaunchBoost, Converter={StaticResource BoolToVis}}" Margin="0,16,0,0">

                    <!-- Header row with master toggle -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="600">
                                Gives apps a temporary priority boost the moment they launch so they open faster,
                                then hands control back to Windows. Off by default.
                            </TextBlock>
                        </StackPanel>
                        <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding LaunchBoostEnabled, Mode=TwoWay}"/>
                    </Grid>

                    <!-- Sub-settings — grayed out until Launch Boost is turned on -->
                    <StackPanel Margin="0,12,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LaunchBoostEnabled}" Value="False">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="Opacity"   Value="0.4"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- Boost duration (dropdown: 5 / 10 / 20 / 40) -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Boost duration" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                                <TextBlock Text="How long the priority boost lasts after an app starts."
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox Width="70"
                                          Style="{StaticResource DarkComboBox}"
                                          ItemsSource="{Binding LaunchBoostDurationOptions}"
                                          SelectedItem="{Binding LaunchBoostDurationSeconds, Mode=TwoWay}"/>
                                <TextBlock Text="seconds" Style="{StaticResource CaptionText}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Rule toggles -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="CPU priority → High" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding LaunchBoostCpu, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="I/O priority → High" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding LaunchBoostIo, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Efficiency mode → Off" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding LaunchBoostDisableEfficiency, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- GPU priority — opt-in, default off, VSync caveat -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="GPU priority → Max" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                                <TextBlock Text="Advanced — raises GPU scheduling priority. May affect VSync / frame pacing on some systems. Off by default."
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                           Foreground="{StaticResource AccentYellowBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding LaunchBoostGpu, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== RESPONSIVENESS CARD ===== -->
            <!-- Foreground Priority Boost + Instant App Focus + Instant Startup Apps +
                 Maximum System Responsiveness are all part of the engine: this group grays
                 out and the toggles force off when the engine is off, and default on when
                 it's on. -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanUseResponsiveness}" Value="False">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Setter Property="Opacity"   Value="0.5"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Button Command="{Binding ToggleResponsivenessSectionCommand}" Style="{StaticResource ExpanderButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Responsiveness boosts" Style="{StaticResource HeadingMedium}"/>
                                <TextBlock Text="Eleven tweaks that keep the active app fast — priority, focus, throttling, startup, shutdown."
                                           Style="{StaticResource CaptionText}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#x25BC;"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowResponsiveness}" Value="True">
                                                <Setter Property="Text" Value="&#x25B2;"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Button>

                    <StackPanel Visibility="{Binding ShowResponsiveness, Converter={StaticResource BoolToVis}}" Margin="0,16,0,0">

                    <!-- Foreground Priority Boost -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Foreground Priority Boost" Style="{StaticResource HeadingMedium}"/>
                                <Border BorderBrush="{StaticResource AccentGreenBrush}" BorderThickness="1" CornerRadius="3"
                                        Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="SAFE" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AccentGreenBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="600">
                                Gives the app you're using a bigger share of CPU time so the active window stays
                                snappy while background apps keep running.
                                <LineBreak/><Run FontWeight="SemiBold">Recommended on with Systema Engine:</Run> as the
                                engine quiets background apps, this steers that freed-up CPU to the app you're actually
                                using — so the two work together.
                            </TextBlock>
                        </StackPanel>
                        <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding ForegroundBoostEnabled, Mode=TwoWay}"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,16"/>

                    <!-- Instant App Focus -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Instant App Focus" Style="{StaticResource HeadingMedium}"/>
                                <Border BorderBrush="{StaticResource AccentGreenBrush}" BorderThickness="1" CornerRadius="3"
                                        Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="SAFE" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AccentGreenBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="600">
                                Removes Windows' delay before a launching or clicked app jumps to the front, so
                                apps come to focus immediately instead of flashing in the taskbar.
                                <LineBreak/><Run FontWeight="SemiBold">Recommended on with Systema Engine:</Run> when the
                                engine wakes a napped app, this lets it snap to the front instantly instead of feeling
                                sluggish for a moment.
                            </TextBlock>
                        </StackPanel>
                        <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding InstantAppFocusEnabled, Mode=TwoWay}"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,16"/>

                    <!-- Instant Startup Apps -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Instant Startup Apps" Style="{StaticResource HeadingMedium}"/>
                                <Border BorderBrush="{StaticResource AccentGreenBrush}" BorderThickness="1" CornerRadius="3"
                                        Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="SAFE" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AccentGreenBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="600">
                                Removes the waiting period Windows imposes on your startup apps after a reboot or
                                shutdown, so they launch immediately instead of trickling in ~10 seconds late.
                                Takes effect on the next boot.
                                <LineBreak/><Run FontWeight="SemiBold">Recommended on with Systema Engine:</Run> your apps
                                start at full speed, and the engine then keeps the idle ones quiet — fast startup without
                                the lingering background bloat.
                            </TextBlock>
                        </StackPanel>
                        <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding InstantStartupApps, Mode=TwoWay}"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,16"/>

                    <!-- Maximum System Responsiveness — engine-gated with the boosts above. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Maximum System Responsiveness" Style="{StaticResource HeadingMedium}"/>
                                <Border BorderBrush="{StaticResource AccentYellowBrush}" BorderThickness="1" CornerRadius="3"
                                        Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="ADVANCED" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AccentYellowBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="600">
                                Sets the MMCSS SystemResponsiveness reserve to 0, handing the CPU quanta Windows normally
                                holds back for background work to multimedia and foreground apps — steadier frame pacing
                                under load. OFF restores the Windows default (20).
                                <LineBreak/><Run FontWeight="SemiBold">Recommended on with Systema Engine:</Run> it
                                reinforces what the engine is already doing — less CPU reserved for background work, more
                                for the app in front.
                            </TextBlock>
                            <TextBlock Text="⟳ Requires a restart to take effect."
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                       Foreground="{StaticResource AccentYellowBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding MaxResponsivenessEnabled, Mode=TwoWay}"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,16"/>

                    <!-- Network Throttling Off — pairs with Maximum System Responsiveness. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Network Throttling Off" Style="{StaticResource HeadingMedium}"/>
                                <Border BorderBrush="{StaticResource AccentGreenBrush}" BorderThickness="1" CornerRadius="3"
                                        Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="SAFE" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AccentGreenBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="600">
                                Windows throttles your network to ~10 packets/ms whenever audio or video is playing, to keep
                                sound smooth. Turning that off hands the full network pipe to the app you're using — snappier
                                downloads, streaming, and online games. OFF restores the Windows default.
                                <LineBreak/><Run FontWeight="SemiBold">Recommended on with Systema Engine:</Run> it pairs with
                                Maximum System Responsiveness — same multimedia profile, now without the network brake.
                            </TextBlock>
                            <TextBlock Text="⟳ Requires a restart to take effect."
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                       Foreground="{StaticResource AccentYellowBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding NetworkThrottlingOffEnabled, Mode=TwoWay}"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,16"/>

                    <!-- Power Throttling Off — pairs with Foreground Priority Boost. AC-gated. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Power Throttling Off" Style="{StaticResource HeadingMedium}"/>
                                <Border BorderBrush="{StaticResource AccentGreenBrush}" BorderThickness="1" CornerRadius="3"
                                        Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="SAFE" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AccentGreenBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="600">
                                Windows quietly lowers the clock speed of apps it decides are in the background to save power.
                                Turning Power Throttling off keeps the app you're using at full speed. On battery it's left on
                                automatically so your runtime isn't affected — it only kicks in on AC power.
                                <LineBreak/><Run FontWeight="SemiBold">Recommended on with Systema Engine:</Run> it backs up
                                Foreground Priority Boost — the active app gets both more CPU time and full clock speed.
                            </TextBlock>
                        </StackPanel>
                        <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding PowerThrottlingOffEnabled, Mode=TwoWay}"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,16"/>

                    <!-- Fast App Close — snappier shutdown / sign-out. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Fast App Close" Style="{StaticResource HeadingMedium}"/>
                                <Border BorderBrush="{StaticResource AccentGreenBrush}" BorderThickness="1" CornerRadius="3"
                                        Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="SAFE" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AccentGreenBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="600">
                                Windows waits up to 20 seconds for an app to close when you shut down or sign out before
                                nudging it. This trims that wait so shutdown and restart feel immediate — apps still get a
                                few seconds to save. OFF restores the Windows default.
                                <LineBreak/><Run FontWeight="SemiBold">Recommended on with Systema Engine:</Run> less waiting
                                when you close things, matching the engine's snappy feel.
                            </TextBlock>
                        </StackPanel>
                        <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding FastAppCloseEnabled, Mode=TwoWay}"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,16"/>

                    <!-- Keep Kernel in RAM — RAM-gated (default on at >= 14 GB, recommended 16 GB+). -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Keep Kernel in RAM" Style="{StaticResource HeadingMedium}"/>
                                <Border BorderBrush="{StaticResource AccentGreenBrush}" BorderThickness="1" CornerRadius="3"
                                        Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="SAFE" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AccentGreenBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="600">
                                Stops Windows from paging the kernel and drivers out to disk (DisablePagingExecutive), so the
                                system stays responsive under memory load instead of hitching. OFF restores the Windows default.
                                <LineBreak/><Run FontWeight="SemiBold">Only recommended if your PC has 16 GB or more of RAM</Run> —
                                Systema leaves this off by default on machines with less than 14 GB.
                            </TextBlock>
                            <TextBlock Text="⟳ Requires a restart to take effect."
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                       Foreground="{StaticResource AccentYellowBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding KeepKernelInRamEnabled, Mode=TwoWay}"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,16"/>

                    <!-- Faster Shutdown — AutoEndTasks + HungAppTimeout reinforcement. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Faster Shutdown" Style="{StaticResource HeadingMedium}"/>
                                <Border BorderBrush="{StaticResource AccentGreenBrush}" BorderThickness="1" CornerRadius="3"
                                        Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="SAFE" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AccentGreenBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="600">
                                Closes frozen apps automatically when you shut down or sign out (AutoEndTasks), instead of the
                                "this app is preventing shutdown" prompt. Reinforced by shortening how long Windows waits before
                                deciding an app is hung (HungAppTimeout → 1000 ms) so a slow app like Discord is force-closed
                                before the prompt appears. Pairs with Fast App Close (2 s). OFF restores the Windows defaults.
                                <LineBreak/><Run FontWeight="SemiBold">Recommended on with Systema Engine:</Run> shutdown and
                                restart feel immediate, with no stuck-app prompts.
                            </TextBlock>
                        </StackPanel>
                        <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding FasterShutdownEnabled, Mode=TwoWay}"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,16"/>

                    <!-- Input Hook Timeout — LowLevelHooksTimeout, enforced in the .DEFAULT hive too. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Input Hook Timeout" Style="{StaticResource HeadingMedium}"/>
                                <Border BorderBrush="{StaticResource AccentGreenBrush}" BorderThickness="1" CornerRadius="3"
                                        Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="SAFE" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AccentGreenBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="600">
                                When a misbehaving app installs a keyboard/mouse hook and stalls, Windows freezes your input
                                until it gives up (LowLevelHooksTimeout, ~5000 ms). This trims it to 1000 ms so input recovers
                                in a second instead of five. To enforce it everywhere it also writes the same value to the
                                system's .DEFAULT profile (used at the logon screen) — safe and reversible. OFF restores the default.
                                <LineBreak/><Run FontWeight="SemiBold">Recommended on with Systema Engine:</Run> the mouse and
                                keyboard stay responsive even when an app misbehaves.
                            </TextBlock>
                        </StackPanel>
                        <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding InputHookTimeoutEnabled, Mode=TwoWay}"/>
                    </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== LIVE MONITOR CARD ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>

                    <Button Command="{Binding ToggleLiveMonitorSectionCommand}" Style="{StaticResource ExpanderButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Live monitor" Style="{StaticResource HeadingMedium}"/>
                                <TextBlock Text="Watch what the engine is doing in real time, and protect any app on the spot."
                                           Style="{StaticResource CaptionText}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#x25BC;"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowLiveMonitor}" Value="True">
                                                <Setter Property="Text" Value="&#x25B2;"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Button>

                    <StackPanel Visibility="{Binding ShowLiveMonitor, Converter={StaticResource BoolToVis}}" Margin="0,16,0,0">

                    <!-- Card header: stats + Show All -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="LIVE MONITOR"
                                       Style="{StaticResource SectionLabel}"
                                       Margin="0,0,0,0"
                                       VerticalAlignment="Center"/>
                            <!-- System CPU pill -->
                            <Border CornerRadius="10" Padding="8,3"
                                    Background="#12FFFFFF"
                                    Margin="12,0,8,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding SystemCpuDisplay}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                            <!-- Napping count pill -->
                            <Border CornerRadius="10" Padding="8,3"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#12FFFFFF"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ThrottledCountDisplay}" Value="all awake">
                                                <Setter Property="Background" Value="#0C5C9C7C"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding ThrottledCountDisplay}"
                                           FontSize="11" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource AccentYellowBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ThrottledCountDisplay}" Value="all awake">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <!-- CPU freed pill — hidden when nothing is napped -->
                            <Border CornerRadius="10" Padding="8,3"
                                    Background="#0C5C9C7C"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding CpuFreedVisible, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding CpuFreedDisplay}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentGreenBrush}"/>
                            </Border>
                        </WrapPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Show all"
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <CheckBox IsChecked="{Binding ShowAllProcesses, Mode=TwoWay}"
                                      Style="{StaticResource ToggleSwitch}"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Process table column headers.
                         These widths MUST stay identical to the data-row Grid below
                         (around line 194) or every column label drifts off its
                         values. SINCE in particular needs the 110 px width because
                         the data row uses that slot for "Napping for Xm Ys" /
                         skip-reason text, not just a short duration. -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PROCESS"
                                   Style="{StaticResource CaptionText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="CPU%"
                                   Style="{StaticResource CaptionText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Right"/>
                        <TextBlock Grid.Column="2" Text="STATUS"
                                   Style="{StaticResource CaptionText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontWeight="SemiBold"
                                   Margin="10,0,0,0"/>
                        <TextBlock Grid.Column="3" Text="AFFINITY"
                                   Style="{StaticResource CaptionText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontWeight="SemiBold"
                                   Margin="6,0,0,0"/>
                        <TextBlock Grid.Column="4" Text="SINCE"
                                   Style="{StaticResource CaptionText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontWeight="SemiBold"
                                   Margin="6,0,0,0"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,6"/>

                    <!-- Process rows -->
                    <ScrollViewer MaxHeight="230"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding LiveProcesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4" MinHeight="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="88"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="32"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Process name — bold when napping -->
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsThrottled}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- CPU% -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding CpuPercent, StringFormat={}{0:F1}}"
                                                   Style="{StaticResource CaptionText}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center"/>

                                        <!-- Status badge — Napping (amber), Active (blue), Pending (purple) -->
                                        <Border Grid.Column="2"
                                                CornerRadius="4" Padding="6,2"
                                                Margin="8,0,0,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusLabel}" Value="Napping">
                                                            <Setter Property="Background" Value="#332B1A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusLabel}" Value="Active">
                                                            <Setter Property="Background" Value="#1F2A35"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusLabel}" Value="Pending">
                                                            <Setter Property="Background" Value="#1F2A35"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusLabel}" Value="Deep Sleep">
                                                            <Setter Property="Background" Value="#1F1F2A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusLabel}"
                                                       FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusLabel}" Value="Napping">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentYellowBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusLabel}" Value="Active">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusLabel}" Value="Pending">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusLabel}" Value="Deep Sleep">
                                                                <Setter Property="Foreground" Value="#7395B5"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding CoreLabel}"
                                                   Style="{StaticResource CaptionText}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="6,0,0,0"
                                                   VerticalAlignment="Center"/>

                                        <!-- Duration when napping; skip reason when not -->
                                        <TextBlock Grid.Column="4"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="6,0,0,0"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding SkipReason}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                                    <Setter Property="Text" Value="{Binding SkipReason}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsThrottled}" Value="True">
                                                            <Setter Property="Text" Value="{Binding ThrottledFor}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- ⋯ action menu — only shown when napping -->
                                        <Button Grid.Column="5"
                                                Content="···"
                                                FontSize="14"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                Padding="0" Margin="4,0,0,0"
                                                Cursor="Hand"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                ToolTip="Options for this process"
                                                Click="ProcessMenuButton_Click">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsThrottled}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Button.Tag>0</Button.Tag>
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Stop Napping"
                                                              Command="{Binding DataContext.WakeProcessCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              CommandParameter="{Binding}"/>
                                                    <Separator/>
                                                    <MenuItem Header="Whitelist — never nap this app"
                                                              Command="{Binding DataContext.WhitelistProcessCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              CommandParameter="{Binding}"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty state: Task Sleep disabled -->
                    <TextBlock Text="Turn on Task Sleep above to start monitoring.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="Margin" Value="0,6,0,0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Empty state: enabled but nothing napping -->
                    <TextBlock Text="No apps napping right now.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="Margin" Value="0,6,0,0"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                            <Condition Binding="{Binding LiveProcesses.Count}" Value="0"/>
                                        </MultiDataTrigger.Conditions>
                                        <MultiDataTrigger.Setters>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger.Setters>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14,0,12"/>

                    <!-- Recent Activity -->
                    <TextBlock Text="RECENT ACTIVITY"
                               Style="{StaticResource SectionLabel}"
                               Margin="0,0,0,10"/>

                    <ScrollViewer MaxHeight="160"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding RecentEvents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <WrapPanel Margin="0,0,0,4" VerticalAlignment="Center">

                                        <!-- Timestamp -->
                                        <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}"
                                                   Style="{StaticResource CaptionText}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Width="56"
                                                   Margin="0,0,8,0"/>

                                        <!-- Action badge -->
                                        <Border CornerRadius="4" Padding="6,2"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1F1F22"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Action}" Value="Napping">
                                                            <Setter Property="Background" Value="#332B1A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="Minimize Nap">
                                                            <Setter Property="Background" Value="#332B1A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="Tray Nap">
                                                            <Setter Property="Background" Value="#332B1A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="Smart Nap">
                                                            <Setter Property="Background" Value="#332B1A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="Child Nap">
                                                            <Setter Property="Background" Value="#332B1A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="Re-napping">
                                                            <Setter Property="Background" Value="#332B1A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="Tray Re-nap">
                                                            <Setter Property="Background" Value="#332B1A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="Brief Wake">
                                                            <Setter Property="Background" Value="#1F2A35"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="Deep Wake">
                                                            <Setter Property="Background" Value="#1F1F2A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="Tray Wake">
                                                            <Setter Property="Background" Value="#1F2A35"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="Tray Deep Wake">
                                                            <Setter Property="Background" Value="#1F1F2A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="Woke up">
                                                            <Setter Property="Background" Value="#1A2620"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="Re-enforced">
                                                            <Setter Property="Background" Value="#1F2A35"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="Auto-whitelisted">
                                                            <Setter Property="Background" Value="#1A2620"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="Error">
                                                            <Setter Property="Background" Value="#2A1A1C"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Action}"
                                                       FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Action}" Value="Napping">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentYellowBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="Minimize Nap">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentYellowBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="Tray Nap">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentYellowBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="Smart Nap">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentYellowBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="Child Nap">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentYellowBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="Re-napping">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentYellowBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="Tray Re-nap">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentYellowBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="Brief Wake">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="Deep Wake">
                                                                <Setter Property="Foreground" Value="#7395B5"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="Tray Wake">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="Tray Deep Wake">
                                                                <Setter Property="Foreground" Value="#7395B5"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="Woke up">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="Re-enforced">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="Auto-whitelisted">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="Error">
                                                                <Setter Property="Foreground" Value="#C7556B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <!-- Process name -->
                                        <TextBlock Text="{Binding ProcessName}"
                                                   Style="{StaticResource CaptionText}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>

                                        <!-- Detail (hidden if empty) -->
                                        <TextBlock Text="{Binding Detail}"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Detail}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                    </WrapPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty state: no events yet -->
                    <TextBlock Text="No activity yet.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecentEvents.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Status message -->
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource CaptionText}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,10,0,0"/>

                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== SLEEP BEHAVIOR CARD ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <Button Command="{Binding ToggleSleepRulesSectionCommand}" Style="{StaticResource ExpanderButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Sleep rules" Style="{StaticResource HeadingMedium}"/>
                                <TextBlock Text="Which apps get put to sleep — minimized, tray, unused, and idle — plus how aggressively."
                                           Style="{StaticResource CaptionText}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#x25BC;"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowSleepRules}" Value="True">
                                                <Setter Property="Text" Value="&#x25B2;"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Button>

                    <StackPanel Visibility="{Binding ShowSleepRules, Converter={StaticResource BoolToVis}}" Margin="0,16,0,0">

                    <!-- Sleep minimized apps -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Sleep minimized apps"
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Apps you minimize are automatically put to sleep. They get periodic brief wakes to stay up to date. Audio, calls, and recordings are always protected."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding MinimizeNapEnabled, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Top"/>
                    </Grid>

                    <!-- Sleep system tray apps -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Sleep tray apps"
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Background apps living in the system tray (cloud sync, game launchers, updaters) are put to sleep with rare brief wakes."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding TrayNapEnabled, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Top"/>
                    </Grid>

                    <!-- Sleep unused apps (Background Nap) -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Sleep unused apps"
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Apps you haven't used in a few minutes are put to sleep, even if they're not minimized. The most effective mode — catches everything you're not actively using."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding BackgroundNapEnabled, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Top"/>
                    </Grid>

                    <!-- Sleep idle apps -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Sleep idle apps"
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Apps using almost no CPU for 2+ minutes are put to sleep. Catches truly idle background processes that waste resources by just existing."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding IdleNapEnabled, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Top"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                    <!-- Nap child processes -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Include helper processes"
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="When an app is put to sleep, also sleep processes it launched. Frees more resources but some apps may not handle this well."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding NapChildrenEnabled, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Top"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                    <!-- Keep busy apps awake (on by default) -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Keep busy apps awake"
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Don't sleep a minimized or tray app while its whole process tree is using more than 30% CPU — it's probably still doing work (an export, a render, a build). The entire app stays awake, and naps normally once it settles down."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding SkipBusyMinimizedApps, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Top"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                    <!-- Compress memory in deep sleep — closest Windows equivalent to macOS App Nap + Compressed Memory -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Compress memory in deep sleep"
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,0,0,3"/>
                            <TextBlock Text="When a napped app has been idle long enough to enter deep sleep (~10 minutes by default), trim its working set so Windows can compress those pages on the standby list at roughly 2–4× ratio. Re-trim after every brief wake while the process is still in deep sleep, so the compressed footprint stays stable. Closest Windows equivalent to macOS's App Nap + Compressed Memory behavior."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding CompressDeepSleep, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Top"/>
                    </Grid>

                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== ADVANCED SETTINGS CARD ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <Button Command="{Binding ToggleAdvancedSectionCommand}" Style="{StaticResource ExpanderButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Advanced timing &amp; caps" Style="{StaticResource HeadingMedium}"/>
                                <TextBlock Text="Protection guards, the hard CPU cap, and wake-timing controls for power users."
                                           Style="{StaticResource CaptionText}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#x25BC;"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowAdvancedSection}" Value="True">
                                                <Setter Property="Text" Value="&#x25B2;"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Button>

                    <StackPanel Visibility="{Binding ShowAdvancedSection, Converter={StaticResource BoolToVis}}" Margin="0,16,0,0">

                    <!-- ── PROTECTION GUARDS ── -->
                    <TextBlock Text="PROTECTION" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>

                    <!-- Elevated process guard -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Protect elevated processes"
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Admin processes like Hyper-V, Docker, WSL2, and elevated tools are automatically protected using Windows integrity levels."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding ElevatedProcessGuardEnabled, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Top"/>
                    </Grid>

                    <!-- Multi-monitor awareness -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Multi-monitor awareness"
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Apps visible on any monitor are protected, not just the one you're clicking in."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding MultiMonitorAwarenessEnabled, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Top"/>
                    </Grid>

                    <!-- Process group awareness -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="App group awareness"
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="When you're using an app, all of its processes stay awake (e.g. all Chrome tabs and renderers are protected when any Chrome window is focused)."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding ProcessGroupAwarenessEnabled, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Top"/>
                    </Grid>

                    <!-- Tray deep sleep (moved from Wake Timing — this is a behavioural guard) -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Tray deep sleep"
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="After a tray app has been idle for the deep-sleep threshold, stretch its wakes to a longer interval. Protects it from spurious activations while still giving it periodic runtime."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding TrayDeepSleepEnabled, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Top"/>
                    </Grid>

                    <!-- Pause brief wakes during Game Mode -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Pause brief wakes while gaming"
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="When Game Booster is active, napped apps stay fully asleep — no periodic wakes — so 100% of the CPU goes to your game. Turn off if you need background apps (Discord bots, streaming tools, etc.) to keep running while gaming."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding SuppressBriefWakesDuringGameMode, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Top"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                    <!-- ── CPU CAP ── -->
                    <TextBlock Text="CPU CAP" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Hard CPU limit for sleeping apps"
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Enforced by Windows at the kernel level. Apps physically cannot exceed the cap."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding NappedCpuCapEnabled, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Top"/>
                    </Grid>

                    <!-- CPU cap sub-rows: all share 70px textbox + 50px unit column so they line up. -->
                    <StackPanel Visibility="{Binding NappedCpuCapEnabled, Converter={StaticResource BoolToVis}}">
                        <Grid Margin="16,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Max CPU while sleeping"
                                       Style="{StaticResource BodyText}"
                                       VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                      Style="{StaticResource DarkComboBox}"
                                      ItemsSource="{Binding CpuCapWhileSleepingOptions}"
                                      SelectedItem="{Binding NappedCpuCapPercent, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"/>
                            <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center"
                                       Margin="8,0,0,0" Style="{StaticResource BodyText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>

                        <Grid Margin="16,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="Max CPU during brief wakes"
                                           Style="{StaticResource BodyText}"/>
                                <TextBlock Text="Cap stays on while a sleeping app briefly wakes, so it can't spike. Higher = more responsive, lower = less CPU use."
                                           Style="{StaticResource CaptionText}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      Style="{StaticResource DarkComboBox}"
                                      ItemsSource="{Binding CpuCapBriefWakeOptions}"
                                      SelectedItem="{Binding BriefWakeCpuCapPercent, Mode=TwoWay}"
                                      VerticalAlignment="Top"
                                      HorizontalAlignment="Stretch"/>
                            <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Top"
                                       Margin="8,8,0,0" Style="{StaticResource BodyText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>
                    </StackPanel>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="Max simultaneous brief wakes"
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Limits how many sleeping apps can wake up at the same time to prevent CPU spikes."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  Style="{StaticResource DarkComboBox}"
                                  ItemsSource="{Binding MaxConcurrentBriefWakeOptions}"
                                  SelectedItem="{Binding MaxConcurrentBriefWakes, Mode=TwoWay}"
                                  VerticalAlignment="Top"
                                  HorizontalAlignment="Stretch"/>
                        <TextBlock Grid.Column="2" Text="apps" VerticalAlignment="Top"
                                   Margin="8,8,0,0" Style="{StaticResource BodyText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                    <!-- ── WAKE TIMING ── -->
                    <!-- Column layout: label fills, fixed 70px textbox, fixed 36px unit. -->
                    <!-- Every row aligns on the right regardless of unit text width.     -->
                    <!-- "Deep sleep after" sets the threshold for BOTH minimized and tray -->
                    <!-- deep sleep — one setting, one row. "Deep wake every" shows only   -->
                    <!-- when Tray Deep Sleep (in Protection) is enabled.                   -->
                    <TextBlock Text="WAKE TIMING" Style="{StaticResource SectionLabel}" Margin="0,0,0,12"/>

                    <TextBlock Text="Minimized apps"
                               Style="{StaticResource HeadingSmall}"
                               Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Brief wake every" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  Style="{StaticResource DarkComboBox}"
                                  ItemsSource="{Binding MinimizedBriefWakeIntervalOptions}"
                                  SelectedItem="{Binding MinimizedBriefWakeIntervalSeconds, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"/>
                        <TextBlock Grid.Column="2" Text="sec" VerticalAlignment="Center"
                                   Margin="8,0,0,0" Style="{StaticResource BodyText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Wake lasts for" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  Style="{StaticResource DarkComboBox}"
                                  ItemsSource="{Binding BriefWakeDurationOptions}"
                                  SelectedItem="{Binding MinimizedBriefWakeDurationSeconds, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"/>
                        <TextBlock Grid.Column="2" Text="sec" VerticalAlignment="Center"
                                   Margin="8,0,0,0" Style="{StaticResource BodyText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>

                    <TextBlock Text="Tray apps"
                               Style="{StaticResource HeadingSmall}"
                               Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Brief wake every" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  Style="{StaticResource DarkComboBox}"
                                  ItemsSource="{Binding TrayBriefWakeIntervalOptions}"
                                  SelectedItem="{Binding TrayBriefWakeIntervalMinutes, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"/>
                        <TextBlock Grid.Column="2" Text="min" VerticalAlignment="Center"
                                   Margin="8,0,0,0" Style="{StaticResource BodyText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Wake lasts for" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  Style="{StaticResource DarkComboBox}"
                                  ItemsSource="{Binding BriefWakeDurationOptions}"
                                  SelectedItem="{Binding TrayBriefWakeDurationSeconds, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"/>
                        <TextBlock Grid.Column="2" Text="sec" VerticalAlignment="Center"
                                   Margin="8,0,0,0" Style="{StaticResource BodyText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>

                    <!-- Deep sleep — shared threshold for minimized + tray apps. -->
                    <TextBlock Text="Deep sleep"
                               Style="{StaticResource HeadingSmall}"
                               Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Deep sleep after" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  Style="{StaticResource DarkComboBox}"
                                  ItemsSource="{Binding DeepSleepAfterOptions}"
                                  SelectedItem="{Binding MinimizeDeepSleepThresholdMinutes, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"/>
                        <TextBlock Grid.Column="2" Text="min" VerticalAlignment="Center"
                                   Margin="8,0,0,0" Style="{StaticResource BodyText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10"
                          Visibility="{Binding TrayDeepSleepEnabled, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tray deep wake every" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  Style="{StaticResource DarkComboBox}"
                                  ItemsSource="{Binding TrayDeepWakeOptions}"
                                  SelectedItem="{Binding TrayDeepSleepWakeIntervalMinutes, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"/>
                        <TextBlock Grid.Column="2" Text="min" VerticalAlignment="Center"
                                   Margin="8,0,0,0" Style="{StaticResource BodyText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>

                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== WHITELIST CARD ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Button Command="{Binding ToggleNeverNapSectionCommand}" Style="{StaticResource ExpanderButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Never-nap list" Style="{StaticResource HeadingMedium}"/>
                                <TextBlock Text="Apps that are never put to sleep, no matter what."
                                           Style="{StaticResource CaptionText}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#x25BC;"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowNeverNap}" Value="True">
                                                <Setter Property="Text" Value="&#x25B2;"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Button>

                    <StackPanel Visibility="{Binding ShowNeverNap, Converter={StaticResource BoolToVis}}" Margin="0,16,0,0">
                    <TextBlock Text="Apps on this list will never be put to sleep. You can also add apps directly from the live monitor using the ··· button next to any napping process."
                               Style="{StaticResource CaptionText}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <!-- Whitelist items -->
                    <ItemsControl ItemsSource="{Binding Whitelist}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="#0C5C9C7C" CornerRadius="4"
                                                    Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="PROTECTED" FontSize="9" FontWeight="Bold"
                                                           Foreground="{StaticResource AccentGreenBrush}"/>
                                            </Border>
                                            <TextBlock Text="{Binding}"
                                                       Style="{StaticResource BodyText}"
                                                       FontFamily="Cascadia Mono, Consolas, Courier New"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="Remove"
                                                FontSize="11"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                Padding="8,4"
                                                Cursor="Hand"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.RemoveFromWhitelistCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty state -->
                    <TextBlock Text="No apps whitelisted yet.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Whitelist.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Add to whitelist form -->
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12,0,12"/>
                    <WrapPanel>
                        <TextBox Width="180"
                                 Text="{Binding WhitelistNewApp, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}"
                                 Height="32"
                                 Margin="0,0,8,0"/>

                        <ComboBox Width="180"
                                  Height="32"
                                  ItemsSource="{Binding RunningProcessNames}"
                                  SelectedItem="{Binding SelectedRunningProcess, Mode=OneWayToSource}"
                                  Margin="0,0,8,0"/>

                        <Button Content="↻"
                                Width="32" Height="32"
                                FontSize="14"
                                ToolTip="Refresh running processes list"
                                Command="{Binding RefreshRunningCommand}"
                                Style="{StaticResource GhostButton}"
                                Margin="0,0,8,0"/>

                        <Button Content="Add to Whitelist"
                                Height="32"
                                Padding="14,0"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding AddToWhitelistCommand}"/>
                    </WrapPanel>
                    <TextBlock Text="Type a process name (without .exe) or pick from the running list, then click Add."
                               Style="{StaticResource CaptionText}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,6,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
