<UserControl x:Class="Systema.Views.TaskSleepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Systema.Core.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:IntEqualConverter x:Key="IntEqualConverter"/>

        <!-- Toggle-style radio button for aggressiveness selector -->
        <Style x:Key="ToggleRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" CornerRadius="6" Padding="10,8"
                                Background="#12FFFFFF" BorderThickness="1" BorderBrush="#18FFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Transparent, borderless clickable button (used for the Advanced expander header) -->
        <Style x:Key="ExpanderButton" TargetType="Button">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Padding"          Value="0"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="4" Padding="0">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#0CFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Inline section label used inside the Advanced card -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,12"/>
        </Style>

        <!-- TextBox style for threshold inputs -->
        <Style x:Key="ThresholdInput" TargetType="TextBox"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width"                   Value="64"/>
            <Setter Property="TextAlignment"           Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height"                  Value="32"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32">

            <!-- ===== HEADER ===== -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Task Sleep" Style="{StaticResource HeadingLarge}"/>
                    <TextBlock Text="Automatically sleeps apps you're not using to keep your PC fast and quiet."
                               Margin="0,6,0,0"
                               Style="{StaticResource BodyText}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <CheckBox Grid.Column="1"
                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                          Style="{StaticResource ToggleSwitch}"
                          VerticalAlignment="Center"
                          Margin="24,0,0,0"/>
            </Grid>

            <!-- ===== LIVE MONITOR CARD ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>

                    <!-- Card header: stats + Show All -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="LIVE MONITOR"
                                       Style="{StaticResource SectionLabel}"
                                       Margin="0,0,0,0"
                                       VerticalAlignment="Center"/>
                            <!-- System CPU pill -->
                            <Border CornerRadius="10" Padding="8,3"
                                    Background="#12FFFFFF"
                                    Margin="12,0,8,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding SystemCpuDisplay}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                            <!-- Napping count pill -->
                            <Border CornerRadius="10" Padding="8,3"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#12FFFFFF"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ThrottledCountDisplay}" Value="all awake">
                                                <Setter Property="Background" Value="#0C3EFF3E"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding ThrottledCountDisplay}"
                                           FontSize="11" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#FCD34D"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ThrottledCountDisplay}" Value="all awake">
                                                    <Setter Property="Foreground" Value="#6EE7B7"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <!-- CPU freed pill — hidden when nothing is napped -->
                            <Border CornerRadius="10" Padding="8,3"
                                    Background="#0C6EE7B7"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding CpuFreedVisible, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding CpuFreedDisplay}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="#6EE7B7"/>
                            </Border>
                        </WrapPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Show all"
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <CheckBox IsChecked="{Binding ShowAllProcesses, Mode=TwoWay}"
                                      Style="{StaticResource ToggleSwitch}"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Process table column headers -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PROCESS"
                                   Style="{StaticResource CaptionText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="CPU%"
                                   Style="{StaticResource CaptionText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Right"/>
                        <TextBlock Grid.Column="2" Text="STATUS"
                                   Style="{StaticResource CaptionText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontWeight="SemiBold"
                                   Margin="10,0,0,0"/>
                        <TextBlock Grid.Column="3" Text="AFFINITY"
                                   Style="{StaticResource CaptionText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontWeight="SemiBold"
                                   Margin="6,0,0,0"/>
                        <TextBlock Grid.Column="4" Text="SINCE"
                                   Style="{StaticResource CaptionText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontWeight="SemiBold"
                                   Margin="6,0,0,0"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,6"/>

                    <!-- Process rows -->
                    <ScrollViewer MaxHeight="230"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding LiveProcesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4" MinHeight="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="88"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="32"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Process name — bold when napping -->
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsThrottled}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- CPU% -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding CpuPercent, StringFormat={}{0:F1}}"
                                                   Style="{StaticResource CaptionText}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center"/>

                                        <!-- Status badge — Napping (amber), Active (blue), Pending (purple) -->
                                        <Border Grid.Column="2"
                                                CornerRadius="4" Padding="6,2"
                                                Margin="8,0,0,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusLabel}" Value="Napping">
                                                            <Setter Property="Background" Value="#78350F"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusLabel}" Value="Active">
                                                            <Setter Property="Background" Value="#1E3A5F"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusLabel}" Value="Pending">
                                                            <Setter Property="Background" Value="#2D1B5E"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusLabel}" Value="Deep Sleep">
                                                            <Setter Property="Background" Value="#1E1B4B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusLabel}"
                                                       FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusLabel}" Value="Napping">
                                                                <Setter Property="Foreground" Value="#FCD34D"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusLabel}" Value="Active">
                                                                <Setter Property="Foreground" Value="#60A5FA"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusLabel}" Value="Pending">
                                                                <Setter Property="Foreground" Value="#C084FC"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusLabel}" Value="Deep Sleep">
                                                                <Setter Property="Foreground" Value="#A5B4FC"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding CoreLabel}"
                                                   Style="{StaticResource CaptionText}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="6,0,0,0"
                                                   VerticalAlignment="Center"/>

                                        <!-- Duration when napping; skip reason when not -->
                                        <TextBlock Grid.Column="4"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="6,0,0,0"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding SkipReason}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                                    <Setter Property="Text" Value="{Binding SkipReason}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsThrottled}" Value="True">
                                                            <Setter Property="Text" Value="{Binding ThrottledFor}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- ⋯ action menu — only shown when napping -->
                                        <Button Grid.Column="5"
                                                Content="···"
                                                FontSize="14"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                Padding="0" Margin="4,0,0,0"
                                                Cursor="Hand"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                ToolTip="Options for this process"
                                                Click="ProcessMenuButton_Click">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsThrottled}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Button.Tag>0</Button.Tag>
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Stop Napping"
                                                              Command="{Binding DataContext.WakeProcessCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              CommandParameter="{Binding}"/>
                                                    <Separator/>
                                                    <MenuItem Header="Whitelist — never nap this app"
                                                              Command="{Binding DataContext.WhitelistProcessCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              CommandParameter="{Binding}"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty state: Task Sleep disabled -->
                    <TextBlock Text="Turn on Task Sleep above to start monitoring.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="Margin" Value="0,6,0,0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Empty state: enabled but nothing napping -->
                    <TextBlock Text="No apps napping right now.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="Margin" Value="0,6,0,0"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                            <Condition Binding="{Binding LiveProcesses.Count}" Value="0"/>
                                        </MultiDataTrigger.Conditions>
                                        <MultiDataTrigger.Setters>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger.Setters>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14,0,12"/>

                    <!-- Recent Activity -->
                    <TextBlock Text="RECENT ACTIVITY"
                               Style="{StaticResource SectionLabel}"
                               Margin="0,0,0,10"/>

                    <ScrollViewer MaxHeight="160"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding RecentEvents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <WrapPanel Margin="0,0,0,4" VerticalAlignment="Center">

                                        <!-- Timestamp -->
                                        <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}"
                                                   Style="{StaticResource CaptionText}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Width="56"
                                                   Margin="0,0,8,0"/>

                                        <!-- Action badge -->
                                        <Border CornerRadius="4" Padding="6,2"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1F2937"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Action}" Value="Napping">
                                                            <Setter Property="Background" Value="#78350F"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="Minimize Nap">
                                                            <Setter Property="Background" Value="#78350F"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="Tray Nap">
                                                            <Setter Property="Background" Value="#78350F"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="Smart Nap">
                                                            <Setter Property="Background" Value="#713F12"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="Child Nap">
                                                            <Setter Property="Background" Value="#78350F"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="Re-napping">
                                                            <Setter Property="Background" Value="#78350F"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="Tray Re-nap">
                                                            <Setter Property="Background" Value="#78350F"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="Brief Wake">
                                                            <Setter Property="Background" Value="#1E3A5F"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="Deep Wake">
                                                            <Setter Property="Background" Value="#1E1B4B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="Tray Wake">
                                                            <Setter Property="Background" Value="#1E3A5F"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="Tray Deep Wake">
                                                            <Setter Property="Background" Value="#1E1B4B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="Woke up">
                                                            <Setter Property="Background" Value="#064E3B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="Re-enforced">
                                                            <Setter Property="Background" Value="#4C1D95"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="Auto-whitelisted">
                                                            <Setter Property="Background" Value="#064E3B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="Error">
                                                            <Setter Property="Background" Value="#7F1D1D"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Action}"
                                                       FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Action}" Value="Napping">
                                                                <Setter Property="Foreground" Value="#FCD34D"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="Minimize Nap">
                                                                <Setter Property="Foreground" Value="#FCD34D"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="Tray Nap">
                                                                <Setter Property="Foreground" Value="#FCD34D"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="Smart Nap">
                                                                <Setter Property="Foreground" Value="#FBBF24"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="Child Nap">
                                                                <Setter Property="Foreground" Value="#FCD34D"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="Re-napping">
                                                                <Setter Property="Foreground" Value="#FCD34D"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="Tray Re-nap">
                                                                <Setter Property="Foreground" Value="#FCD34D"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="Brief Wake">
                                                                <Setter Property="Foreground" Value="#60A5FA"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="Deep Wake">
                                                                <Setter Property="Foreground" Value="#A5B4FC"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="Tray Wake">
                                                                <Setter Property="Foreground" Value="#60A5FA"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="Tray Deep Wake">
                                                                <Setter Property="Foreground" Value="#A5B4FC"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="Woke up">
                                                                <Setter Property="Foreground" Value="#6EE7B7"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="Re-enforced">
                                                                <Setter Property="Foreground" Value="#C084FC"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="Auto-whitelisted">
                                                                <Setter Property="Foreground" Value="#6EE7B7"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="Error">
                                                                <Setter Property="Foreground" Value="#FCA5A5"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <!-- Process name -->
                                        <TextBlock Text="{Binding ProcessName}"
                                                   Style="{StaticResource CaptionText}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>

                                        <!-- Detail (hidden if empty) -->
                                        <TextBlock Text="{Binding Detail}"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Detail}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                    </WrapPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty state: no events yet -->
                    <TextBlock Text="No activity yet.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecentEvents.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Status message -->
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource CaptionText}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,10,0,0"/>

                </StackPanel>
            </Border>

            <!-- ===== SLEEP BEHAVIOR CARD ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="SLEEP BEHAVIOR"
                               Style="{StaticResource SectionLabel}"
                               Margin="0,0,0,16"/>

                    <!-- Stay asleep until opened (Persistent Nap) -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Stay asleep until opened"
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Once an app is put to sleep, it stays asleep until you click on it. Prevents apps from constantly waking themselves up."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding PersistentNapEnabled, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Top"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                    <!-- CPU-triggered nap -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Nap high-CPU background apps"
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Automatically slows down background apps that are using too much CPU while your system is under load."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding CpuTriggeredNapEnabled, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Top"/>
                    </Grid>

                    <!-- Nap child processes -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Nap child processes"
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="When an app is put to sleep, also sleep its helper processes. Frees up more resources but some apps may not handle this well."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding NapChildrenEnabled, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Top"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                    <!-- Minimize Nap -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Sleep minimized apps"
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Puts apps to sleep after you minimize them. Apps playing audio, on calls, or recording are always protected. Sleeping apps get periodic brief wakes to stay up to date."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding MinimizeNapEnabled, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Top"/>
                    </Grid>

                    <!-- Minimize Nap: brief wake interval -->
                    <Grid Margin="16,0,0,12"
                          Visibility="{Binding MinimizeNapEnabled, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Brief wake every"
                                       Style="{StaticResource CaptionText}" FontWeight="SemiBold"/>
                            <TextBlock Text="How often sleeping apps are briefly woken up to check for updates and notifications."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBox Grid.Column="1"
                                 Text="{Binding MinimizedBriefWakeIntervalSeconds, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource ThresholdInput}"/>
                        <TextBlock Grid.Column="2" Text="sec" VerticalAlignment="Center"
                                   Margin="6,0,0,0" Style="{StaticResource BodyText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>

                    <!-- Minimize Nap: brief wake duration -->
                    <Grid Margin="16,0,0,12"
                          Visibility="{Binding MinimizeNapEnabled, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Wake lasts for"
                                       Style="{StaticResource CaptionText}" FontWeight="SemiBold"/>
                            <TextBlock Text="How long the app stays awake during each brief wake before going back to sleep."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBox Grid.Column="1"
                                 Text="{Binding MinimizedBriefWakeDurationSeconds, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource ThresholdInput}"/>
                        <TextBlock Grid.Column="2" Text="sec" VerticalAlignment="Center"
                                   Margin="6,0,0,0" Style="{StaticResource BodyText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>

                    <!-- Minimize Nap: deep sleep threshold -->
                    <Grid Margin="16,0,0,16"
                          Visibility="{Binding MinimizeNapEnabled, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Deep sleep after"
                                       Style="{StaticResource CaptionText}" FontWeight="SemiBold"/>
                            <TextBlock Text="After being minimized this long without being opened, the app enters deep sleep with much longer intervals between wakes."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBox Grid.Column="1"
                                 Text="{Binding MinimizeDeepSleepThresholdMinutes, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource ThresholdInput}"/>
                        <TextBlock Grid.Column="2" Text="min" VerticalAlignment="Center"
                                   Margin="6,0,0,0" Style="{StaticResource BodyText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                    <!-- Tray Nap -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Sleep system tray apps"
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Puts background apps that only live in the system tray to sleep — things like cloud sync, game launchers, and background utilities. Apps playing audio are always protected."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding TrayNapEnabled, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Top"/>
                    </Grid>

                    <!-- Tray Nap: brief wake interval -->
                    <Grid Margin="16,0,0,12"
                          Visibility="{Binding TrayNapEnabled, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Tray wake every"
                                       Style="{StaticResource CaptionText}" FontWeight="SemiBold"/>
                            <TextBlock Text="How often sleeping tray apps are briefly woken up to sync data and check for updates."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBox Grid.Column="1"
                                 Text="{Binding TrayBriefWakeIntervalMinutes, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource ThresholdInput}"/>
                        <TextBlock Grid.Column="2" Text="min" VerticalAlignment="Center"
                                   Margin="6,0,0,0" Style="{StaticResource BodyText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>

                    <!-- Tray Nap: brief wake duration -->
                    <Grid Margin="16,0,0,16"
                          Visibility="{Binding TrayNapEnabled, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Tray wake lasts for"
                                       Style="{StaticResource CaptionText}" FontWeight="SemiBold"/>
                            <TextBlock Text="How long tray apps stay awake during each brief wake."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBox Grid.Column="1"
                                 Text="{Binding TrayBriefWakeDurationSeconds, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource ThresholdInput}"/>
                        <TextBlock Grid.Column="2" Text="sec" VerticalAlignment="Center"
                                   Margin="6,0,0,0" Style="{StaticResource BodyText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>

                    <!-- Tray Deep Sleep -->
                    <Grid Margin="16,0,0,16"
                          Visibility="{Binding TrayNapEnabled, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Tray deep sleep"
                                       Style="{StaticResource CaptionText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Tray apps that have been sleeping for a while enter a deeper sleep with even less frequent wakes to save more resources."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding TrayDeepSleepEnabled, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Top"/>
                    </Grid>

                    <!-- Tray deep sleep threshold -->
                    <Grid Margin="32,0,0,12"
                          Visibility="{Binding TrayDeepSleepEnabled, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Deep sleep after"
                                       Style="{StaticResource CaptionText}" FontWeight="SemiBold"/>
                            <TextBlock Text="How long a tray app must be sleeping before it enters deep sleep."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBox Grid.Column="1"
                                 Text="{Binding TrayDeepSleepThresholdMinutes, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource ThresholdInput}"/>
                        <TextBlock Grid.Column="2" Text="min" VerticalAlignment="Center"
                                   Margin="6,0,0,0" Style="{StaticResource BodyText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>

                    <!-- Tray deep sleep wake interval -->
                    <Grid Margin="32,0,0,16"
                          Visibility="{Binding TrayDeepSleepEnabled, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Deep sleep wake every"
                                       Style="{StaticResource CaptionText}" FontWeight="SemiBold"/>
                            <TextBlock Text="How often deep-sleeping tray apps are briefly woken up."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBox Grid.Column="1"
                                 Text="{Binding TrayDeepSleepWakeIntervalMinutes, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource ThresholdInput}"/>
                        <TextBlock Grid.Column="2" Text="min" VerticalAlignment="Center"
                                   Margin="6,0,0,0" Style="{StaticResource BodyText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                    <!-- CPU Cap for napped apps -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="CPU cap for napped apps"
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Puts a hard limit on how much CPU sleeping apps can use. Unlike priority alone, this is enforced by Windows itself — apps physically cannot exceed the cap."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding NappedCpuCapEnabled, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Top"/>
                    </Grid>

                    <!-- CPU cap percent -->
                    <Grid Margin="16,0,0,16"
                          Visibility="{Binding NappedCpuCapEnabled, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Max CPU for napped apps"
                                       Style="{StaticResource CaptionText}" FontWeight="SemiBold"/>
                            <TextBlock Text="The maximum CPU percentage a sleeping app is allowed to use. Lower values free up more power for what you're actually doing. Apps are only suspended if they exceed this cap by more than 4%, so background tasks like updates still run."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBox Grid.Column="1"
                                 Text="{Binding NappedCpuCapPercent, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource ThresholdInput}"/>
                        <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center"
                                   Margin="6,0,0,0" Style="{StaticResource BodyText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                    <!-- Max concurrent brief wakes -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Max simultaneous brief wakes"
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Limits how many sleeping apps can wake up at the same time. Prevents CPU spikes when multiple apps try to wake at once."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <TextBox Grid.Column="1"
                                 Text="{Binding MaxConcurrentBriefWakes, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource ThresholdInput}"/>
                        <TextBlock Grid.Column="2" Text="apps" VerticalAlignment="Center"
                                   Margin="6,0,0,0" Style="{StaticResource BodyText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                    <!-- Protect active window -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Protect active window"
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="The app you're currently using and its helper processes are always protected from being slept."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding IgnoreForeground, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Top"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                    <!-- Skip system services -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Skip system services"
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Protects Windows services, antivirus, GPU drivers, audio drivers, anti-cheat, and other critical system processes from being touched."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding ExcludeSystemServices, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Top"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                    <!-- Windows Efficiency Mode -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Windows Efficiency Mode"
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Uses Windows EcoQoS to reduce power consumption for sleeping apps. Lowers clock speed and heat, especially helpful on laptops."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding EnableEfficiencyMode, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Top"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                    <!-- Lower CPU priority -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Lower CPU priority"
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Drops sleeping apps to the lowest CPU priority so they only get processing time when nothing else needs it."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding LowerCpuPriority, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Top"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                    <!-- ── AGGRESSIVENESS ── -->
                    <TextBlock Text="AGGRESSIVENESS" Style="{StaticResource SectionLabel}"/>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="How aggressively should Task Sleep throttle background apps?"
                                   Style="{StaticResource CaptionText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <UniformGrid Rows="1" Margin="0,0,0,0">
                            <RadioButton Content="Light"
                                         GroupName="Aggressiveness"
                                         IsChecked="{Binding AggressivenessLevel, Converter={StaticResource IntEqualConverter}, ConverterParameter=3}"
                                         Style="{StaticResource ToggleRadio}"
                                         Margin="0,0,6,0"/>
                            <RadioButton Content="Balanced"
                                         GroupName="Aggressiveness"
                                         IsChecked="{Binding AggressivenessLevel, Converter={StaticResource IntEqualConverter}, ConverterParameter=0}"
                                         Style="{StaticResource ToggleRadio}"
                                         Margin="0,0,6,0"/>
                            <RadioButton Content="Aggressive"
                                         GroupName="Aggressiveness"
                                         IsChecked="{Binding AggressivenessLevel, Converter={StaticResource IntEqualConverter}, ConverterParameter=1}"
                                         Style="{StaticResource ToggleRadio}"
                                         Margin="0,0,6,0"/>
                            <RadioButton Content="Maximum"
                                         GroupName="Aggressiveness"
                                         IsChecked="{Binding AggressivenessLevel, Converter={StaticResource IntEqualConverter}, ConverterParameter=2}"
                                         Style="{StaticResource ToggleRadio}"/>
                        </UniformGrid>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                    <!-- ── FINE-TUNING ── -->
                    <TextBlock Text="FINE-TUNING" Style="{StaticResource SectionLabel}"/>

                    <!-- Soft nap mode -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Soft nap mode"
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Uses gentler throttling for CPU-triggered naps — apps stay more responsive but save less power."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding SoftNapEnabled, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Top"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                    <!-- Prevent apps from waking themselves -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Prevent apps from waking themselves"
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Re-applies throttling if an app raises its own priority. Apps that fight back 3 times are auto-whitelisted."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding EnforceSettings, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Top"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                    <!-- Adaptive monitor speed -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Adaptive monitor speed"
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Slows down monitoring when idle to save CPU. Speeds back up when activity is detected."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding AdaptiveTick, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Top"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- ===== BETA FEATURES ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Beta Features" Style="{StaticResource HeadingMedium}"/>
                        <Border Background="#D97706" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="BETA" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="New features in testing — try them out and toggle individually"
                               Style="{StaticResource CaptionText}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,16"/>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                    <!-- Elevated process guard -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Elevated process guard"
                                           Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                                <Border Background="#D97706" CornerRadius="3" Padding="4,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Beta" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Automatically protects admin/elevated processes (Hyper-V VMs, Docker, WSL2, elevated tools) from being napped. Uses Windows integrity levels — no name list needed."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding ElevatedProcessGuardEnabled, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Top"/>
                    </Grid>

                    <!-- Multi-monitor awareness -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Multi-monitor awareness"
                                           Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                                <Border Background="#D97706" CornerRadius="3" Padding="4,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Beta" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="If you can see an app on any of your monitors, it won't be put to sleep — even if it's not the window you're currently clicking in."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding MultiMonitorAwarenessEnabled, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Top"/>
                    </Grid>

                    <!-- Process group awareness -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Process group awareness"
                                           Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                                <Border Background="#D97706" CornerRadius="3" Padding="4,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Beta" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="When you're using an app, all of its processes stay awake. For example, if one Chrome window is focused, every Chrome process is protected."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding ProcessGroupAwarenessEnabled, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Top"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                    <!-- Network activity guard -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Network activity guard"
                                           Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                                <Border Background="#D97706" CornerRadius="3" Padding="4,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Beta" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Apps that are actively downloading, uploading, or streaming data won't be put to sleep until they finish."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding NetworkActivityGuardEnabled, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Top"/>
                    </Grid>

                    <!-- Network threshold -->
                    <Grid Margin="16,0,0,16"
                          Visibility="{Binding NetworkActivityGuardEnabled, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Network threshold"
                                       Style="{StaticResource CaptionText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Apps using more than this amount of network traffic are protected from sleeping."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBox Grid.Column="1"
                                 Text="{Binding NetworkActivityThresholdKBps, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource ThresholdInput}"/>
                        <TextBlock Grid.Column="2" Text="KB/s" VerticalAlignment="Center"
                                   Margin="6,0,0,0" Style="{StaticResource BodyText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>

                    <!-- Disk I/O guard -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Disk I/O guard"
                                           Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                                <Border Background="#D97706" CornerRadius="3" Padding="4,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Beta" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Apps that are actively reading or writing files (saving, compiling, installing) won't be put to sleep until they finish."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding DiskIoGuardEnabled, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Top"/>
                    </Grid>

                    <!-- Disk I/O threshold -->
                    <Grid Margin="16,0,0,16"
                          Visibility="{Binding DiskIoGuardEnabled, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Disk I/O threshold"
                                       Style="{StaticResource CaptionText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Apps using more than this amount of disk activity are protected from sleeping."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBox Grid.Column="1"
                                 Text="{Binding DiskIoThresholdKBps, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource ThresholdInput}"/>
                        <TextBlock Grid.Column="2" Text="KB/s" VerticalAlignment="Center"
                                   Margin="6,0,0,0" Style="{StaticResource BodyText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                    <!-- Smart aggressive nap -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Smart aggressive nap"
                                           Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                                <Border Background="#D97706" CornerRadius="3" Padding="4,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Beta" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Finds background apps that have been doing nothing for a while and puts them to sleep, even if they aren't on the known resource wasters list."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding SmartAggressiveNapEnabled, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Top"/>
                    </Grid>

                    <!-- Smart aggressive sub-settings -->
                    <StackPanel Margin="16,0,0,0"
                                Visibility="{Binding SmartAggressiveNapEnabled, Converter={StaticResource BoolToVis}}">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                <TextBlock Text="CPU threshold"
                                           Style="{StaticResource CaptionText}" FontWeight="SemiBold"/>
                                <TextBlock Text="Apps using less CPU than this are considered idle."
                                           Style="{StaticResource CaptionText}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBox Grid.Column="1"
                                     Text="{Binding SmartAggressiveCpuThresholdPercent, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource ThresholdInput}"/>
                            <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center"
                                       Margin="6,0,0,0" Style="{StaticResource BodyText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                <TextBlock Text="Idle checks required"
                                           Style="{StaticResource CaptionText}" FontWeight="SemiBold"/>
                                <TextBlock Text="How many consecutive checks the app must be idle before it's put to sleep."
                                           Style="{StaticResource CaptionText}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBox Grid.Column="1"
                                     Text="{Binding SmartAggressiveTickCount, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource ThresholdInput}"/>
                            <TextBlock Grid.Column="2" Text="checks" VerticalAlignment="Center"
                                       Margin="6,0,0,0" Style="{StaticResource BodyText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                    <!-- Notification grace period -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Notification grace period"
                                           Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                                <Border Background="#D97706" CornerRadius="3" Padding="4,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Beta" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="When an app receives a notification or updates its status, it gets extra time before being put to sleep so you don't miss anything."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding NotificationGracePeriodEnabled, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Top"/>
                    </Grid>

                    <!-- Notification grace duration -->
                    <Grid Margin="16,0,0,16"
                          Visibility="{Binding NotificationGracePeriodEnabled, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Grace duration"
                                       Style="{StaticResource CaptionText}" FontWeight="SemiBold"/>
                            <TextBlock Text="How long to wait after a notification before allowing the app to be slept."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBox Grid.Column="1"
                                 Text="{Binding NotificationGracePeriodSeconds, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource ThresholdInput}"/>
                        <TextBlock Grid.Column="2" Text="s" VerticalAlignment="Center"
                                   Margin="6,0,0,0" Style="{StaticResource BodyText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>


                </StackPanel>
            </Border>


            <!-- ===== WHITELIST CARD ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="NEVER NAP LIST" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                    <TextBlock Text="Apps on this list will never be put to sleep. You can also add apps directly from the live monitor using the ··· button next to any napping process."
                               Style="{StaticResource CaptionText}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <!-- Whitelist items -->
                    <ItemsControl ItemsSource="{Binding Whitelist}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="#0C3EFF3E" CornerRadius="4"
                                                    Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="PROTECTED" FontSize="9" FontWeight="Bold"
                                                           Foreground="#6EE7B7"/>
                                            </Border>
                                            <TextBlock Text="{Binding}"
                                                       Style="{StaticResource BodyText}"
                                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="Remove"
                                                FontSize="11"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                Padding="8,4"
                                                Cursor="Hand"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.RemoveFromWhitelistCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty state -->
                    <TextBlock Text="No apps whitelisted yet.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Whitelist.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Add to whitelist form -->
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12,0,12"/>
                    <WrapPanel>
                        <TextBox Width="180"
                                 Text="{Binding WhitelistNewApp, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}"
                                 Height="32"
                                 Margin="0,0,8,0"/>

                        <ComboBox Width="180"
                                  Height="32"
                                  ItemsSource="{Binding RunningProcessNames}"
                                  SelectedItem="{Binding SelectedRunningProcess, Mode=OneWayToSource}"
                                  Margin="0,0,8,0"/>

                        <Button Content="↻"
                                Width="32" Height="32"
                                FontSize="14"
                                ToolTip="Refresh running processes list"
                                Command="{Binding RefreshRunningCommand}"
                                Style="{StaticResource GhostButton}"
                                Margin="0,0,8,0"/>

                        <Button Content="Add to Whitelist"
                                Height="32"
                                Padding="14,0"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding AddToWhitelistCommand}"/>
                    </WrapPanel>
                    <TextBlock Text="Type a process name (without .exe) or pick from the running list, then click Add."
                               Style="{StaticResource CaptionText}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
