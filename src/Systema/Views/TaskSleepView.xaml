<UserControl x:Class="Systema.Views.TaskSleepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Systema.Core.Converters"
             xmlns:core="clr-namespace:Systema.Core"
             xmlns:ctl="clr-namespace:Systema.Controls">

    <!-- Windows 11 Settings layout. Each section is a settings expander: a header row with a
         rotating chevron, and when open, its settings as rows split by hairlines. The live
         process table, timing pickers and never-nap list are unchanged inside their sections.
         Same bindings and text as before; only the layout changed. -->

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:IntEqualConverter x:Key="IntEqualConverter"/>
        <conv:BoolToIndexConverter x:Key="BoolToIndex"/>
        <conv:ProcessIconConverter x:Key="ProcessIcon"/>
        <conv:ActivityKindConverter x:Key="ActivityKind"/>

        <!-- Windows 11's icon font (Segoe MDL2 Assets on Windows 10 has the same code points) -->
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Live monitor row's "More" button: Windows 11's subtle icon button (no fill until
             hovered), the "..." at the end of every row in Settings > Installed apps. -->
        <Style x:Key="RowMoreButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Content" Value="&#xE712;"/>
        </Style>

        <!-- Toggle-style radio button for aggressiveness selector -->
        <Style x:Key="ToggleRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" CornerRadius="6" Padding="10,8"
                                Background="{DynamicResource OverlaySubtleBrush}" BorderThickness="1" BorderBrush="{DynamicResource OverlayStrokeBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource OverlayLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentBlueBrush}"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource TextInfoBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox style for threshold inputs -->
        <Style x:Key="ThresholdInput" TargetType="TextBox"
               BasedOn="{StaticResource DarkTextBox}">
            <Setter Property="Width"                   Value="64"/>
            <Setter Property="TextAlignment"           Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height"                  Value="32"/>
            <Setter Property="core:NumericTextBox.IsNumericOnly" Value="True"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32">

            <!-- ===== HEADER ===== -->
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="Systema Engine" Style="{StaticResource HeadingLarge}"/>
                <TextBlock Text="Sleeps idle apps, speeds up launches, and keeps the app you're using responsive, all on its own."
                           Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- ===== STATUS: master switch + live counts ===== -->
            <Border Style="{StaticResource ListRowCard}" Padding="18,14" Margin="0,16,0,4">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource AccentGreenBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource HeadingSmall}">
                                        <Setter Property="Text" Value="Engine is off"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                <Setter Property="Text" Value="Engine is on"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource ControlFillBrush}" CornerRadius="6" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="Apps napping" Style="{StaticResource CaptionText}"/>
                                <TextBlock Text="{Binding AppsNappingCount}" FontSize="22" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBlueBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{DynamicResource ControlFillBrush}" CornerRadius="6" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="Active apps" Style="{StaticResource CaptionText}"/>
                                <TextBlock Text="{Binding ActiveAppsCount}" FontSize="22" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentGreenBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══════════════════════ SPEED ══════════════════════ -->
            <TextBlock Text="Speed" Style="{StaticResource SettingsGroupHeader}"/>

            <!-- ===== LAUNCH BOOST ===== -->
            <Border Style="{StaticResource ExpanderCard}">
                <!-- Whole section grays out when Task Sleep itself is off: Launch Boost
                     cannot run without the Task Sleep engine. -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanUseLaunchBoost}" Value="False">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Setter Property="Opacity"   Value="0.5"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Button Command="{Binding ToggleLaunchBoostSectionCommand}" Style="{StaticResource ExpanderButton}">
                        <Grid Margin="18,14" MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Launch Boost" Style="{StaticResource ExpanderHeaderTitle}"/>
                                    <Border BorderBrush="{DynamicResource AccentGreenBrush}" BorderThickness="1" CornerRadius="4"
                                            Background="{DynamicResource ControlFillBrush}"
                                            Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Safe" FontSize="11" Foreground="{DynamicResource AccentGreenBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Opens apps faster with a short priority boost at launch."
                                           Style="{StaticResource CaptionText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Path Grid.Column="1" Style="{StaticResource ExpanderChevron}" Margin="16,0,0,0"
                                  ctl:Motion.Flipped="{Binding ShowLaunchBoost}"/>
                        </Grid>
                    </Button>

                    <StackPanel Visibility="{Binding ShowLaunchBoost, Converter={StaticResource BoolToVis}}"
                                ctl:Motion.RevealOnShow="True">

                        <!-- Master toggle -->
                        <ctl:SettingsCard Header="Turn on Launch Boost" Style="{StaticResource ExpanderItem}" RecommendKey="LaunchBoost">
                            <ctl:SettingsCard.Description>
                                <TextBlock Style="{StaticResource CardDescription}">
                                    Gives apps a temporary priority boost the moment they launch so they open faster,
                                    then hands control back to Windows. Off by default.
                                </TextBlock>
                            </ctl:SettingsCard.Description>
                            <CheckBox Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding LaunchBoostEnabled, Mode=TwoWay}"/>
                        </ctl:SettingsCard>

                        <!-- Sub-settings: grayed out until Launch Boost is turned on -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LaunchBoostEnabled}" Value="False">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="Opacity"   Value="0.4"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- Boost duration (dropdown: 5 / 10 / 20 / 40) -->
                            <ctl:SettingsCard Header="Boost duration" Style="{StaticResource ExpanderItem}"
                                              Description="How long the priority boost lasts after an app starts.">
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox Width="70"
                                              Style="{StaticResource DarkComboBox}"
                                              ItemsSource="{Binding LaunchBoostDurationOptions}"
                                              SelectedItem="{Binding LaunchBoostDurationSeconds, Mode=TwoWay}"/>
                                    <TextBlock Text="seconds" Style="{StaticResource CaptionText}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                            </ctl:SettingsCard>

                            <!-- Rule toggles -->
                            <ctl:SettingsCard Header="CPU priority → High" Style="{StaticResource ExpanderItem}">
                                <CheckBox Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding LaunchBoostCpu, Mode=TwoWay}"/>
                            </ctl:SettingsCard>
                            <ctl:SettingsCard Header="I/O priority → High" Style="{StaticResource ExpanderItem}">
                                <CheckBox Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding LaunchBoostIo, Mode=TwoWay}"/>
                            </ctl:SettingsCard>
                            <ctl:SettingsCard Header="Efficiency mode → Off" Style="{StaticResource ExpanderItem}">
                                <CheckBox Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding LaunchBoostDisableEfficiency, Mode=TwoWay}"/>
                            </ctl:SettingsCard>

                            <!-- GPU priority: opt-in, default off, VSync caveat -->
                            <ctl:SettingsCard Header="GPU priority → Max" Style="{StaticResource ExpanderItem}">
                                <ctl:SettingsCard.Description>
                                    <TextBlock Text="Advanced. Raises GPU scheduling priority. It can affect VSync or frame pacing on some systems, so it's off by default."
                                               Style="{StaticResource CardDescription}"
                                               Foreground="{DynamicResource AccentYellowBrush}"/>
                                </ctl:SettingsCard.Description>
                                <CheckBox Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding LaunchBoostGpu, Mode=TwoWay}"/>
                            </ctl:SettingsCard>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== RESPONSIVENESS ===== -->
            <!-- Foreground Priority Boost + Instant App Focus + Instant Startup Apps +
                 Maximum System Responsiveness are all part of the engine: this group grays
                 out and the toggles force off when the engine is off, and default on when
                 it's on. -->
            <Border Style="{StaticResource ExpanderCard}">
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanUseResponsiveness}" Value="False">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Setter Property="Opacity"   Value="0.5"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Button Command="{Binding ToggleResponsivenessSectionCommand}" Style="{StaticResource ExpanderButton}">
                        <Grid Margin="18,14" MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Responsiveness boosts" Style="{StaticResource ExpanderHeaderTitle}"/>
                                <TextBlock Text="Eleven tweaks that keep the active app fast: priority, focus, throttling, startup, and shutdown."
                                           Style="{StaticResource CaptionText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Path Grid.Column="1" Style="{StaticResource ExpanderChevron}" Margin="16,0,0,0"
                                  ctl:Motion.Flipped="{Binding ShowResponsiveness}"/>
                        </Grid>
                    </Button>

                    <StackPanel Visibility="{Binding ShowResponsiveness, Converter={StaticResource BoolToVis}}"
                                ctl:Motion.RevealOnShow="True">

                        <!-- Foreground Priority Boost -->
                        <ctl:SettingsCard Header="Foreground priority boost" Style="{StaticResource ExpanderItem}" RecommendKey="ForegroundBoost"
                                          Badge="Safe" BadgeBrush="{DynamicResource TextSecondaryBrush}">
                            <ctl:SettingsCard.Description>
                                <TextBlock Style="{StaticResource CardDescription}">
                                    Gives the app you're using a bigger share of CPU time so the active window stays
                                    snappy while background apps keep running.
                                    <LineBreak/><Run FontWeight="SemiBold">With the Systema Engine:</Run> as the
                                    engine quiets background apps, this steers that freed-up CPU to the app you're actually
                                    using, so the two work together.
                                </TextBlock>
                            </ctl:SettingsCard.Description>
                            <CheckBox Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding ForegroundBoostEnabled, Mode=TwoWay}"/>
                        </ctl:SettingsCard>

                        <!-- Instant App Focus -->
                        <ctl:SettingsCard Header="Instant app focus" Style="{StaticResource ExpanderItem}" RecommendKey="InstantAppFocus"
                                          Badge="Safe" BadgeBrush="{DynamicResource TextSecondaryBrush}">
                            <ctl:SettingsCard.Description>
                                <TextBlock Style="{StaticResource CardDescription}">
                                    Removes Windows' delay before a launching or clicked app jumps to the front, so
                                    apps come to focus immediately instead of flashing in the taskbar.
                                    <LineBreak/><Run FontWeight="SemiBold">With the Systema Engine:</Run> when the
                                    engine wakes a napped app, this lets it snap to the front instantly instead of feeling
                                    sluggish for a moment.
                                </TextBlock>
                            </ctl:SettingsCard.Description>
                            <CheckBox Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding InstantAppFocusEnabled, Mode=TwoWay}"/>
                        </ctl:SettingsCard>

                        <!-- Instant Startup Apps -->
                        <ctl:SettingsCard Header="Instant startup apps" Style="{StaticResource ExpanderItem}" RecommendKey="InstantStartupApps"
                                          Badge="Safe" BadgeBrush="{DynamicResource TextSecondaryBrush}">
                            <ctl:SettingsCard.Description>
                                <TextBlock Style="{StaticResource CardDescription}">
                                    Removes the waiting period Windows imposes on your startup apps after a reboot or
                                    shutdown, so they launch immediately instead of trickling in ~10 seconds late.
                                    Takes effect on the next boot.
                                    <LineBreak/><Run FontWeight="SemiBold">With the Systema Engine:</Run> your apps
                                    start at full speed, and the engine then keeps the idle ones quiet, so you get fast startup without
                                    the lingering background bloat.
                                </TextBlock>
                            </ctl:SettingsCard.Description>
                            <CheckBox Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding InstantStartupApps, Mode=TwoWay}"/>
                        </ctl:SettingsCard>

                        <!-- Maximum System Responsiveness: engine-gated with the boosts above. -->
                        <ctl:SettingsCard Header="Maximum system responsiveness" Style="{StaticResource ExpanderItem}" RecommendKey="MaxResponsiveness"
                                          Badge="Advanced" BadgeBrush="{DynamicResource AccentYellowBrush}">
                            <ctl:SettingsCard.Description>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardDescription}">
                                        Sets the MMCSS SystemResponsiveness reserve to 0, handing the CPU quanta Windows normally
                                        holds back for background work to multimedia and foreground apps. You get steadier frame pacing
                                        under load. OFF restores the Windows default (20).
                                        <LineBreak/><Run FontWeight="SemiBold">With the Systema Engine:</Run> it
                                        reinforces what the engine is already doing, with less CPU reserved for background work and more
                                        for the app in front.
                                    </TextBlock>
                                    <TextBlock Text="Requires a restart to take effect." Style="{StaticResource CardNoteWarn}"/>
                                </StackPanel>
                            </ctl:SettingsCard.Description>
                            <CheckBox Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding MaxResponsivenessEnabled, Mode=TwoWay}"/>
                        </ctl:SettingsCard>

                        <!-- Network Throttling Off: pairs with Maximum System Responsiveness. -->
                        <ctl:SettingsCard Header="Network throttling off" Style="{StaticResource ExpanderItem}" RecommendKey="NetworkThrottlingOff"
                                          Badge="Safe" BadgeBrush="{DynamicResource TextSecondaryBrush}">
                            <ctl:SettingsCard.Description>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardDescription}">
                                        Windows throttles your network to ~10 packets/ms whenever audio or video is playing, to keep
                                        sound smooth. Turning that off hands the full network pipe to the app you're using, so
                                        downloads, streaming, and online games feel snappier. OFF restores the Windows default.
                                        <LineBreak/><Run FontWeight="SemiBold">With the Systema Engine:</Run> it pairs with
                                        Maximum System Responsiveness, the same multimedia profile, now without the network brake.
                                    </TextBlock>
                                    <TextBlock Text="Requires a restart to take effect." Style="{StaticResource CardNoteWarn}"/>
                                </StackPanel>
                            </ctl:SettingsCard.Description>
                            <CheckBox Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding NetworkThrottlingOffEnabled, Mode=TwoWay}"/>
                        </ctl:SettingsCard>

                        <!-- Power Throttling On: lets Windows park background work on efficiency cores. -->
                        <ctl:SettingsCard Header="Power throttling on" Style="{StaticResource ExpanderItem}" RecommendKey="PowerThrottling"
                                          Badge="Safe" BadgeBrush="{DynamicResource TextSecondaryBrush}">
                            <ctl:SettingsCard.Description>
                                <TextBlock Style="{StaticResource CardDescription}">
                                    Lets Windows quietly slow apps it decides are in the background so they draw less power. On a
                                    laptop or a hybrid CPU that steers the background work onto the efficiency cores, cutting heat,
                                    fan noise, and battery drain, while the app you're actually using is left at full speed.
                                    <LineBreak/><Run FontWeight="SemiBold">On by default:</Run> it's the standard Windows behavior.
                                    Turn it off only if you want background apps to keep full clock speed too.
                                </TextBlock>
                            </ctl:SettingsCard.Description>
                            <CheckBox Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding PowerThrottlingOn, Mode=TwoWay}"/>
                        </ctl:SettingsCard>

                        <!-- Fast App Close: snappier shutdown / sign-out. -->
                        <ctl:SettingsCard Header="Fast app close" Style="{StaticResource ExpanderItem}" RecommendKey="FastAppClose"
                                          Badge="Safe" BadgeBrush="{DynamicResource TextSecondaryBrush}">
                            <ctl:SettingsCard.Description>
                                <TextBlock Style="{StaticResource CardDescription}">
                                    Windows waits up to 20 seconds for an app to close when you shut down or sign out before
                                    nudging it. This trims that wait so shutdown and restart feel immediate, and apps still get a
                                    few seconds to save. OFF restores the Windows default.
                                    <LineBreak/><Run FontWeight="SemiBold">With the Systema Engine:</Run> less waiting
                                    when you close things, matching the engine's snappy feel.
                                </TextBlock>
                            </ctl:SettingsCard.Description>
                            <CheckBox Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding FastAppCloseEnabled, Mode=TwoWay}"/>
                        </ctl:SettingsCard>

                        <!-- Keep Kernel in RAM: RAM-gated (default on at >= 14 GB, recommended 16 GB+). -->
                        <ctl:SettingsCard Header="Keep kernel in RAM" Style="{StaticResource ExpanderItem}" RecommendKey="KeepKernelInRam"
                                          Badge="Safe" BadgeBrush="{DynamicResource TextSecondaryBrush}">
                            <ctl:SettingsCard.Description>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardDescription}">
                                        Stops Windows from paging the kernel and drivers out to disk (DisablePagingExecutive), so the
                                        system stays responsive under memory load instead of hitching. OFF restores the Windows default.
                                        <LineBreak/><Run FontWeight="SemiBold">Only recommended if your PC has 16 GB or more of RAM.</Run>
                                        Systema leaves this off by default on machines with less than 14 GB.
                                    </TextBlock>
                                    <TextBlock Text="Requires a restart to take effect." Style="{StaticResource CardNoteWarn}"/>
                                </StackPanel>
                            </ctl:SettingsCard.Description>
                            <CheckBox Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding KeepKernelInRamEnabled, Mode=TwoWay}"/>
                        </ctl:SettingsCard>

                        <!-- Faster Shutdown: AutoEndTasks + HungAppTimeout reinforcement. -->
                        <ctl:SettingsCard Header="Faster shutdown" Style="{StaticResource ExpanderItem}" RecommendKey="FasterShutdown"
                                          Badge="Safe" BadgeBrush="{DynamicResource TextSecondaryBrush}">
                            <ctl:SettingsCard.Description>
                                <TextBlock Style="{StaticResource CardDescription}">
                                    Closes frozen apps automatically when you shut down or sign out (AutoEndTasks), instead of the
                                    "this app is preventing shutdown" prompt. Reinforced by shortening how long Windows waits before
                                    deciding an app is hung (HungAppTimeout → 1000 ms) so a slow app like Discord is force-closed
                                    before the prompt appears. Pairs with Fast App Close (2 s). OFF restores the Windows defaults.
                                    <LineBreak/><Run FontWeight="SemiBold">With the Systema Engine:</Run> shutdown and
                                    restart feel immediate, with no stuck-app prompts.
                                </TextBlock>
                            </ctl:SettingsCard.Description>
                            <CheckBox Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding FasterShutdownEnabled, Mode=TwoWay}"/>
                        </ctl:SettingsCard>

                        <!-- Input Hook Timeout: LowLevelHooksTimeout, enforced in the .DEFAULT hive too. -->
                        <ctl:SettingsCard Header="Input hook timeout" Style="{StaticResource ExpanderItem}" RecommendKey="InputHookTimeout"
                                          Badge="Safe" BadgeBrush="{DynamicResource TextSecondaryBrush}">
                            <ctl:SettingsCard.Description>
                                <TextBlock Style="{StaticResource CardDescription}">
                                    When a misbehaving app installs a keyboard/mouse hook and stalls, Windows freezes your input
                                    until it gives up (LowLevelHooksTimeout, ~5000 ms). This trims it to 1000 ms so input recovers
                                    in a second instead of five. To enforce it everywhere it also writes the same value to the
                                    system's .DEFAULT profile (used at the logon screen). It's safe and reversible. OFF restores the default.
                                    <LineBreak/><Run FontWeight="SemiBold">With the Systema Engine:</Run> the mouse and
                                    keyboard stay responsive even when an app misbehaves.
                                </TextBlock>
                            </ctl:SettingsCard.Description>
                            <CheckBox Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding InputHookTimeoutEnabled, Mode=TwoWay}"/>
                        </ctl:SettingsCard>

                        <!-- Faster Service Shutdown: WaitToKillServiceTimeout trim (service counterpart of Fast App Close). -->
                        <ctl:SettingsCard Header="Faster service shutdown" Style="{StaticResource ExpanderItem}" RecommendKey="ServiceShutdownFast"
                                          Badge="Safe" BadgeBrush="{DynamicResource TextSecondaryBrush}">
                            <ctl:SettingsCard.Description>
                                <TextBlock Style="{StaticResource CardDescription}">
                                    On shutdown or restart Windows waits up to 5 seconds for each background service to stop before
                                    forcing it (WaitToKillServiceTimeout). This trims that to 2 seconds so reboots and shutdowns finish
                                    noticeably quicker, while still giving services a couple of seconds to flush. The service counterpart
                                    of Fast App Close. OFF restores the Windows default.
                                    <LineBreak/><Run FontWeight="SemiBold">With the Systema Engine:</Run> quicker, cleaner
                                    shutdowns and restarts.
                                </TextBlock>
                            </ctl:SettingsCard.Description>
                            <CheckBox Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding ServiceShutdownFastEnabled, Mode=TwoWay}"/>
                        </ctl:SettingsCard>

                        <!-- Disable Fast Startup: HiberbootEnabled=0 only (hibernate left intact so Sleep->Hibernate keeps working). -->
                        <ctl:SettingsCard Header="Disable fast startup" Style="{StaticResource ExpanderItem}" RecommendKey="FastStartupOff"
                                          Badge="Safe" BadgeBrush="{DynamicResource TextSecondaryBrush}">
                            <ctl:SettingsCard.Description>
                                <TextBlock Style="{StaticResource CardDescription}">
                                    Fast Startup makes "Shut down" a hybrid hibernate that reloads the old kernel and driver state on the
                                    next boot, so glitches that build up survive a shutdown and only a full Restart clears them. Turning
                                    it off makes every shutdown a clean cold boot, which fixes a whole class of "a restart fixes it"
                                    instability and lets driver/firmware updates apply correctly. Hibernation itself stays available,
                                    so Sleep → Hibernate keeps working, and sleep is unaffected. OFF restores the Windows default.
                                    <LineBreak/><Run FontWeight="SemiBold">With the Systema Engine:</Run> cleaner, more
                                    stable shutdowns.
                                </TextBlock>
                            </ctl:SettingsCard.Description>
                            <CheckBox Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding FastStartupOffEnabled, Mode=TwoWay}"/>
                        </ctl:SettingsCard>

                        <!-- Disable background Store/UWP apps: BackgroundAccessApplications\GlobalUserDisabled. -->
                        <ctl:SettingsCard Header="Disable background Store apps" Style="{StaticResource ExpanderItem}" RecommendKey="BackgroundAppsOff"
                                          Badge="Safe" BadgeBrush="{DynamicResource TextSecondaryBrush}">
                            <ctl:SettingsCard.Description>
                                <TextBlock Style="{StaticResource CardDescription}">
                                    Stops packaged Store and UWP apps (Xbox, Phone Link, Mail, Weather, etc.) from running tasks in the
                                    background at all. It's a preventive complement to the engine, which only quiets apps once they're already
                                    running. Windows 11 hid the global switch for this, so this is the clean way to control it. Trade-off:
                                    those apps won't update live tiles or push background notifications until you open them. OFF restores
                                    the Windows default.
                                    <LineBreak/><Run FontWeight="SemiBold">With the Systema Engine:</Run> less background churn,
                                    snappier foreground.
                                </TextBlock>
                            </ctl:SettingsCard.Description>
                            <CheckBox Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding BackgroundAppsOffEnabled, Mode=TwoWay}"/>
                        </ctl:SettingsCard>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ══════════════════════ SLEEPING APPS ══════════════════════ -->
            <TextBlock Text="Sleeping apps" Style="{StaticResource SettingsGroupHeader}"/>

            <!-- ===== LIVE MONITOR ===== -->
            <!-- Laid out like the Windows 11 Settings app lists (Installed apps, Battery usage): the
                 section's state beside the chevron, a filter row, one row per app with its real icon,
                 what the engine is doing to it and its CPU, and a "More" button for its actions.
                 Recent activity is a plain log with one Windows icon per kind of event. -->
            <Border Style="{StaticResource ExpanderCard}">
                <StackPanel>

                    <Button Command="{Binding ToggleLiveMonitorSectionCommand}" Style="{StaticResource ExpanderButton}">
                        <Grid Margin="18,14" MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Live monitor" Style="{StaticResource ExpanderHeaderTitle}"/>
                                <TextBlock Text="Watch what the engine is doing in real time, and protect any app on the spot."
                                           Style="{StaticResource CaptionText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding ThrottledCountDisplay}"
                                       Style="{StaticResource BodyText}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="16,0,0,0"/>
                            <Path Grid.Column="2" Style="{StaticResource ExpanderChevron}" Margin="16,0,0,0"
                                  ctl:Motion.Flipped="{Binding ShowLiveMonitor}"/>
                        </Grid>
                    </Button>

                    <StackPanel Visibility="{Binding ShowLiveMonitor, Converter={StaticResource BoolToVis}}"
                                ctl:Motion.RevealOnShow="True">

                    <!-- ── Apps ── -->
                    <Border Style="{StaticResource ExpanderBlock}">
                    <StackPanel>

                    <!-- Filter row, like "Filter by" above Settings > Installed apps -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding SystemCpuDisplay}"
                                   Style="{StaticResource BodyText}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Show" Style="{StaticResource BodyText}"
                                   VerticalAlignment="Center" Margin="12,0,10,0"/>
                        <ComboBox Grid.Column="2" MinWidth="160" AutomationProperties.Name="Show"
                                  SelectedIndex="{Binding ShowAllProcesses, Converter={StaticResource BoolToIndex}, Mode=TwoWay}">
                            <ComboBoxItem Content="Napping apps"/>
                            <ComboBoxItem Content="All processes"/>
                        </ComboBox>
                    </Grid>

                    <!-- App rows. The 14 px right margin keeps the More buttons clear of the
                         scroll bar, which floats over the list's right edge. -->
                    <ScrollViewer MaxHeight="336"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding LiveProcesses}" Margin="0,0,14,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="48">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="44"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- The app's own icon, like every Settings app list -->
                                        <Image Grid.Column="0" Width="24" Height="24" VerticalAlignment="Center"
                                               Source="{Binding Converter={StaticResource ProcessIcon}}"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>

                                        <StackPanel Grid.Column="1" Margin="12,6" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                <!-- A moon beside a napping app, like Task Manager's leaf beside one in efficiency mode -->
                                                <TextBlock Text="&#xE708;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                           Foreground="{DynamicResource AccentBlueBrush}"
                                                           VerticalAlignment="Center" Margin="0,1,6,0"
                                                           Visibility="{Binding IsThrottled, Converter={StaticResource BoolToVis}}"/>
                                                <!-- What the engine is doing to it; for an app it leaves awake, why -->
                                                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                                            <Setter Property="Text" Value="{Binding SkipReason}"/>
                                                            <Setter Property="ToolTip" Value="{Binding SkipReason}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SkipReason}" Value="">
                                                                    <Setter Property="Text" Value="Awake"/>
                                                                    <Setter Property="ToolTip" Value="{x:Null}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusLabel}" Value="Active">
                                                                    <Setter Property="Text" Value="In use"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusLabel}" Value="Pending">
                                                                    <Setter Property="Text" Value="{Binding ThrottledFor, StringFormat='Naps in {0}'}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusLabel}" Value="Napping">
                                                                    <Setter Property="Text" Value="{Binding ThrottledFor, StringFormat='Napping for {0}'}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusLabel}" Value="Deep Sleep">
                                                                    <Setter Property="Text" Value="{Binding ThrottledFor, StringFormat='Deep sleep for {0}'}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text=" · On E-cores" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CoreLabel}" Value="E-cores">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding CpuPercent, StringFormat={}{0:0.0}%}"
                                                   Style="{StaticResource BodyText}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   ToolTip="CPU use right now"/>

                                        <!-- More options (napping apps only). Tag carries the page's view model so the
                                             menu's commands still resolve from the popup, outside the visual tree. -->
                                        <Button Grid.Column="3" HorizontalAlignment="Right"
                                                Style="{StaticResource RowMoreButton}"
                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                ToolTip="More options" AutomationProperties.Name="More options"
                                                Visibility="{Binding IsThrottled, Converter={StaticResource BoolToVis}}"
                                                Click="ProcessMenuButton_Click">
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Stop napping"
                                                              Command="{Binding PlacementTarget.Tag.WakeProcessCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Never nap this app"
                                                              Command="{Binding PlacementTarget.Tag.WhitelistProcessCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty state: Task Sleep disabled -->
                    <TextBlock Text="Turn on Task Sleep above to start monitoring.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Setter Property="Margin" Value="0,6,0,4"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Empty state: enabled but nothing napping -->
                    <TextBlock Text="No apps are napping right now.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Setter Property="Margin" Value="0,6,0,4"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                            <Condition Binding="{Binding LiveProcesses.Count}" Value="0"/>
                                        </MultiDataTrigger.Conditions>
                                        <MultiDataTrigger.Setters>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger.Setters>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    </StackPanel>
                    </Border>

                    <!-- ── Recent activity ── -->
                    <Border Style="{StaticResource ExpanderBlock}">
                    <StackPanel>

                    <TextBlock Text="Recent activity" Style="{StaticResource BodyText}"
                               FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <ScrollViewer MaxHeight="196"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding RecentEvents}" Margin="0,0,14,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="28">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="112"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}"
                                                   Style="{StaticResource CaptionText}"
                                                   VerticalAlignment="Center"/>

                                        <!-- One Windows icon per kind of event (Core/Converters/ActivityKindConverter.cs) -->
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
                                                    <Setter Property="FontSize" Value="14"/>
                                                    <Setter Property="Text" Value="&#xE946;"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Action, Converter={StaticResource ActivityKind}}" Value="{x:Static conv:ActivityKind.Nap}">
                                                            <Setter Property="Text" Value="&#xE708;"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBlueBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action, Converter={StaticResource ActivityKind}}" Value="{x:Static conv:ActivityKind.Wake}">
                                                            <Setter Property="Text" Value="&#xE706;"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action, Converter={StaticResource ActivityKind}}" Value="{x:Static conv:ActivityKind.Boost}">
                                                            <Setter Property="Text" Value="&#xE945;"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action, Converter={StaticResource ActivityKind}}" Value="{x:Static conv:ActivityKind.Protect}">
                                                            <Setter Property="Text" Value="&#xE8FB;"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentGreenBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action, Converter={StaticResource ActivityKind}}" Value="{x:Static conv:ActivityKind.Enforce}">
                                                            <Setter Property="Text" Value="&#xE72C;"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action, Converter={StaticResource ActivityKind}}" Value="{x:Static conv:ActivityKind.Error}">
                                                            <Setter Property="Text" Value="&#xE783;"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentRedBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Grid.Column="2" Text="{Binding Action}"
                                                   Style="{StaticResource CaptionText}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="3" Text="{Binding ProcessName}"
                                                   Style="{StaticResource CaptionText}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold" MaxWidth="200"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>

                                        <TextBlock Grid.Column="4" Text="{Binding Detail}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                                    <Setter Property="ToolTip" Value="{Binding Detail}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Detail}" Value="">
                                                            <Setter Property="ToolTip" Value="{x:Null}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty state: no events yet -->
                    <TextBlock Text="No activity yet.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecentEvents.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    </StackPanel>
                    </Border>

                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== SLEEP RULES ===== -->
            <Border Style="{StaticResource ExpanderCard}">
                <StackPanel>
                    <Button Command="{Binding ToggleSleepRulesSectionCommand}" Style="{StaticResource ExpanderButton}">
                        <Grid Margin="18,14" MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Sleep rules" Style="{StaticResource ExpanderHeaderTitle}"/>
                                <TextBlock Text="Which apps get put to sleep (minimized, tray, unused, and idle) and how aggressively."
                                           Style="{StaticResource CaptionText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Path Grid.Column="1" Style="{StaticResource ExpanderChevron}" Margin="16,0,0,0"
                                  ctl:Motion.Flipped="{Binding ShowSleepRules}"/>
                        </Grid>
                    </Button>

                    <StackPanel Visibility="{Binding ShowSleepRules, Converter={StaticResource BoolToVis}}"
                                ctl:Motion.RevealOnShow="True">

                        <!-- Sleep minimized apps -->
                        <ctl:SettingsCard Header="Sleep minimized apps" Style="{StaticResource ExpanderItem}"
                                          Description="Apps you minimize are automatically put to sleep. They get periodic brief wakes to stay up to date. Audio, calls, and recordings are always protected.">
                            <CheckBox IsChecked="{Binding MinimizeNapEnabled, Mode=TwoWay}"
                                      Style="{StaticResource ToggleSwitch}"/>
                        </ctl:SettingsCard>

                        <!-- Nap hidden apps -->
                        <ctl:SettingsCard Header="Nap hidden apps" Style="{StaticResource ExpanderItem}"
                                          Description="Also sleeps apps that are open but fully covered by other windows, treating them just like a minimized app. An app has to stay fully covered for 5 minutes before it naps (change this under Wake Timing). They wake the instant they're uncovered or clicked, and the same protections apply: anything playing audio, busy in the background, recently used, or in the foreground is left awake. On by default.">
                            <CheckBox IsChecked="{Binding HiddenNapEnabled, Mode=TwoWay}"
                                      Style="{StaticResource ToggleSwitch}"/>
                        </ctl:SettingsCard>

                        <!-- Sleep system tray apps -->
                        <ctl:SettingsCard Header="Sleep tray apps" Style="{StaticResource ExpanderItem}"
                                          Description="Background apps living in the system tray (cloud sync, game launchers, updaters) are put to sleep with rare brief wakes.">
                            <CheckBox IsChecked="{Binding TrayNapEnabled, Mode=TwoWay}"
                                      Style="{StaticResource ToggleSwitch}"/>
                        </ctl:SettingsCard>

                        <!-- Sleep unused apps (Background Nap) -->
                        <ctl:SettingsCard Header="Sleep unused apps" Style="{StaticResource ExpanderItem}"
                                          Description="Apps you haven't used in a few minutes are put to sleep, even if they're not minimized. It's the most effective mode and catches everything you're not actively using.">
                            <CheckBox IsChecked="{Binding BackgroundNapEnabled, Mode=TwoWay}"
                                      Style="{StaticResource ToggleSwitch}"/>
                        </ctl:SettingsCard>

                        <!-- Sleep idle apps -->
                        <ctl:SettingsCard Header="Sleep idle apps" Style="{StaticResource ExpanderItem}"
                                          Description="Apps using almost no CPU for 2+ minutes are put to sleep. Catches truly idle background processes that waste resources by just existing.">
                            <CheckBox IsChecked="{Binding IdleNapEnabled, Mode=TwoWay}"
                                      Style="{StaticResource ToggleSwitch}"/>
                        </ctl:SettingsCard>

                        <!-- "Include helper processes" was removed: it never controlled whether helpers
                             were slept (the child-nap sweep always runs), only whether their CPU caps
                             tracked the parent through a brief wake, which is now unconditional. -->

                        <!-- Keep busy apps awake (on by default) -->
                        <ctl:SettingsCard Header="Keep busy apps awake" Style="{StaticResource ExpanderItem}"
                                          Description="Don't sleep a minimized or tray app while its whole process tree is using more than 20% CPU, since it's probably still doing work like an export, a render, or a build. The entire app stays awake, and naps normally once it settles down.">
                            <CheckBox IsChecked="{Binding SkipBusyMinimizedApps, Mode=TwoWay}"
                                      Style="{StaticResource ToggleSwitch}"/>
                        </ctl:SettingsCard>

                        <!-- Compress napped app memory: trims the working set from the moment an app naps so Windows compresses its pages. Closest Windows equivalent to macOS App Nap plus Compressed Memory. -->
                        <ctl:SettingsCard Header="Compress napped app memory" Style="{StaticResource ExpanderItem}"
                                          Description="As soon as an app naps, Systema trims its working set so Windows can compress those pages on the standby list, usually shrinking a background app's real memory use by about 2 to 4 times. This starts on a regular nap, not just after an app reaches deep sleep, and Systema keeps re-trimming after every brief wake so the compressed footprint stays small the whole time the app is idle. This is the closest Windows gets to macOS App Nap and Compressed Memory.">
                            <CheckBox IsChecked="{Binding CompressDeepSleep, Mode=TwoWay}"
                                      Style="{StaticResource ToggleSwitch}"/>
                        </ctl:SettingsCard>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== ADVANCED TIMING & CAPS ===== -->
            <Border Style="{StaticResource ExpanderCard}">
                <StackPanel>
                    <Button Command="{Binding ToggleAdvancedSectionCommand}" Style="{StaticResource ExpanderButton}">
                        <Grid Margin="18,14" MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Advanced timing &amp; caps" Style="{StaticResource ExpanderHeaderTitle}"/>
                                <TextBlock Text="Protection guards, the hard CPU cap, and wake-timing controls for power users."
                                           Style="{StaticResource CaptionText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Path Grid.Column="1" Style="{StaticResource ExpanderChevron}" Margin="16,0,0,0"
                                  ctl:Motion.Flipped="{Binding ShowAdvancedSection}"/>
                        </Grid>
                    </Button>

                    <StackPanel Visibility="{Binding ShowAdvancedSection, Converter={StaticResource BoolToVis}}"
                                ctl:Motion.RevealOnShow="True">

                        <!-- ── PROTECTION GUARDS ── -->
                        <Border Style="{StaticResource ExpanderBlock}" Padding="34,14,18,6">
                            <TextBlock Text="PROTECTION" Style="{StaticResource SectionLabel}"/>
                        </Border>

                        <!-- Elevated process guard -->
                        <ctl:SettingsCard Header="Protect elevated processes" Style="{StaticResource ExpanderItem}"
                                          Description="Admin processes like Hyper-V, Docker, WSL2, and elevated tools are automatically protected using Windows integrity levels.">
                            <CheckBox IsChecked="{Binding ElevatedProcessGuardEnabled, Mode=TwoWay}"
                                      Style="{StaticResource ToggleSwitch}"/>
                        </ctl:SettingsCard>

                        <!-- Multi-monitor awareness -->
                        <ctl:SettingsCard Header="Multi-monitor awareness" Style="{StaticResource ExpanderItem}"
                                          Description="Apps visible on any monitor are protected, not just the one you're clicking in.">
                            <CheckBox IsChecked="{Binding MultiMonitorAwarenessEnabled, Mode=TwoWay}"
                                      Style="{StaticResource ToggleSwitch}"/>
                        </ctl:SettingsCard>

                        <!-- Process group awareness -->
                        <ctl:SettingsCard Header="App group awareness" Style="{StaticResource ExpanderItem}"
                                          Description="When you're using an app, all of its processes stay awake (e.g. all Chrome tabs and renderers are protected when any Chrome window is focused).">
                            <CheckBox IsChecked="{Binding ProcessGroupAwarenessEnabled, Mode=TwoWay}"
                                      Style="{StaticResource ToggleSwitch}"/>
                        </ctl:SettingsCard>

                        <!-- Tray deep sleep (a behavioural guard, so it lives with the others) -->
                        <ctl:SettingsCard Header="Tray deep sleep" Style="{StaticResource ExpanderItem}"
                                          Description="After a tray app has been idle for the deep-sleep threshold, stretch its wakes to a longer interval. Protects it from spurious activations while still giving it periodic runtime.">
                            <CheckBox IsChecked="{Binding TrayDeepSleepEnabled, Mode=TwoWay}"
                                      Style="{StaticResource ToggleSwitch}"/>
                        </ctl:SettingsCard>

                        <!-- Pause brief wakes during Game Mode -->
                        <ctl:SettingsCard Header="Pause brief wakes while gaming" Style="{StaticResource ExpanderItem}"
                                          Description="When Game Booster is active, napped apps stay fully asleep with no periodic wakes, so 100% of the CPU goes to your game. Turn it off if you need background apps like Discord bots or streaming tools to keep running while gaming.">
                            <CheckBox IsChecked="{Binding SuppressBriefWakesDuringGameMode, Mode=TwoWay}"
                                      Style="{StaticResource ToggleSwitch}"/>
                        </ctl:SettingsCard>

                        <!-- CPU cap and wake timing: the number pickers, unchanged -->
                        <Border Style="{StaticResource ExpanderBlock}" Padding="34,16,18,8">
                        <StackPanel>

                    <!-- ── CPU CAP ── -->
                    <TextBlock Text="CPU CAP" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Hard CPU limit for sleeping apps"
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Enforced by Windows at the kernel level, per process. Apps made of several processes (browsers, Spotify) add up, so their total in Task Manager can read higher than the cap."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding NappedCpuCapEnabled, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Top"/>
                    </Grid>

                    <!-- CPU cap sub-rows: all share 70px textbox + 50px unit column so they line up. -->
                    <StackPanel Visibility="{Binding NappedCpuCapEnabled, Converter={StaticResource BoolToVis}}">
                        <Grid Margin="16,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Max CPU per process while sleeping"
                                       Style="{StaticResource BodyText}"
                                       VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                      Style="{StaticResource DarkComboBox}"
                                      ItemsSource="{Binding CpuCapWhileSleepingOptions}"
                                      SelectedItem="{Binding NappedCpuCapPercent, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"/>
                            <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center"
                                       Margin="8,0,0,0" Style="{StaticResource BodyText}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Grid>

                        <Grid Margin="16,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="Max CPU per process during brief wakes"
                                           Style="{StaticResource BodyText}"/>
                                <TextBlock Text="The cap stays on while a sleeping app briefly wakes. It applies per process, so an app with many processes can total higher for a moment. Higher is more responsive, lower is less CPU use."
                                           Style="{StaticResource CaptionText}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      Style="{StaticResource DarkComboBox}"
                                      ItemsSource="{Binding CpuCapBriefWakeOptions}"
                                      SelectedItem="{Binding BriefWakeCpuCapPercent, Mode=TwoWay}"
                                      VerticalAlignment="Top"
                                      HorizontalAlignment="Stretch"/>
                            <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Top"
                                       Margin="8,8,0,0" Style="{StaticResource BodyText}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Grid>
                    </StackPanel>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="Max simultaneous brief wakes"
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Limits how many sleeping apps can wake up at the same time to prevent CPU spikes."
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  Style="{StaticResource DarkComboBox}"
                                  ItemsSource="{Binding MaxConcurrentBriefWakeOptions}"
                                  SelectedItem="{Binding MaxConcurrentBriefWakes, Mode=TwoWay}"
                                  VerticalAlignment="Top"
                                  HorizontalAlignment="Stretch"/>
                        <TextBlock Grid.Column="2" Text="apps" VerticalAlignment="Top"
                                   Margin="8,8,0,0" Style="{StaticResource BodyText}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,16"/>

                    <!-- ── WAKE TIMING ── -->
                    <!-- Column layout: label fills, fixed 70px textbox, fixed 36px unit. -->
                    <!-- Every row aligns on the right regardless of unit text width.     -->
                    <!-- "Deep sleep after" sets the threshold for BOTH minimized and tray -->
                    <!-- deep sleep — one setting, one row. "Deep wake every" shows only   -->
                    <!-- when Tray Deep Sleep (in Protection) is enabled.                   -->
                    <TextBlock Text="WAKE TIMING" Style="{StaticResource SectionLabel}" Margin="0,0,0,12"/>

                    <TextBlock Text="Regular naps"
                               Style="{StaticResource HeadingSmall}"
                               Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Brief wake every" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  Style="{StaticResource DarkComboBox}"
                                  ItemsSource="{Binding MinimizedBriefWakeIntervalOptions}"
                                  SelectedItem="{Binding MinimizedBriefWakeIntervalSeconds, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"/>
                        <TextBlock Grid.Column="2" Text="sec" VerticalAlignment="Center"
                                   Margin="8,0,0,0" Style="{StaticResource BodyText}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Wake lasts for" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  Style="{StaticResource DarkComboBox}"
                                  ItemsSource="{Binding BriefWakeDurationOptions}"
                                  SelectedItem="{Binding MinimizedBriefWakeDurationSeconds, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"/>
                        <TextBlock Grid.Column="2" Text="sec" VerticalAlignment="Center"
                                   Margin="8,0,0,0" Style="{StaticResource BodyText}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>

                    <!-- Hidden apps — shown only when "Nap hidden apps" is on. Sets how long a window -->
                    <!-- must stay fully covered before it becomes eligible to nap.                     -->
                    <StackPanel Visibility="{Binding HiddenNapEnabled, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Hidden apps"
                                   Style="{StaticResource HeadingSmall}"
                                   Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Nap after being hidden for" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                      Style="{StaticResource DarkComboBox}"
                                      ItemsSource="{Binding HiddenNapDelayOptions}"
                                      SelectedItem="{Binding HiddenNapDelayMinutes, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"/>
                            <TextBlock Grid.Column="2" Text="min" VerticalAlignment="Center"
                                       Margin="8,0,0,0" Style="{StaticResource BodyText}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Grid>
                    </StackPanel>

                    <TextBlock Text="Tray apps"
                               Style="{StaticResource HeadingSmall}"
                               Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Brief wake every" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  Style="{StaticResource DarkComboBox}"
                                  ItemsSource="{Binding TrayBriefWakeIntervalOptions}"
                                  SelectedItem="{Binding TrayBriefWakeIntervalMinutes, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"/>
                        <TextBlock Grid.Column="2" Text="min" VerticalAlignment="Center"
                                   Margin="8,0,0,0" Style="{StaticResource BodyText}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Wake lasts for" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  Style="{StaticResource DarkComboBox}"
                                  ItemsSource="{Binding BriefWakeDurationOptions}"
                                  SelectedItem="{Binding TrayBriefWakeDurationSeconds, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"/>
                        <TextBlock Grid.Column="2" Text="sec" VerticalAlignment="Center"
                                   Margin="8,0,0,0" Style="{StaticResource BodyText}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>

                    <!-- Deep sleep — shared threshold for minimized + tray apps. -->
                    <TextBlock Text="Deep sleep"
                               Style="{StaticResource HeadingSmall}"
                               Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Deep sleep after" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  Style="{StaticResource DarkComboBox}"
                                  ItemsSource="{Binding DeepSleepAfterOptions}"
                                  SelectedItem="{Binding MinimizeDeepSleepThresholdMinutes, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"/>
                        <TextBlock Grid.Column="2" Text="min" VerticalAlignment="Center"
                                   Margin="8,0,0,0" Style="{StaticResource BodyText}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10"
                          Visibility="{Binding TrayDeepSleepEnabled, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tray deep wake every" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  Style="{StaticResource DarkComboBox}"
                                  ItemsSource="{Binding TrayDeepWakeOptions}"
                                  SelectedItem="{Binding TrayDeepSleepWakeIntervalMinutes, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"/>
                        <TextBlock Grid.Column="2" Text="min" VerticalAlignment="Center"
                                   Margin="8,0,0,0" Style="{StaticResource BodyText}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>

                        </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== NEVER-NAP LIST ===== -->
            <Border Style="{StaticResource ExpanderCard}">
                <StackPanel>
                    <Button Command="{Binding ToggleNeverNapSectionCommand}" Style="{StaticResource ExpanderButton}">
                        <Grid Margin="18,14" MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Never-nap list" Style="{StaticResource ExpanderHeaderTitle}"/>
                                <TextBlock Text="Apps that are never put to sleep, no matter what."
                                           Style="{StaticResource CaptionText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Path Grid.Column="1" Style="{StaticResource ExpanderChevron}" Margin="16,0,0,0"
                                  ctl:Motion.Flipped="{Binding ShowNeverNap}"/>
                        </Grid>
                    </Button>

                    <Border Style="{StaticResource ExpanderBlock}" Padding="34,14,18,16"
                            Visibility="{Binding ShowNeverNap, Converter={StaticResource BoolToVis}}"
                            ctl:Motion.RevealOnShow="True">
                    <StackPanel>
                    <TextBlock Text="Apps on this list will never be put to sleep. You can also add apps directly from the live monitor using the ··· button next to any napping process."
                               Style="{StaticResource CaptionText}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <!-- Whitelist items -->
                    <ItemsControl ItemsSource="{Binding Whitelist}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource SuccessAlpha05Brush}" CornerRadius="4"
                                                    Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="PROTECTED" FontSize="9" FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentGreenBrush}"/>
                                            </Border>
                                            <TextBlock Text="{Binding}"
                                                       Style="{StaticResource BodyText}"
                                                       FontFamily="Cascadia Mono, Consolas, Courier New"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="Remove"
                                                FontSize="11"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                Padding="8,4"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.RemoveFromWhitelistCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty state -->
                    <TextBlock Text="No apps whitelisted yet.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Whitelist.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Add to whitelist form -->
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,12,0,12"/>
                    <WrapPanel>
                        <TextBox Width="180"
                                 Text="{Binding WhitelistNewApp, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}"
                                 Height="32"
                                 Margin="0,0,8,0"/>

                        <ComboBox Width="180"
                                  Height="32"
                                  ItemsSource="{Binding RunningProcessNames}"
                                  SelectedItem="{Binding SelectedRunningProcess, Mode=OneWayToSource}"
                                  Margin="0,0,8,0"/>

                        <Button Content="↻"
                                Width="32" Height="32"
                                FontSize="14"
                                ToolTip="Refresh running processes list"
                                Command="{Binding RefreshRunningCommand}"
                                Style="{StaticResource GhostButton}"
                                Margin="0,0,8,0"/>

                        <Button Content="Add to whitelist"
                                Height="32"
                                Padding="14,0"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding AddToWhitelistCommand}"/>
                    </WrapPanel>
                    <TextBlock Text="Type a process name (without .exe) or pick from the running list, then click Add."
                               Style="{StaticResource CaptionText}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,6,0,0"/>
                    </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
