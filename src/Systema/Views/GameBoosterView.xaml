<UserControl x:Class="Systema.Views.GameBoosterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Systema.Core.Converters"
             xmlns:core="clr-namespace:Systema.Core"
             Background="Transparent">

    <!-- ════════════════════════════════════════════════════════════════════════
         Deliberately flat. Three things, top to bottom, nothing hidden:
           1. the master switch that turns the whole feature off
           2. manual boost
           3. a plain list where each line says what actually happens to you
         No Save buttons: every toggle persists the moment it changes, like the
         rest of the app. The old tab had TWO Save buttons, which is why settings
         could be flipped and then silently lost.
         ════════════════════════════════════════════════════════════════════════ -->

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <!-- One option row: title, plain-English description, switch. -->
        <Style x:Key="OptRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!-- No MaxWidth: every other tab lets its cards fill the pane, and capping
             this one left a dead strip down the right-hand side. -->
        <StackPanel Margin="32,28,32,28">

            <TextBlock Text="Game Booster" Style="{StaticResource HeadingLarge}"/>
            <TextBlock Text="Makes your PC give the game everything it has, then puts it all back when you quit."
                       Style="{StaticResource CaptionText}" Margin="0,4,0,18" TextWrapping="Wrap"/>

            <!-- ═══════════ MASTER + MANUAL ═══════════ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="Boost games automatically" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Systema notices a game within seconds of it opening and boosts on its own. Turn this off and Game Booster does nothing at all unless you press Boost right now."
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                  IsChecked="{Binding GameBoosterEnabled, Mode=TwoWay}"
                                  ToolTipService.ShowOnDisabled="True">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox" BasedOn="{StaticResource ToggleSwitch}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAutoPilotActive}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="Opacity"   Value="0.4"/>
                                            <Setter Property="ToolTip"   Value="Controlled by Auto-Pilot — turn off Auto-Pilot Mode to change"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,15"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="Boost right now" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Turns everything on straight away, even without a game. Handy for streaming or heavy work. Stops on its own after 6 hours."
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding ManualBoostTimeRemaining}" Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource AccentBlueBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <!-- A switch, not a button: ManualBoostEnabled's change handler is the ONLY
                             thing that starts/stops a manual boost, so a separate command here would
                             be dead UI (that exact bug is documented in GameBoosterViewModel). -->
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                  IsChecked="{Binding ManualBoostEnabled, Mode=TwoWay}"/>
                    </Grid>

                    <!-- Live state, only while something is actually boosting. -->
                    <Border Visibility="{Binding BoostActive, Converter={StaticResource BoolToVis}}"
                            CornerRadius="10" Padding="14,12" Margin="0,16,0,0"
                            Background="#16232A" BorderBrush="#2C4C57" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,9,0"
                                     Fill="{StaticResource AccentGreenBrush}"/>
                            <StackPanel>
                                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold">
                                    <Run Text="Boosting "/><Run Text="{Binding ActiveGameName, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding SessionElapsedText, Mode=OneWay}"
                                           Style="{StaticResource CaptionText}" Margin="0,1,0,0"/>
                            </StackPanel>
                            <Button Content="Stop" Style="{StaticResource GhostButton}" Padding="16,5"
                                    Margin="18,0,0,0" VerticalAlignment="Center"
                                    Command="{Binding StopBoostCommand}"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>

            <!-- ═══════════ WHAT BOOSTING DOES ═══════════ -->
            <TextBlock Text="What boosting does" Style="{StaticResource HeadingMedium}" Margin="2,26,0,3"/>
            <TextBlock Text="Turn any of these off if you'd rather it left that alone. Changes save straight away. The game itself is always given top priority, that part isn't optional."
                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="2,0,0,12"/>

            <Border Style="{StaticResource Card}">
                <StackPanel>

                    <Grid Style="{StaticResource OptRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="Use the High performance power plan" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Stops Windows slowing your CPU down to save power while you play. Switches back when the game closes."
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                  IsChecked="{Binding HighPerfPowerPlan, Mode=TwoWay}"/>
                    </Grid>

                    <Grid Style="{StaticResource OptRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="Keep the PC awake" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Stops the screen sleeping or locking during long cutscenes, lobbies and loading screens."
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                  IsChecked="{Binding PreventSleepOnBoost, Mode=TwoWay}"/>
                    </Grid>

                    <Grid Style="{StaticResource OptRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="Pause search indexing" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Windows scans your files in the background and it uses the disk. This pauses it while you play and starts it again after."
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                  IsChecked="{Binding PauseIndexing, Mode=TwoWay}"/>
                    </Grid>

                    <Grid Style="{StaticResource OptRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="Free up memory before the game loads" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Trims memory that background apps are holding but not using, so the game has more to work with."
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                  IsChecked="{Binding FreeMemoryOnBoost, Mode=TwoWay}"/>
                    </Grid>

                    <!-- Battery pause: laptops only, and only where the vendor exposes it. -->
                    <Grid Style="{StaticResource OptRow}"
                          Visibility="{Binding IsBatteryPresent, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="Pause battery charging" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Runs straight off the charger instead of charging at the same time, so the laptop stays cooler and doesn't throttle. Charging resumes the moment you stop playing."
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding BatteryPauseStatus}" Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource AccentYellowBrush}" TextWrapping="Wrap"
                                       FontStyle="Italic" Margin="0,4,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                  IsChecked="{Binding PauseChargingOnBoost, Mode=TwoWay}"
                                  IsEnabled="{Binding BatteryPauseAvailable}"
                                  ToolTip="Needs a laptop whose vendor tool exposes charge control."/>
                    </Grid>

                    <Grid Style="{StaticResource OptRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="Silence notifications" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Turns on Do Not Disturb so nothing pops up mid-game. You won't see messages until you quit."
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                  IsChecked="{Binding SuppressNotifications, Mode=TwoWay}"/>
                    </Grid>

                    <Grid Style="{StaticResource OptRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="Turn off Bluetooth" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Saves a little power, but it disconnects Bluetooth controllers and headsets. Leave this off if you play with a pad."
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                  IsChecked="{Binding DisableBluetoothOnBoost, Mode=TwoWay}"/>
                    </Grid>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="Turn off Wi-Fi when you're on a cable" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Only does anything when an Ethernet cable is plugged in, so it can't knock you offline."
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                  IsChecked="{Binding DisableWifiOnEthernet, Mode=TwoWay}"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="Disable Nagle's algorithm" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Sends small packets immediately instead of waiting to batch them, which can shave a little latency. It helps on some connections and hurts on others, so try it both ways. Applies to new connections."
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                  IsChecked="{Binding DisableNagleOnBoost, Mode=TwoWay}"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- ═══════════ ADVANCED ═══════════
                 Collapsed by default. Kept so the fallback sweep and the game list stay
                 reachable rather than becoming settings with no way to change them. -->
            <Button Command="{Binding ToggleDetectionCommand}" Style="{StaticResource ExpanderButton}"
                    HorizontalContentAlignment="Stretch" Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal" Margin="2,6,2,6">
                    <TextBlock FontSize="12.5" Foreground="{StaticResource AccentBlueBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Advanced"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowDetection}" Value="True">
                                        <Setter Property="Text" Value="Hide advanced"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock FontSize="10" Margin="7,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#x25BC;"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowDetection}" Value="True">
                                        <Setter Property="Text" Value="&#x25B2;"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Button>

            <Border Style="{StaticResource Card}" Margin="0,4,0,0"
                    Visibility="{Binding ShowDetection, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Fallback sweep" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                    <TextBlock Text="Systema spots a game within seconds of it opening. This slower sweep only exists as a backstop for games that never take focus, so there is rarely a reason to change it."
                               Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,3,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="70" Style="{StaticResource DarkTextBox}"
                                 Text="{Binding CheckIntervalMinutes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="minutes" Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,14"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Scan for games now" Style="{StaticResource GhostButton}"
                                Command="{Binding ScanNowCommand}"/>
                        <TextBlock VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                    <Setter Property="Text" Value="No games found yet"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GamesInstalled}" Value="True">
                                            <Setter Property="Text"       Value="Games found"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}"
                       TextWrapping="Wrap" Margin="2,16,0,0"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
