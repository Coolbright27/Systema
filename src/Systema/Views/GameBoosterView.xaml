<UserControl x:Class="Systema.Views.GameBoosterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Systema.Core.Converters"
             xmlns:core="clr-namespace:Systema.Core"
             Background="Transparent">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,28">

            <!-- Header -->
            <TextBlock Text="Game Booster" Style="{StaticResource HeadingLarge}"/>
            <TextBlock Text="Auto-detects games and boosts priority, GPU, and power while you play."
                       Style="{StaticResource CaptionText}" Margin="0,4,0,16"/>

            <!-- ════════════════ STATUS HERO ════════════════ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <Ellipse Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BoostActive}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center">
                                <!-- Idle / Boosting headline -->
                                <TextBlock Style="{StaticResource HeadingMedium}" Text="Game Boost idle"
                                           Visibility="{Binding BoostActive, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                                <TextBlock Visibility="{Binding BoostActive, Converter={StaticResource BoolToVis}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource HeadingMedium}">
                                            <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="Boosting — "/><Run Text="{Binding ActiveGameName, Mode=OneWay}"/>
                                </TextBlock>
                                <!-- Sub-line: games detected · check interval -->
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                                <Setter Property="Text" Value="No games detected"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GamesInstalled}" Value="True">
                                                        <Setter Property="Text"       Value="Games detected"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource CaptionText}" Text="  ·  checks every "/>
                                    <TextBlock Style="{StaticResource CaptionText}" Text="{Binding CheckIntervalMinutes, Mode=OneWay}"/>
                                    <TextBlock Style="{StaticResource CaptionText}" Text=" min"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Master auto-detect toggle -->
                        <CheckBox Grid.Column="1" IsChecked="{Binding GameBoosterEnabled, Mode=TwoWay}"
                                  VerticalAlignment="Center" ToolTipService.ShowOnDisabled="True">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox" BasedOn="{StaticResource ToggleSwitch}">
                                    <Setter Property="ToolTip" Value="Master switch — turn off to disable all game detection and boosting"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAutoPilotActive}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="Opacity"   Value="0.4"/>
                                            <Setter Property="ToolTip"   Value="Controlled by Auto-Pilot — turn off Auto-Pilot Mode to change"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>
                    </Grid>

                    <!-- Actions -->
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Scan now" Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left" Command="{Binding ScanNowCommand}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Margin="0,0,10,0" HorizontalAlignment="Right">
                                    <TextBlock Text="Manual boost" Style="{StaticResource BodyText}" FontWeight="SemiBold"
                                               HorizontalAlignment="Right"/>
                                    <TextBlock HorizontalAlignment="Right">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                                <Setter Property="Text" Value="Force on · auto-off after 6 h"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ManualBoostEnabled}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource CaptionText}" HorizontalAlignment="Right"
                                               Foreground="{StaticResource AccentBlueBrush}"
                                               Visibility="{Binding ManualBoostEnabled, Converter={StaticResource BoolToVis}}">
                                        <Run Text="Auto-off in: "/><Run Text="{Binding ManualBoostTimeRemaining, Mode=OneWay}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                          IsChecked="{Binding ManualBoostEnabled, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ════════════════ BOOST OPTIONS (accordion) ════════════════ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <Button Command="{Binding ToggleBoostOptionsCommand}" Style="{StaticResource ExpanderButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Boost options" Style="{StaticResource HeadingMedium}"/>
                                <TextBlock Text="What gets applied while a game runs — memory, power, GPU, sleep, and battery."
                                           Style="{StaticResource CaptionText}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#x25BC;"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowBoostOptions}" Value="True">
                                                <Setter Property="Text" Value="&#x25B2;"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Button>

                    <StackPanel Visibility="{Binding ShowBoostOptions, Converter={StaticResource BoolToVis}}" Margin="0,16,0,0">

                        <!-- PERFORMANCE -->
                        <TextBlock Text="PERFORMANCE" Style="{StaticResource SectionLabel}" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                                <TextBlock Text="Free memory on game start" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                                <TextBlock Text="Releases idle background memory at game launch so more RAM is available immediately."
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding FreeMemoryOnBoost, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                                <TextBlock Text="High Performance power plan" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                                <TextBlock Text="Switches to High Performance for maximum CPU throughput while gaming. Restored on exit."
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                <TextBlock Visibility="{Binding IsHighPerfConflictActive, Converter={StaticResource BoolToVis}}"
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Foreground="{StaticResource AccentYellowBrush}">
                                    Battery Optimization is also active (Visual &amp; Power tab). During gaming the
                                    High Performance plan will override it, which may cause unexpected power or thermal
                                    behaviour. Consider disabling one of the two settings.
                                </TextBlock>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding HighPerfPowerPlan, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                                <TextBlock Text="GPU &amp; multimedia system profile" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                                <TextBlock Text="Raises the MMCSS Games profile priority for faster CPU scheduling. VSync-safe. Restored on exit."
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding GpuProfileOnBoost, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- SYSTEM -->
                        <TextBlock Text="SYSTEM" Style="{StaticResource SectionLabel}" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                                <TextBlock Text="Prevent sleep while gaming" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                                <TextBlock Text="Stops the PC from sleeping or locking during a game session or manual boost. Restored the instant the game exits."
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding PreventSleepOnBoost, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,16"
                              Visibility="{Binding IsBatteryPresent, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                                <TextBlock Text="Battery pause (laptops)" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                                <TextBlock Text="Pauses battery charging while gaming so the AC adapter feeds CPU and GPU directly. Reduces heat and power-budget throttling. Resumes when boost ends."
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding BatteryPauseStatus}" Style="{StaticResource CaptionText}"
                                           Foreground="{StaticResource AccentBlueBrush}" TextWrapping="Wrap"
                                           FontStyle="Italic" Margin="0,4,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding PauseChargingOnBoost, Mode=TwoWay}"
                                      IsEnabled="{Binding BatteryPauseAvailable}" VerticalAlignment="Center"
                                      ToolTip="Disabled on desktops and unsupported laptop brands."/>
                        </Grid>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>
                        <Button Content="Save boost options" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left" Command="{Binding SaveSettingsCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ════════════════ DETECTION & ADVANCED (accordion) ════════════════ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <Button Command="{Binding ToggleDetectionCommand}" Style="{StaticResource ExpanderButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Detection &amp; advanced" Style="{StaticResource HeadingMedium}"/>
                                <TextBlock Text="Check frequency, Xbox services, and what Systema recognizes."
                                           Style="{StaticResource CaptionText}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#x25BC;"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowDetection}" Value="True">
                                                <Setter Property="Text" Value="&#x25B2;"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Button>

                    <StackPanel Visibility="{Binding ShowDetection, Converter={StaticResource BoolToVis}}" Margin="0,16,0,0">

                        <!-- Game detection frequency -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                                <TextBlock Text="Game detection frequency" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                                <TextBlock Text="How often Systema checks for running game processes. Lower = faster detection, more CPU."
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox Text="{Binding CheckIntervalMinutes, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DarkTextBox}" Width="60" Margin="0,0,8,0"
                                         core:NumericTextBox.IsNumericOnly="True"/>
                                <TextBlock Text="minutes" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Lock Xbox services -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                                <TextBlock Text="Lock Xbox services" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0">
                                    When on, Systema will never automatically disable Xbox services
                                    (even when no games are detected).
                                </TextBlock>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding XboxOverride, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- What Systema detects -->
                        <TextBlock Text="What Systema detects" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <WrapPanel Margin="0,0,0,16">
                            <Border Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="10,6" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="Games" Style="{StaticResource CaptionText}" FontWeight="Bold"
                                               Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Roblox, Fortnite, Minecraft" Style="{StaticResource CaptionText}"/>
                                    <TextBlock Text="CS2, GTA V, Valorant, LoL" Style="{StaticResource CaptionText}"/>
                                    <TextBlock Text="Elden Ring, Cyberpunk, more" Style="{StaticResource CaptionText}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="10,6" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="Anti-cheats" Style="{StaticResource CaptionText}" FontWeight="Bold"
                                               Foreground="{StaticResource AccentYellowBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Vanguard (vgc)" Style="{StaticResource CaptionText}"/>
                                    <TextBlock Text="Easy Anti-Cheat" Style="{StaticResource CaptionText}"/>
                                    <TextBlock Text="BattlEye (BEService)" Style="{StaticResource CaptionText}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="10,6" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="Launchers &amp; platforms" Style="{StaticResource CaptionText}" FontWeight="Bold"
                                               Foreground="{StaticResource AccentGreenBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Steam, Epic Games" Style="{StaticResource CaptionText}"/>
                                    <TextBlock Text="Battle.net, Xbox App" Style="{StaticResource CaptionText}"/>
                                    <TextBlock Text="Riot Client" Style="{StaticResource CaptionText}"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>
                        <Button Content="Save settings" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left" Command="{Binding SaveSettingsCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Status bar -->
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" Margin="2,8,0,0"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
