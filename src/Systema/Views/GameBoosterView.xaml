<UserControl x:Class="Systema.Views.GameBoosterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Systema.Core.Converters"
             xmlns:core="clr-namespace:Systema.Core"
             xmlns:ctl="clr-namespace:Systema.Controls"
             Background="Transparent">

    <!-- ════════════════════════════════════════════════════════════════════════
         Deliberately flat. Three things, top to bottom, nothing hidden:
           1. the master switch that turns the whole feature off
           2. manual boost
           3. a plain list where each line says what actually happens to you
         No Save buttons: every toggle persists the moment it changes, like the
         rest of the app. The old tab had TWO Save buttons, which is why settings
         could be flipped and then silently lost.

         Windows 11 Settings layout: one SettingsCard per option, grouped under
         headers. Same bindings and text as before; only the layout changed.
         ════════════════════════════════════════════════════════════════════════ -->

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!-- No MaxWidth: every other tab lets its cards fill the pane, and capping
             this one left a dead strip down the right-hand side. -->
        <StackPanel Margin="32,24,32,28">

            <!-- ===== HEADER ===== -->
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="Game Booster" Style="{StaticResource HeadingLarge}"/>
                <TextBlock Text="Makes your PC give the game everything it has, then puts it all back when you quit."
                           Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- ═══════════ MASTER + MANUAL ═══════════ -->
            <ctl:SettingsCard Header="Boost games automatically" Margin="0,16,0,4" RecommendKey="GameBoost">
                <ctl:SettingsCard.Description>
                    <TextBlock Style="{StaticResource CardDescription}"
                               Text="Systema notices a game within seconds of it opening and boosts on its own. Turn this off and Game Booster does nothing at all unless you press Boost right now."/>
                </ctl:SettingsCard.Description>
                <CheckBox IsChecked="{Binding GameBoosterEnabled, Mode=TwoWay}"
                          ToolTipService.ShowOnDisabled="True">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox" BasedOn="{StaticResource ToggleSwitch}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAutoPilotActive}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Setter Property="Opacity"   Value="0.4"/>
                                    <Setter Property="ToolTip"   Value="Managed by Auto Pilot. Turn off Auto Pilot Mode to change it."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>
            </ctl:SettingsCard>

            <ctl:SettingsCard Header="Boost right now">
                <ctl:SettingsCard.Description>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardDescription}"
                                   Text="Turns everything on straight away, even without a game. Handy for streaming or heavy work. Stops on its own after 6 hours."/>
                        <TextBlock Text="{Binding ManualBoostTimeRemaining}" Style="{StaticResource CardNote}"
                                   Foreground="{DynamicResource AccentBlueBrush}"/>
                    </StackPanel>
                </ctl:SettingsCard.Description>
                <!-- A switch, not a button: ManualBoostEnabled's change handler is the ONLY
                     thing that starts/stops a manual boost, so a separate command here would
                     be dead UI (that exact bug is documented in GameBoosterViewModel). -->
                <CheckBox Style="{StaticResource ToggleSwitch}"
                          IsChecked="{Binding ManualBoostEnabled, Mode=TwoWay}"/>
            </ctl:SettingsCard>

            <!-- Live state, only while something is actually boosting. -->
            <Border Visibility="{Binding BoostActive, Converter={StaticResource BoolToVis}}"
                    CornerRadius="6" Padding="18,12" Margin="0,0,0,4"
                    Background="{DynamicResource InfoBannerBrush}" BorderBrush="{DynamicResource InfoBannerStrokeBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,11,0"
                             Fill="{DynamicResource AccentGreenBrush}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold">
                            <Run Text="Boosting "/><Run Text="{Binding ActiveGameName, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding SessionElapsedText, Mode=OneWay}"
                                   Style="{StaticResource CaptionText}" Margin="0,1,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="Stop" Style="{StaticResource GhostButton}" Padding="16,5"
                            Margin="18,0,0,0" VerticalAlignment="Center"
                            Command="{Binding StopBoostCommand}"/>
                </Grid>
            </Border>

            <!-- ═══════════ WHAT BOOSTING DOES ═══════════ -->
            <TextBlock Text="What boosting does" Style="{StaticResource HeadingMedium}" Margin="2,28,0,3"/>
            <TextBlock Text="Turn any of these off if you'd rather it left that alone. Changes save straight away. The game itself is always given top priority, that part isn't optional."
                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="2,0,0,12" MaxWidth="760"
                       HorizontalAlignment="Left"/>

            <TextBlock Text="Performance" Style="{StaticResource SettingsGroupHeader}" Margin="2,4,0,8"/>

            <ctl:SettingsCard Header="Use the High performance power plan" RecommendKey="BoostHighPerfPlan">
                <ctl:SettingsCard.Description>
                    <TextBlock Style="{StaticResource CardDescription}"
                               Text="Stops Windows slowing your CPU down to save power while you play. Switches back when the game closes."/>
                </ctl:SettingsCard.Description>
                <CheckBox Style="{StaticResource ToggleSwitch}"
                          IsChecked="{Binding HighPerfPowerPlan, Mode=TwoWay}"/>
            </ctl:SettingsCard>

            <ctl:SettingsCard Header="Keep the PC awake">
                <ctl:SettingsCard.Description>
                    <TextBlock Style="{StaticResource CardDescription}"
                               Text="Stops the screen sleeping or locking during long cutscenes, lobbies and loading screens."/>
                </ctl:SettingsCard.Description>
                <CheckBox Style="{StaticResource ToggleSwitch}"
                          IsChecked="{Binding PreventSleepOnBoost, Mode=TwoWay}"/>
            </ctl:SettingsCard>

            <ctl:SettingsCard Header="Pause search indexing">
                <ctl:SettingsCard.Description>
                    <TextBlock Style="{StaticResource CardDescription}"
                               Text="Windows scans your files in the background and it uses the disk. This slows it right down while you play so it stops competing for the drive, then puts it back to normal after."/>
                </ctl:SettingsCard.Description>
                <CheckBox Style="{StaticResource ToggleSwitch}"
                          IsChecked="{Binding PauseIndexing, Mode=TwoWay}"/>
            </ctl:SettingsCard>

            <ctl:SettingsCard Header="Free up memory before the game loads">
                <ctl:SettingsCard.Description>
                    <TextBlock Style="{StaticResource CardDescription}"
                               Text="Trims memory that background apps are holding but not using, so the game has more to work with."/>
                </ctl:SettingsCard.Description>
                <CheckBox Style="{StaticResource ToggleSwitch}"
                          IsChecked="{Binding FreeMemoryOnBoost, Mode=TwoWay}"/>
            </ctl:SettingsCard>

            <!-- Battery pause: laptops only, and only where the vendor exposes it. -->
            <ctl:SettingsCard Header="Pause battery charging"
                              Visibility="{Binding IsBatteryPresent, Converter={StaticResource BoolToVis}}">
                <ctl:SettingsCard.Description>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardDescription}"
                                   Text="Runs straight off the charger instead of charging at the same time, so the laptop stays cooler and doesn't throttle. Charging resumes the moment you stop playing."/>
                        <TextBlock Text="{Binding BatteryPauseStatus}" Style="{StaticResource CardNoteWarn}"
                                   FontStyle="Italic"/>
                    </StackPanel>
                </ctl:SettingsCard.Description>
                <CheckBox Style="{StaticResource ToggleSwitch}"
                          IsChecked="{Binding PauseChargingOnBoost, Mode=TwoWay}"
                          IsEnabled="{Binding BatteryPauseAvailable}"
                          ToolTipService.ShowOnDisabled="True"
                          ToolTip="Needs a laptop whose vendor tool exposes charge control."/>
            </ctl:SettingsCard>

            <TextBlock Text="Notifications and network" Style="{StaticResource SettingsGroupHeader}"/>

            <ctl:SettingsCard Header="Silence notifications">
                <ctl:SettingsCard.Description>
                    <TextBlock Style="{StaticResource CardDescription}"
                               Text="Turns on Do Not Disturb so nothing pops up mid-game. You won't see messages until you quit."/>
                </ctl:SettingsCard.Description>
                <CheckBox Style="{StaticResource ToggleSwitch}"
                          IsChecked="{Binding SuppressNotifications, Mode=TwoWay}"/>
            </ctl:SettingsCard>

            <ctl:SettingsCard Header="Turn off Bluetooth">
                <ctl:SettingsCard.Description>
                    <TextBlock Style="{StaticResource CardDescription}"
                               Text="Saves a little power, but it disconnects Bluetooth controllers and headsets. Leave this off if you play with a pad."/>
                </ctl:SettingsCard.Description>
                <CheckBox Style="{StaticResource ToggleSwitch}"
                          IsChecked="{Binding DisableBluetoothOnBoost, Mode=TwoWay}"/>
            </ctl:SettingsCard>

            <ctl:SettingsCard Header="Turn off Wi-Fi when you're on a cable">
                <ctl:SettingsCard.Description>
                    <TextBlock Style="{StaticResource CardDescription}"
                               Text="Only does anything when an Ethernet cable is plugged in, so it can't knock you offline."/>
                </ctl:SettingsCard.Description>
                <CheckBox Style="{StaticResource ToggleSwitch}"
                          IsChecked="{Binding DisableWifiOnEthernet, Mode=TwoWay}"/>
            </ctl:SettingsCard>

            <ctl:SettingsCard Header="Disable Nagle's algorithm">
                <ctl:SettingsCard.Description>
                    <TextBlock Style="{StaticResource CardDescription}"
                               Text="Sends small packets immediately instead of waiting to batch them, which can shave a little latency. It helps on some connections and hurts on others, so try it both ways. Applies to new connections."/>
                </ctl:SettingsCard.Description>
                <CheckBox Style="{StaticResource ToggleSwitch}"
                          IsChecked="{Binding DisableNagleOnBoost, Mode=TwoWay}"/>
            </ctl:SettingsCard>

            <!-- ═══════════ ADVANCED ═══════════
                 Collapsed by default. Kept so the fallback sweep and the game list stay
                 reachable rather than becoming settings with no way to change them. -->
            <Button Command="{Binding ToggleDetectionCommand}" Style="{StaticResource ExpanderButton}"
                    HorizontalContentAlignment="Stretch" Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal" Margin="2,6,2,6">
                    <TextBlock FontSize="12.5" Foreground="{DynamicResource AccentBlueBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Advanced"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowDetection}" Value="True">
                                        <Setter Property="Text" Value="Hide advanced"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Path Style="{StaticResource ExpanderChevron}" Margin="9,1,0,0"
                          ctl:Motion.Flipped="{Binding ShowDetection}"/>
                </StackPanel>
            </Button>

            <StackPanel Margin="0,4,0,0" ctl:Motion.RevealOnShow="True"
                        Visibility="{Binding ShowDetection, Converter={StaticResource BoolToVis}}">

                <ctl:SettingsCard Header="Fallback sweep">
                    <ctl:SettingsCard.Description>
                        <TextBlock Style="{StaticResource CardDescription}"
                                   Text="Systema spots a game within seconds of it opening. This slower sweep only exists as a backstop for games that never take focus, so there is rarely a reason to change it."/>
                    </ctl:SettingsCard.Description>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="70" Style="{StaticResource DarkTextBox}"
                                 Text="{Binding CheckIntervalMinutes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="minutes" Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                </ctl:SettingsCard>

                <ctl:SettingsCard Header="Installed games">
                    <ctl:SettingsCard.Description>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CardDescription}">
                                    <Setter Property="Text" Value="No games found yet"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GamesInstalled}" Value="True">
                                            <Setter Property="Text"       Value="Games found"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentGreenBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </ctl:SettingsCard.Description>
                    <Button Content="Scan for games now" Style="{StaticResource GhostButton}"
                            Command="{Binding ScanNowCommand}"/>
                </ctl:SettingsCard>

            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}"
                       TextWrapping="Wrap" Margin="2,16,0,0"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
