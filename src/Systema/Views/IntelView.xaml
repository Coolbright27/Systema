<UserControl x:Class="Systema.Views.IntelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Systema.Core.Converters"
             xmlns:ctl="clr-namespace:Systema.Controls"
             Background="Transparent">

    <!-- Windows 11 Settings layout: one SettingsCard per driver setting, grouped under headers.
         Each card keeps its "Current:" read-back and its own Reset to Default. Layout only:
         what gets written, and to which adapter, is unchanged (see IntelGpuViewModel). -->

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <!-- The small Reset to Default under a card's control -->
        <Style x:Key="CardResetButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,28">

            <!-- ===== HEADER ===== -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Intel Graphics" Style="{StaticResource HeadingLarge}"/>
                    <TextBlock Text="{Binding AdapterName}" Style="{StaticResource CaptionText}"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Re-detect" VerticalAlignment="Center"
                        Style="{StaticResource GhostButton}" Padding="14,8"
                        Command="{Binding DetectCommand}"/>
            </Grid>

            <!-- ===== REBOOT HINT (Windows 11 informational bar) ===== -->
            <Border Margin="0,12,0,0" Padding="14,10" CornerRadius="6" Background="#1A60CDFF"
                    BorderBrush="#3360CDFF" BorderThickness="1"
                    Visibility="{Binding ShowRebootHint, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x24D8;" FontSize="14" Foreground="{StaticResource AccentBlueBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="Some Intel graphics changes take effect after you restart your PC."/>
                </StackPanel>
            </Border>

            <!-- ══════════════ PERFORMANCE ══════════════ -->
            <TextBlock Text="Performance" Style="{StaticResource SettingsGroupHeader}"/>

            <!-- ===== Power Policy ===== -->
            <ctl:SettingsCard Header="Power Policy" RecommendKey="IntelPowerPolicy"
                              Visibility="{Binding ShowPowerPolicy, Converter={StaticResource BoolToVis}}">
                <ctl:SettingsCard.Description>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardDescription}">
                            Controls how the Intel graphics chip balances performance against power saving.
                            Max Performance holds full clocks for the smoothest feel, and Default lets the driver decide.
                            <Run FontStyle="Italic">Takes effect after a restart.</Run>
                        </TextBlock>
                        <TextBlock Style="{StaticResource CardNote}">
                            <Run Text="Current: "/><Run Text="{Binding PowerPolicyDetected, Mode=OneWay}"
                                 Foreground="{StaticResource AccentGreenBrush}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>
                </ctl:SettingsCard.Description>
                <StackPanel>
                    <ComboBox Width="170" ItemsSource="{Binding PowerPolicyOptions}"
                              SelectedItem="{Binding SelectedPowerPolicy, Mode=TwoWay}"/>
                    <Button Content="Reset to Default" Style="{StaticResource CardResetButton}"
                            Command="{Binding ResetSettingCommand}" CommandParameter="PowerPolicy"/>
                </StackPanel>
            </ctl:SettingsCard>

            <!-- ===== RC6 Render Standby ===== -->
            <ctl:SettingsCard Header="RC6 Render Standby" RecommendKey="IntelRc6"
                              Visibility="{Binding ShowRc6, Converter={StaticResource BoolToVis}}">
                <ctl:SettingsCard.Description>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardDescription}">
                            Lets the graphics chip briefly sleep when idle to save power and run cooler.
                            Off keeps the GPU fully awake for maximum consistency, which uses more power and runs warmer.
                            <Run FontStyle="Italic">Takes effect after a restart.</Run>
                        </TextBlock>
                        <TextBlock Style="{StaticResource CardNote}">
                            <Run Text="Current: "/><Run Text="{Binding Rc6Detected, Mode=OneWay}"
                                 Foreground="{StaticResource AccentGreenBrush}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>
                </ctl:SettingsCard.Description>
                <StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                              IsChecked="{Binding Rc6On, Mode=TwoWay}"/>
                    <Button Content="Reset to Default" Style="{StaticResource CardResetButton}"
                            Command="{Binding ResetSettingCommand}" CommandParameter="RC6"/>
                </StackPanel>
            </ctl:SettingsCard>

            <!-- Panel Self Refresh toggle was removed. Disabling it black-screened some
                 laptop panels on battery, with no in-app way to recover. PSR stays at the
                 driver default; Revert All still clears any stale PSR override. -->

            <!-- ══════════════ DISPLAY AND BATTERY ══════════════ -->
            <TextBlock Text="Display and battery" Style="{StaticResource SettingsGroupHeader}"/>

            <!-- ===== Display Power Saving (DPST) ===== -->
            <ctl:SettingsCard Header="Display Power Saving (DPST)" RecommendKey="IntelDpst"
                              Visibility="{Binding ShowDpst, Converter={StaticResource BoolToVis}}">
                <ctl:SettingsCard.Description>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardDescription}">
                            Dims and adjusts the backlight automatically for longer battery life. Turn it Off if the
                            auto-dimming bugs you or you want steady brightness for photo or video work.
                            <Run FontStyle="Italic">Takes effect after a restart.</Run>
                        </TextBlock>
                        <TextBlock Style="{StaticResource CardNote}">
                            <Run Text="Current: "/><Run Text="{Binding DpstDetected, Mode=OneWay}"
                                 Foreground="{StaticResource AccentGreenBrush}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>
                </ctl:SettingsCard.Description>
                <StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                              IsChecked="{Binding DpstOn, Mode=TwoWay}"/>
                    <Button Content="Reset to Default" Style="{StaticResource CardResetButton}"
                            Command="{Binding ResetSettingCommand}" CommandParameter="DPST"/>
                </StackPanel>
            </ctl:SettingsCard>

            <!-- ===== Dynamic Refresh Switching (DRRS) ===== -->
            <ctl:SettingsCard Header="Dynamic Refresh Switching" RecommendKey="IntelDrrs"
                              Visibility="{Binding ShowDrrs, Converter={StaticResource BoolToVis}}">
                <ctl:SettingsCard.Description>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardDescription}">
                            Lowers the built-in screen's refresh rate when the picture is static to save power.
                            Turn it Off if you notice a stutter when the refresh rate switches.
                            <Run FontStyle="Italic">Takes effect after a restart.</Run>
                        </TextBlock>
                        <TextBlock Style="{StaticResource CardNote}">
                            <Run Text="Current: "/><Run Text="{Binding DrrsDetected, Mode=OneWay}"
                                 Foreground="{StaticResource AccentGreenBrush}" FontWeight="SemiBold"/>
                        </TextBlock>
                        <Border Margin="0,10,0,0" Padding="12,8" CornerRadius="4" Background="#1AF59E0B"
                                MaxWidth="680" HorizontalAlignment="Left"
                                Visibility="{Binding DrrsNoEffect, Converter={StaticResource BoolToVis}}">
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionText}"
                                       Text="{Binding DrrsNoEffectNote}"/>
                        </Border>
                    </StackPanel>
                </ctl:SettingsCard.Description>
                <StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                              IsChecked="{Binding DrrsOn, Mode=TwoWay}"/>
                    <Button Content="Reset to Default" Style="{StaticResource CardResetButton}"
                            Command="{Binding ResetSettingCommand}" CommandParameter="DRRS"/>
                </StackPanel>
            </ctl:SettingsCard>

            <!-- ===== Frame Buffer Compression (FBC) ===== -->
            <ctl:SettingsCard Header="Frame Buffer Compression" RecommendKey="IntelFbc"
                              Visibility="{Binding ShowFbc, Converter={StaticResource BoolToVis}}">
                <ctl:SettingsCard.Description>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardDescription}">
                            Compresses the screen image in memory to save power. Turn it Off only if you see faint
                            flicker on the built-in display. <Run FontStyle="Italic">Takes effect after a restart.</Run>
                        </TextBlock>
                        <TextBlock Style="{StaticResource CardNote}">
                            <Run Text="Current: "/><Run Text="{Binding FbcDetected, Mode=OneWay}"
                                 Foreground="{StaticResource AccentGreenBrush}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>
                </ctl:SettingsCard.Description>
                <StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                              IsChecked="{Binding FbcOn, Mode=TwoWay}"/>
                    <Button Content="Reset to Default" Style="{StaticResource CardResetButton}"
                            Command="{Binding ResetSettingCommand}" CommandParameter="FBC"/>
                </StackPanel>
            </ctl:SettingsCard>

            <!-- ══════════════ KEEP YOUR SETTINGS + REVERT ALL ══════════════ -->
            <StackPanel Visibility="{Binding AnySettingSupported, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Keep your settings" Style="{StaticResource SettingsGroupHeader}"/>

                <ctl:SettingsCard Header="Re-apply after driver updates"
                                  Description="Intel driver updates can wipe these settings. When on, Systema re-applies your choices a few seconds after startup.">
                    <CheckBox Style="{StaticResource ToggleSwitch}"
                              IsChecked="{Binding ReapplyAfterDriverUpdate, Mode=TwoWay}"/>
                </ctl:SettingsCard>

                <ctl:SettingsCard Header="Revert all"
                                  Description="Restore every Intel graphics setting to the driver's defaults.">
                    <Button Content="Revert All Intel Settings to Default"
                            Style="{StaticResource GhostButton}" Padding="14,8"
                            Command="{Binding RevertAllCommand}"/>
                </ctl:SettingsCard>
            </StackPanel>

            <!-- ===== STATUS ===== -->
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}"
                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="2,14,0,0"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
