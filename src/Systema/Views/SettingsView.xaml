<UserControl x:Class="Systema.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Systema.Core.Converters"
             xmlns:ctl="clr-namespace:Systema.Controls"
             Background="Transparent">

    <!-- Windows 11 Settings layout: one SettingsCard per setting, grouped under headers.
         Same bindings and text as before; only the layout changed. -->

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="GlobalBoolToVis"/>

        <!-- The update card shows an "Update available" badge while one is waiting.
             Built on the shared SettingsCard look; declared here, not inline, like every
             style that carries a ControlTemplate. -->
        <Style x:Key="UpdateCardStyle" TargetType="ctl:SettingsCard" BasedOn="{StaticResource {x:Type ctl:SettingsCard}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                    <Setter Property="Badge" Value="Update available"/>
                    <Setter Property="BadgeBrush" Value="{DynamicResource AccentGreenBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,28">

            <!-- ===== HEADER ===== -->
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="Settings" Style="{StaticResource HeadingLarge}"/>
                <TextBlock Text="Configure how Systema behaves, manage safety options, and run diagnostics."
                           Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- ════════════════ SYSTEM RESTORE ════════════════ -->
            <TextBlock Text="System Restore" Style="{StaticResource SettingsGroupHeader}" Margin="2,24,0,2"/>
            <TextBlock Text="Systema creates a Windows restore point before making changes, so you can undo everything if something goes wrong."
                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="2,0,0,8"/>

            <ctl:SettingsCard Header="Skip safety restore point">
                <ctl:SettingsCard.Description>
                    <StackPanel>
                        <TextBlock Text="When enabled, Systema will apply tweaks without creating a restore point first."
                                   Style="{StaticResource CardDescription}"/>
                        <Border Margin="0,10,0,0" Padding="12,8" Background="{DynamicResource CriticalAlpha10Brush}" CornerRadius="4"
                                MaxWidth="680" HorizontalAlignment="Left"
                                Visibility="{Binding SkipRestorePoint, Converter={StaticResource GlobalBoolToVis}}">
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionText}"
                                       Foreground="{DynamicResource AccentRedBrush}">
                                ⚠  Restore points are turned off. If something goes wrong after applying tweaks, you won't be able to roll back automatically.
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </ctl:SettingsCard.Description>
                <CheckBox IsChecked="{Binding SkipRestorePoint}" Style="{StaticResource ToggleSwitch}"/>
            </ctl:SettingsCard>

            <ctl:SettingsCard Header="Restore point manager">
                <ctl:SettingsCard.Description>
                    <TextBlock Style="{StaticResource CardDescription}">
                        View, create, and delete Windows restore points. If something goes wrong
                        after making changes, use "Restore My PC" to roll your settings back to
                        an earlier date.
                    </TextBlock>
                </ctl:SettingsCard.Description>
                <Button Content="Manage restore points" Padding="18,10"
                        Command="{Binding ManageRestorePointsCommand}"
                        Style="{StaticResource GhostButton}"/>
            </ctl:SettingsCard>

            <!-- ════════════════ STARTUP ════════════════ -->
            <TextBlock Text="Startup" Style="{StaticResource SettingsGroupHeader}" Margin="2,24,0,2"/>
            <TextBlock Text="Control whether Systema launches automatically when you sign in to Windows."
                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="2,0,0,8"/>

            <ctl:SettingsCard Header="Launch on Windows startup" RecommendKey="LaunchOnStartup"
                              Description="Systema will start automatically when you sign in. Task Sleep waits ~45 seconds after boot so normal startup processes aren't affected.">
                <CheckBox IsChecked="{Binding StartWithWindows}" ToolTipService.ShowOnDisabled="True">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox" BasedOn="{StaticResource ToggleSwitch}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAutoPilotActive}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Setter Property="Opacity"   Value="0.4"/>
                                    <Setter Property="ToolTip"   Value="Managed by Auto Pilot. Turn off Auto Pilot Mode to change it."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>
            </ctl:SettingsCard>

            <!-- Keep Systema Running -->
            <ctl:SettingsCard Header="Keep Systema running">
                <ctl:SettingsCard.Description>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardDescription}">
                            Registers a Windows Task Scheduler watchdog that checks every 5 minutes and
                            restarts Systema automatically if it ever stops, even after a crash or accidental close.
                        </TextBlock>
                        <!-- Status feedback -->
                        <TextBlock Text="{Binding KeepRunningStatus}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CardNoteGood}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding KeepRunningStatus}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ctl:SettingsCard.Description>
                <CheckBox IsChecked="{Binding KeepSystemaRunning}" Style="{StaticResource ToggleSwitch}"/>
            </ctl:SettingsCard>

            <!-- ════════════════ UPDATES ════════════════ -->
            <TextBlock Text="Updates" Style="{StaticResource SettingsGroupHeader}" Margin="2,24,0,2"/>
            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="2,0,0,8" MaxWidth="760"
                       HorizontalAlignment="Left">
                Systema checks for updates every 2 hours and installs silently when your
                CPU is idle. Updates are paused automatically during game sessions and
                when CPU usage is high. No prompts, no interruptions.
            </TextBlock>

            <ctl:SettingsCard Header="Automatic updates">
                <ctl:SettingsCard.Description>
                    <TextBlock Style="{StaticResource CardDescription}">
                        When on, Systema updates itself silently every 2 hours, paused during
                        game mode or when CPU usage is high. Manual checks always work regardless.
                    </TextBlock>
                </ctl:SettingsCard.Description>
                <CheckBox IsChecked="{Binding AutoUpdateEnabled}" Style="{StaticResource ToggleSwitch}"/>
            </ctl:SettingsCard>

            <ctl:SettingsCard Header="Check for updates" Style="{StaticResource UpdateCardStyle}">
                <ctl:SettingsCard.Description>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardDescription}">
                            <Run Text="Current version: "/>
                            <Run Text="{Binding CurrentVersionString, Mode=OneTime}"
                                 Foreground="{DynamicResource AccentBlueBrush}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding UpdateStatus}" Margin="0,3,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CardDescription}">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentGreenBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Download progress bar: shown while downloading -->
                        <Grid Margin="0,8,0,0" MaxWidth="680" HorizontalAlignment="Stretch">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDownloadingUpdate}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <ProgressBar Value="{Binding DownloadProgress}" Minimum="0" Maximum="100"
                                         Height="4" Background="{DynamicResource OverlayStrongBrush}"
                                         Foreground="{DynamicResource AccentBlueBrush}"/>
                        </Grid>
                    </StackPanel>
                </ctl:SettingsCard.Description>

                <!-- Right-side buttons: contextual based on state -->
                <StackPanel Orientation="Horizontal">
                    <!-- "Install Now": only when the installer is downloaded and ready -->
                    <Button Content="Install now"
                            Padding="18,9" Margin="0,0,8,0"
                            Command="{Binding InstallNowCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReadyToInstall}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- "Check now": always available unless actively checking/downloading -->
                    <Button Content="Check now"
                            Padding="18,9"
                            IsEnabled="{Binding CanCheckNow}"
                            Command="{Binding CheckForUpdatesCommand}"
                            Style="{StaticResource GhostButton}"/>
                </StackPanel>
            </ctl:SettingsCard>

            <!-- ════════════════ BACKUP AND SUPPORT ════════════════ -->
            <TextBlock Text="Backup and support" Style="{StaticResource SettingsGroupHeader}"/>

            <ctl:SettingsCard Header="Export / import settings" Badge="Backup"
                              BadgeBrush="{DynamicResource TextSecondaryBrush}">
                <ctl:SettingsCard.Description>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardDescription}">
                            Back up your Systema configuration to a JSON file, or restore it on a new machine.
                            This saves preferences like game boost settings, service kill list, and startup options.
                        </TextBlock>
                        <TextBlock Text="Settings are saved automatically to the Windows Registry under HKCU\Software\Systema."
                                   Style="{StaticResource CardNote}"/>
                        <!-- Status feedback: visible only when non-empty -->
                        <TextBlock Text="{Binding ExportImportStatus}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CardNoteGood}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ExportImportStatus}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ctl:SettingsCard.Description>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Export settings"
                            Padding="18,9" Margin="0,0,8,0"
                            Command="{Binding ExportSettingsCommand}"
                            Style="{StaticResource GhostButton}"/>
                    <Button Content="Import settings"
                            Padding="18,9"
                            Command="{Binding ImportSettingsCommand}"
                            Style="{StaticResource GhostButton}"/>
                </StackPanel>
            </ctl:SettingsCard>

            <ctl:SettingsCard Header="Diagnostic report" Badge="Diagnostic"
                              BadgeBrush="{DynamicResource TextSecondaryBrush}">
                <ctl:SettingsCard.Description>
                    <TextBlock Style="{StaticResource CardDescription}">
                        Creates a report of recent errors and session activity that you can paste into Discord for support. Nothing is sent automatically.
                    </TextBlock>
                </ctl:SettingsCard.Description>
                <Button Content="Copy diagnostic report" Padding="18,10"
                        Command="{Binding OpenDiagnosticsCommand}"
                        Style="{StaticResource PrimaryButton}"/>
            </ctl:SettingsCard>

            <!-- ════════════════ RESET ════════════════ -->
            <TextBlock Text="Reset" Style="{StaticResource SettingsGroupHeader}"/>

            <ctl:SettingsCard Header="Reset all settings"
                              Description="Resets every Systema setting to factory defaults and restarts the app. This cannot be undone.">
                <Button Content="Reset to defaults"
                        Command="{Binding ResetAllSettingsCommand}"
                        Style="{StaticResource GhostButton}"
                        Foreground="{DynamicResource AccentRedBrush}"/>
            </ctl:SettingsCard>

            <!-- Version footer -->
            <TextBlock Text="Systema v0.7.357  ·  For support visit discord.gg/yYhM7mdupH"
                       Style="{StaticResource CaptionText}" Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="2,24,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
