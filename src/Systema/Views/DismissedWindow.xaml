<Window x:Class="Systema.Views.DismissedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Systema.ViewModels"
        Title="Dismissed recommendations — Systema"
        Height="560" Width="560"
        MinHeight="360" MinWidth="460"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgPrimaryBrush}"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        ShowInTaskbar="False">

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- header -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>      <!-- list -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>   <!-- close -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Dismissed recommendations" Style="{StaticResource HeadingLarge}"/>
            <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="Recommendations you chose to skip. Restore any to bring it back to your recommended list."/>
        </StackPanel>

        <!-- List -->
        <Border Grid.Row="2" Background="{StaticResource BgCardBrush}" CornerRadius="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Nothing dismissed yet." Style="{StaticResource CaptionText}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,28"
                               Visibility="{Binding HasDismissed, Converter={StaticResource GlobalBoolToVis}, ConverterParameter=Invert}"/>

                    <ItemsControl ItemsSource="{Binding Dismissed}"
                                  Visibility="{Binding HasDismissed, Converter={StaticResource GlobalBoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:Recommendation}">
                                <Border Padding="18,14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource HeadingSmall}"/>
                                            <TextBlock Text="{Binding Why}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Restore" Style="{StaticResource GhostButton}"
                                                Padding="16,7" VerticalAlignment="Center" FontSize="12"
                                                Command="{Binding DataContext.RestoreRecommendationCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Close -->
        <Button Grid.Row="4" Content="Close" Style="{StaticResource GhostButton}" Padding="18,9"
                HorizontalAlignment="Right" Click="CloseBtn_Click"/>
    </Grid>
</Window>
