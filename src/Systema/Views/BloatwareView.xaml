<UserControl x:Class="Systema.Views.BloatwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Systema.Core.Converters"
             xmlns:ctl="clr-namespace:Systema.Controls"
             Background="Transparent">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <!-- Windows 11 Settings layout, modelled on Settings > Apps > Installed apps: the list info
         as a settings card, then one row card per app. Same bindings and text as before; each
         app row is now clickable across its whole width instead of only on the tiny check box. -->

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,28">

            <!-- ===== HEADER ===== -->
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="App Cleanup" Style="{StaticResource HeadingLarge}"/>
                <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="760"
                           HorizontalAlignment="Left">
                    Remove pre-installed Microsoft apps you don't use. Your PC stays healthy and
                    nothing breaks, since only extras are removed. You can reinstall any of them from the
                    Microsoft Store if you change your mind.
                </TextBlock>
            </StackPanel>

            <!-- ===== INFO CARD ===== -->
            <ctl:SettingsCard Header="Safe Pre-installed App List" Margin="0,16,0,4"
                              Badge="Safe" BadgeBrush="{StaticResource AccentGreenBrush}">
                <ctl:SettingsCard.Description>
                    <TextBlock Style="{StaticResource CardDescription}">
                        Every app on this list has been verified safe to remove. None of them are
                        required for Windows, the Microsoft Store, Xbox, or other core functions.
                        A safety restore point is created before anything is removed.
                    </TextBlock>
                </ctl:SettingsCard.Description>
                <Button Content="Scan Again"
                        Style="{StaticResource GhostButton}" Padding="16,9"
                        IsEnabled="{Binding IsNotLoading}"
                        Command="{Binding RescanCommand}"/>
            </ctl:SettingsCard>

            <!-- ===== LOADING ===== -->
            <Border Style="{StaticResource ListRowCard}" Padding="16,18"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4"
                                 Style="{StaticResource AccentProgressBar}" Margin="0,0,16,0"
                                 VerticalAlignment="Center"/>
                    <TextBlock Text="Scanning for pre-installed apps…" Style="{StaticResource BodyText}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ===== APP LIST (visible after the first scan) ===== -->
            <StackPanel Visibility="{Binding HasScannedOnce, Converter={StaticResource BoolToVis}}">

                <!-- List header: summary on the left, select-all on the right -->
                <Grid Margin="2,20,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding ScanSummary}"
                               Style="{StaticResource BodyText}" FontWeight="SemiBold" TextWrapping="Wrap"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding HasApps, Converter={StaticResource BoolToVis}}">
                        <Button Content="Select All" Style="{StaticResource GhostButton}"
                                Padding="12,6" Margin="0,0,8,0"
                                Command="{Binding SelectAllCommand}"/>
                        <Button Content="Deselect All" Style="{StaticResource GhostButton}"
                                Padding="12,6"
                                Command="{Binding DeselectAllCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- Empty state: no removable apps found -->
                <Border Style="{StaticResource ListRowCard}" Padding="20,28"
                        Visibility="{Binding HasApps, Converter={StaticResource BoolToVis},
                                     ConverterParameter=Invert}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="✓" FontSize="36" HorizontalAlignment="Center"
                                   Foreground="{StaticResource AccentGreenBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="No removable pre-installed apps found. Your system looks clean."
                                   Style="{StaticResource BodyText}" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- App rows: the check box fills the row, so a click anywhere on it toggles the app -->
                <ItemsControl ItemsSource="{Binding Apps}"
                              Visibility="{Binding HasApps, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ListRowCard}" Padding="0">
                                <CheckBox Style="{StaticResource Win11CheckBox}" Padding="16,12"
                                          HorizontalAlignment="Stretch"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Command="{Binding DataContext.SelectionChangedCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Style="{StaticResource BodyText}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Description}"
                                                   Style="{StaticResource CaptionText}"
                                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Footer: removal progress + remove button -->
                <Border Style="{StaticResource ListRowCard}" Margin="0,8,0,0"
                        Visibility="{Binding HasApps, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Removal progress (visible while removing) -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding IsRemoving, Converter={StaticResource BoolToVis}}">
                            <ProgressBar IsIndeterminate="True" Width="160" Height="4"
                                         Style="{StaticResource AccentProgressBar}" Margin="0,0,12,0"
                                         VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Remove button -->
                        <Button Grid.Column="1"
                                Style="{StaticResource DangerButton}" Padding="20,10"
                                Command="{Binding RemoveSelectedCommand}"
                                IsEnabled="{Binding IsNotRemoving}">
                            <TextBlock>
                                <Run Text="Remove Selected ("/>
                                <Run Text="{Binding SelectedCount, Mode=OneWay}"/>
                                <Run Text=")"/>
                            </TextBlock>
                        </Button>
                    </Grid>
                </Border>

            </StackPanel>

            <!-- ===== STATUS (non-removing) ===== -->
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="2,12,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRemoving}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

        </StackPanel>
    </ScrollViewer>
</UserControl>
