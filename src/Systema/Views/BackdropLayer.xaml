<UserControl x:Class="Systema.Views.BackdropLayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False"
             SnapsToDevicePixels="True">
    <!-- IsHitTestVisible=False so the backdrop never intercepts clicks. -->

    <!-- Base diagonal gradient fills the whole window at any aspect ratio. -->
    <Grid>
        <!-- New backdrop: a deep blue (top-left) → purple (bottom-right) diagonal,
             matching the requested artwork. -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#111A3C" Offset="0"/>
                <GradientStop Color="#15163E" Offset="0.55"/>
                <GradientStop Color="#1E1444" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Decorative layer drawn at a fixed 1480x833 reference and scaled to
             fill the window. UniformToFill keeps the rings perfectly round. -->
        <Viewbox Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="1480" Height="833" ClipToBounds="False">

                <!-- ── Radial glows ───────────────────────────────────────── -->
                <Ellipse Canvas.Left="-491" Canvas.Top="-308" Width="1516" Height="1083">
                    <Ellipse.Fill>
                        <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#663B5BDB" Offset="0"/>
                            <GradientStop Color="#003B5BDB" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Canvas.Left="513" Canvas.Top="142" Width="1283" Height="916">
                    <Ellipse.Fill>
                        <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#546D28D9" Offset="0"/>
                            <GradientStop Color="#006D28D9" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Canvas.Left="303" Canvas.Top="-250" Width="933" Height="666">
                    <Ellipse.Fill>
                        <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#382563EB" Offset="0"/>
                            <GradientStop Color="#002563EB" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Canvas.Left="894" Canvas.Top="-125" Width="816" Height="583">
                    <Ellipse.Fill>
                        <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#337C3AED" Offset="0"/>
                            <GradientStop Color="#007C3AED" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- ── Faint 80px grid ────────────────────────────────────── -->
                <Rectangle Width="1480" Height="833" Opacity="0.06">
                    <Rectangle.Fill>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,80,80" ViewportUnits="Absolute"
                                      Stretch="None">
                            <DrawingBrush.Drawing>
                                <GeometryDrawing>
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,80,80"/>
                                    </GeometryDrawing.Geometry>
                                    <GeometryDrawing.Pen>
                                        <Pen Brush="#7BA7FF" Thickness="1"/>
                                    </GeometryDrawing.Pen>
                                </GeometryDrawing>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- ── Radar rings ────────────────────────────────────────── -->
                <Ellipse Canvas.Left="980"  Canvas.Top="-117" Width="466" Height="466" Stroke="#4F7EF7" StrokeThickness="1.4" Opacity="0.32"/>
                <Ellipse Canvas.Left="1047" Canvas.Top="-50"  Width="333" Height="333" Stroke="#4F7EF7" StrokeThickness="1"   Opacity="0.20"/>
                <Ellipse Canvas.Left="1114" Canvas.Top="17"   Width="200" Height="200" Stroke="#7C5CF7" StrokeThickness="1"   Opacity="0.22"/>
                <Ellipse Canvas.Left="-6"   Canvas.Top="500"  Width="366" Height="366" Stroke="#7C3AED" StrokeThickness="1.4" Opacity="0.26"/>
                <Ellipse Canvas.Left="61"   Canvas.Top="567"  Width="233" Height="233" Stroke="#7C3AED" StrokeThickness="1"   Opacity="0.16"/>
                <Ellipse Canvas.Left="657"  Canvas.Top="650"  Width="166" Height="166" Stroke="#3B82F6" StrokeThickness="1"   Opacity="0.18"/>

                <!-- ── Faint diagonal accent line (single, subtle) ────────── -->
                <Line X1="0" Y1="600" X2="1066" Y2="0" Stroke="#4F7EF7" StrokeThickness="1" Opacity="0.07"/>

                <!-- ── Constellation dots ─────────────────────────────────── -->
                <Ellipse Canvas.Left="590"  Canvas.Top="165" Width="3.5" Height="3.5" Fill="#6366F1" Opacity="0.75"/>
                <Ellipse Canvas.Left="635"  Canvas.Top="148" Width="3.5" Height="3.5" Fill="#6366F1" Opacity="0.75"/>
                <Ellipse Canvas.Left="664"  Canvas.Top="173" Width="3.5" Height="3.5" Fill="#6366F1" Opacity="0.75"/>
                <Ellipse Canvas.Left="620"  Canvas.Top="190" Width="3.5" Height="3.5" Fill="#6366F1" Opacity="0.75"/>
                <Ellipse Canvas.Left="561"  Canvas.Top="182" Width="3.5" Height="3.5" Fill="#6366F1" Opacity="0.75"/>
                <Ellipse Canvas.Left="1034" Canvas.Top="398" Width="3.5" Height="3.5" Fill="#3B82F6" Opacity="0.75"/>
                <Ellipse Canvas.Left="1064" Canvas.Top="382" Width="3.5" Height="3.5" Fill="#3B82F6" Opacity="0.75"/>
                <Ellipse Canvas.Left="1094" Canvas.Top="407" Width="3.5" Height="3.5" Fill="#3B82F6" Opacity="0.75"/>
                <Ellipse Canvas.Left="1049" Canvas.Top="423" Width="3.5" Height="3.5" Fill="#3B82F6" Opacity="0.75"/>
                <Ellipse Canvas.Left="1005" Canvas.Top="415" Width="3.5" Height="3.5" Fill="#3B82F6" Opacity="0.75"/>
                <Ellipse Canvas.Left="324"  Canvas.Top="548" Width="3.5" Height="3.5" Fill="#7C3AED" Opacity="0.75"/>
                <Ellipse Canvas.Left="354"  Canvas.Top="532" Width="3.5" Height="3.5" Fill="#7C3AED" Opacity="0.75"/>
                <Ellipse Canvas.Left="384"  Canvas.Top="557" Width="3.5" Height="3.5" Fill="#7C3AED" Opacity="0.75"/>
                <Ellipse Canvas.Left="339"  Canvas.Top="573" Width="3.5" Height="3.5" Fill="#7C3AED" Opacity="0.75"/>

            </Canvas>
        </Viewbox>
    </Grid>
</UserControl>
