<UserControl x:Class="Systema.Views.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Systema.Core.Converters"
             xmlns:ctl="clr-namespace:Systema.Controls"
             Background="Transparent">

    <!-- Windows 11 Settings layout: the memory breakdown reads like Settings > System > Storage,
         the startup list like Settings > Apps > Startup (one row per app: name and publisher on
         the left, impact and switch on the right). Same bindings and text as before. -->

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,28">

            <!-- ===== HEADER ===== -->
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="Memory &amp; Startup" Style="{StaticResource HeadingLarge}"/>
                <TextBlock Text="See how your memory is doing and manage the apps that open when your PC starts."
                           Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- ===== LIVE MEMORY BREAKDOWN + TREND LINE ===== -->
            <Border Style="{StaticResource ListRowCard}" Padding="20,18" Margin="0,16,0,4">
                <StackPanel>
                    <Grid Margin="0,0,0,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Free right now" Style="{StaticResource CaptionText}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding FreeRamGb}" FontSize="31" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentGreenBrush}"/>
                                <TextBlock VerticalAlignment="Bottom" Margin="7,0,0,6" FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="GB of "/><Run Text="{Binding TotalRamGb, Mode=OneWay}"/><Run Text=" GB"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <!-- live memory-in-use trend line -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                    Visibility="{Binding HasSparkline, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Memory in use" Style="{StaticResource CaptionText}"
                                       HorizontalAlignment="Right" Margin="0,0,2,3"/>
                            <Grid Width="168" Height="46">
                                <Polygon Points="{Binding SparklineArea}" Fill="#2E60CDFF"/>
                                <Polyline Points="{Binding SparklinePoints}" Stroke="{StaticResource AccentBlueBrush}"
                                          StrokeThickness="2" StrokeLineJoin="Round"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- three-segment usage bar -->
                    <Border CornerRadius="4" Height="12" ClipToBounds="True"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding InUseStar}"/>
                                <ColumnDefinition Width="{Binding CachedStar}"/>
                                <ColumnDefinition Width="{Binding FreeStar}"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource AccentBlueBrush}"/>
                            <Border Grid.Column="1" Background="#4A6A5C"/>
                            <Border Grid.Column="2" Background="{StaticResource AccentGreenBrush}"/>
                        </Grid>
                    </Border>

                    <!-- legend -->
                    <WrapPanel Margin="0,11,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                            <Ellipse Width="9" Height="9" Fill="{StaticResource AccentBlueBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource CaptionText}"><Run Text="In use "/><Run Text="{Binding InUseGb, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/><Run Text=" GB"/></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0"
                                    Visibility="{Binding HasCached, Converter={StaticResource BoolToVis}}">
                            <Ellipse Width="9" Height="9" Fill="#4A6A5C" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource CaptionText}"><Run Text="Cached "/><Run Text="{Binding CachedGb, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/><Run Text=" GB"/></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                            <Ellipse Width="9" Height="9" Fill="{StaticResource AccentGreenBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource CaptionText}"><Run Text="Free "/><Run Text="{Binding FreeSegGb, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/><Run Text=" GB"/></TextBlock>
                        </StackPanel>
                        <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Visibility="{Binding HasCompressed, Converter={StaticResource BoolToVis}}">
                            <Run Text="Compressed "/><Run Text="{Binding CompressedGb, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/><Run Text=" GB"/>
                        </TextBlock>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ===== FREE UP MEMORY ===== -->
            <ctl:SettingsCard Header="Free up memory">
                <ctl:SettingsCard.Description>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardDescription}"
                                   Text="Flushes background working sets and clears standby RAM so the app you're using gets it."/>
                        <TextBlock Text="{Binding FreeRamStatus}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CardNoteGood}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FreeRamStatus}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ctl:SettingsCard.Description>
                <Button Command="{Binding FreeRamCommand}" MinWidth="130">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Setter Property="Content"   Value="Free up memory"/>
                            <Setter Property="IsEnabled" Value="True"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFreeing}" Value="True">
                                    <Setter Property="Content"   Value="Freeing up…"/>
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </ctl:SettingsCard>

            <!-- ===== STARTUP ===== -->
            <TextBlock Text="Startup" Style="{StaticResource SettingsGroupHeader}"/>

            <!-- Speed-up recommendation: outlined in the accent so it stands out from the list -->
            <ctl:SettingsCard Header="Speed up your startup" BorderBrush="{StaticResource AccentBlueBrush}"
                              Visibility="{Binding HasStartupRecommendation, Converter={StaticResource BoolToVis}}">
                <ctl:SettingsCard.Description>
                    <StackPanel>
                        <TextBlock Text="{Binding StartupRecommendationText}" Style="{StaticResource CardDescription}"
                                   Foreground="{StaticResource AccentBlueBrush}" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource CardNote}">
                            <Run Text="These apps make your PC slower to get ready after you turn it on: "/>
                            <Run Text="{Binding HighImpactNames, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Run Text=". You can still open them anytime."/>
                        </TextBlock>
                    </StackPanel>
                </ctl:SettingsCard.Description>
                <Button Content="Turn them all off" Command="{Binding DisableHeavyStartupCommand}"
                        Style="{StaticResource PrimaryButton}"/>
            </ctl:SettingsCard>

            <!-- All startup apps -->
            <TextBlock Text="All startup apps" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="2,14,0,2"/>
            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="2,0,0,8">
                <Run Text="These open automatically with Windows. Turning off the heavy ones makes your PC ready faster. The colored tag shows how much each one slows you down."/>
            </TextBlock>

            <ItemsControl ItemsSource="{Binding StartupItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ListRowCard}" ToolTip="{Binding Command}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Name + publisher -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Publisher}" Style="{StaticResource CaptionText}"
                                               TextTrimming="CharacterEllipsis" Opacity="0.7" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Impact badge -->
                                <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="4" Padding="8,3"
                                        Margin="0,0,20,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#2222C55E"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ImpactLabel}" Value="High">
                                                    <Setter Property="Background" Value="#22EF4444"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ImpactLabel}" Value="Medium">
                                                    <Setter Property="Background" Value="#22F59E0B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                                <Setter Property="Text"       Value="Low impact"/>
                                                <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ImpactLabel}" Value="High">
                                                        <Setter Property="Text"       Value="High impact"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ImpactLabel}" Value="Medium">
                                                        <Setter Property="Text"       Value="Medium impact"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AccentYellowBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <!-- Switch -->
                                <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                          Command="{Binding DataContext.ToggleStartupItemCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===== ADVANCED: VIRTUAL MEMORY (PAGE FILE) ===== -->
            <TextBlock Text="Advanced" Style="{StaticResource SettingsGroupHeader}"/>

            <!-- Locked while Auto Pilot runs, exactly as before. -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAutoPilotActive}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="Opacity"   Value="0.4"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <ctl:SettingsCard Header="Virtual memory (page file)">
                    <ctl:SettingsCard.Description>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardDescription}">
                                Windows uses a file on disk as backup memory when RAM fills up. A fixed size avoids
                                stutter from resizing on the fly, and Windows decides lets it grow and shrink on its
                                own. Most people can leave this alone. Requires a restart.
                            </TextBlock>
                            <TextBlock Text="{Binding CurrentPagefileText}" Style="{StaticResource CardNoteGood}"/>
                            <TextBlock Text="{Binding RecommendedPagefileText}" Style="{StaticResource CardNote}"
                                       Foreground="{StaticResource AccentBlueBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </ctl:SettingsCard.Description>
                    <!-- Pick a size, then Apply (it lights up only when the choice differs from
                         what's set). "Windows decides" is Windows' own default, so there's no
                         separate reset button. -->
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="200" Style="{StaticResource DarkComboBox}" VerticalAlignment="Center"
                                  ItemsSource="{Binding PagefileOptions}" DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedPagefileOption, Mode=TwoWay}"/>
                        <Button Content="Apply" Command="{Binding ConfigurePagefileCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </ctl:SettingsCard>
            </StackPanel>

            <!-- Status line -->
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" Margin="2,14,0,0"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
