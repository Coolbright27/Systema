<UserControl x:Class="Systema.Views.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Systema.Core.Converters"
             Background="Transparent">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,28">

            <!-- Header -->
            <TextBlock Text="Memory &amp; Startup" Style="{StaticResource HeadingLarge}"/>
            <TextBlock Text="See how your memory is doing and manage the apps that open when your PC starts."
                       Style="{StaticResource CaptionText}" Margin="0,4,0,20"/>

            <!-- Metric tiles -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource BgSurfaceBrush}" CornerRadius="12" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="In use" Style="{StaticResource CaptionText}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding UsedRamGb}" FontSize="26" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text=" GB" FontSize="13" VerticalAlignment="Bottom" Margin="3,0,0,5"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource BgSurfaceBrush}" CornerRadius="12" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="Free" Style="{StaticResource CaptionText}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding FreeRamGb}" FontSize="26" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentGreenBrush}"/>
                            <TextBlock Text=" GB" FontSize="13" VerticalAlignment="Bottom" Margin="3,0,0,5"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Background="{StaticResource BgSurfaceBrush}" CornerRadius="12" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="Startup apps" Style="{StaticResource CaptionText}"/>
                        <TextBlock Text="{Binding StartupItems.Count, Mode=OneWay}" FontSize="26" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Actions -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Command="{Binding FreeRamCommand}" HorizontalAlignment="Stretch">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Setter Property="Content"   Value="Free up memory"/>
                            <Setter Property="IsEnabled" Value="True"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFreeing}" Value="True">
                                    <Setter Property="Content"   Value="Freeing up…"/>
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshCommand}"
                        Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch"/>
            </Grid>

            <!-- Free-RAM result text -->
            <TextBlock Text="{Binding FreeRamStatus}" Foreground="{StaticResource AccentGreenBrush}"
                       TextWrapping="Wrap" Margin="2,8,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FreeRamStatus}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Speed-up recommendation -->
            <Border CornerRadius="12" Padding="18,16" Margin="0,20,0,0"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource AccentBlueBrush}" BorderThickness="2"
                    Visibility="{Binding HasStartupRecommendation, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Speed up your startup" Style="{StaticResource HeadingSmall}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding StartupRecommendationText}"
                               Foreground="{StaticResource AccentBlueBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,12">
                        <Run Text="These apps make your PC slower to get ready after you turn it on: "/>
                        <Run Text="{Binding HighImpactNames, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Run Text=". You can still open them anytime."/>
                    </TextBlock>
                    <Button Content="Turn them all off" Command="{Binding DisableHeavyStartupCommand}"
                            Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- All startup apps -->
            <TextBlock Text="All startup apps" Style="{StaticResource HeadingMedium}" Margin="0,24,0,2"/>
            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,12">
                <Run Text="These open automatically with Windows. Turning off the heavy ones makes your PC ready faster. The colored tag shows how much each one slows you down."/>
            </TextBlock>

            <ItemsControl ItemsSource="{Binding StartupItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="232" Margin="0,0,12,12" Padding="16,14"
                                Background="{StaticResource BgCardBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="12" ToolTip="{Binding Command}">
                            <StackPanel>
                                <!-- Name + toggle -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource BodyText}"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                              Command="{Binding DataContext.ToggleStartupItemCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"/>
                                </Grid>

                                <!-- Publisher -->
                                <TextBlock Text="{Binding Publisher}" Style="{StaticResource CaptionText}"
                                           TextTrimming="CharacterEllipsis" Opacity="0.7" Margin="0,2,0,10"/>

                                <!-- Impact badge -->
                                <Border HorizontalAlignment="Left" CornerRadius="6" Padding="8,3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#225C9C7C"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ImpactLabel}" Value="High">
                                                    <Setter Property="Background" Value="#22C7556B"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ImpactLabel}" Value="Medium">
                                                    <Setter Property="Background" Value="#22C8A654"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                                <Setter Property="Text"       Value="Low impact"/>
                                                <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ImpactLabel}" Value="High">
                                                        <Setter Property="Text"       Value="High impact"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ImpactLabel}" Value="Medium">
                                                        <Setter Property="Text"       Value="Medium impact"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AccentYellowBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Advanced (demoted) — Virtual memory / page file -->
            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAutoPilotActive}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Setter Property="Opacity"   Value="0.4"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Advanced · Virtual memory (page file)" Style="{StaticResource HeadingSmall}"/>
                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,4">
                        Windows uses a file on disk as backup memory when RAM fills up. A fixed size avoids
                        stutter from resizing on the fly. Most people can leave this alone. Requires a restart.
                    </TextBlock>
                    <TextBlock Text="{Binding CurrentPagefileText}" Style="{StaticResource CaptionText}"
                               Foreground="{StaticResource AccentGreenBrush}" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding RecommendedPagefileText}" Style="{StaticResource CaptionText}"
                               Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,12"/>

                    <StackPanel Width="180" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <TextBlock Text="Fixed size (MB)" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding PagefileInitialMb, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Apply" Command="{Binding ConfigurePagefileCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/>
                        <Button Content="Reset to default" Command="{Binding RevertPagefileCommand}"
                                Style="{StaticResource GhostButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Status line -->
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" Margin="2,14,0,0"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
