<UserControl x:Class="Systema.Views.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Systema.Core.Converters"
             Background="Transparent">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,28">

            <!-- Header -->
            <TextBlock Text="Memory &amp; Startup" Style="{StaticResource HeadingLarge}"/>
            <TextBlock Text="See how your memory is doing and manage the apps that open when your PC starts."
                       Style="{StaticResource CaptionText}" Margin="0,4,0,20"/>

            <!-- Hero: live memory breakdown + trend line -->
            <Border Background="{StaticResource BgSurfaceBrush}" CornerRadius="12" Padding="18,16" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Free right now" Style="{StaticResource CaptionText}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding FreeRamGb}" FontSize="31" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentGreenBrush}"/>
                                <TextBlock VerticalAlignment="Bottom" Margin="7,0,0,6" FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="GB of "/><Run Text="{Binding TotalRamGb, Mode=OneWay}"/><Run Text=" GB"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <!-- live memory-in-use trend line -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                    Visibility="{Binding HasSparkline, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Memory in use" Style="{StaticResource CaptionText}"
                                       HorizontalAlignment="Right" Margin="0,0,2,3"/>
                            <Grid Width="168" Height="46">
                                <Polygon Points="{Binding SparklineArea}" Fill="#2E38BDF8"/>
                                <Polyline Points="{Binding SparklinePoints}" Stroke="{StaticResource AccentBlueBrush}"
                                          StrokeThickness="2" StrokeLineJoin="Round"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- three-segment usage bar -->
                    <Border CornerRadius="7" Height="14" ClipToBounds="True"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding InUseStar}"/>
                                <ColumnDefinition Width="{Binding CachedStar}"/>
                                <ColumnDefinition Width="{Binding FreeStar}"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource AccentBlueBrush}"/>
                            <Border Grid.Column="1" Background="#4A6A5C"/>
                            <Border Grid.Column="2" Background="{StaticResource AccentGreenBrush}"/>
                        </Grid>
                    </Border>

                    <!-- legend -->
                    <WrapPanel Margin="0,11,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                            <Ellipse Width="9" Height="9" Fill="{StaticResource AccentBlueBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource CaptionText}"><Run Text="In use "/><Run Text="{Binding InUseGb, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/><Run Text=" GB"/></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0"
                                    Visibility="{Binding HasCached, Converter={StaticResource BoolToVis}}">
                            <Ellipse Width="9" Height="9" Fill="#4A6A5C" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource CaptionText}"><Run Text="Cached "/><Run Text="{Binding CachedGb, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/><Run Text=" GB"/></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                            <Ellipse Width="9" Height="9" Fill="{StaticResource AccentGreenBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource CaptionText}"><Run Text="Free "/><Run Text="{Binding FreeSegGb, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/><Run Text=" GB"/></TextBlock>
                        </StackPanel>
                        <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Visibility="{Binding HasCompressed, Converter={StaticResource BoolToVis}}">
                            <Run Text="Compressed "/><Run Text="{Binding CompressedGb, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/><Run Text=" GB"/>
                        </TextBlock>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Free up memory -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="Free up memory" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                        <TextBlock Text="Flushes background working sets and clears standby RAM so the app you're using gets it."
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding FreeRamStatus}" Foreground="{StaticResource AccentGreenBrush}"
                                   TextWrapping="Wrap" Margin="0,8,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FreeRamStatus}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Command="{Binding FreeRamCommand}" MinWidth="130">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Setter Property="Content"   Value="Free up memory"/>
                                    <Setter Property="IsEnabled" Value="True"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFreeing}" Value="True">
                                            <Setter Property="Content"   Value="Freeing up…"/>
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Speed-up recommendation -->
            <Border CornerRadius="12" Padding="18,16" Margin="0,20,0,0"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource AccentBlueBrush}" BorderThickness="2"
                    Visibility="{Binding HasStartupRecommendation, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Speed up your startup" Style="{StaticResource HeadingSmall}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding StartupRecommendationText}"
                               Foreground="{StaticResource AccentBlueBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,12">
                        <Run Text="These apps make your PC slower to get ready after you turn it on: "/>
                        <Run Text="{Binding HighImpactNames, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Run Text=". You can still open them anytime."/>
                    </TextBlock>
                    <Button Content="Turn them all off" Command="{Binding DisableHeavyStartupCommand}"
                            Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- All startup apps -->
            <TextBlock Text="All startup apps" Style="{StaticResource HeadingMedium}" Margin="0,24,0,2"/>
            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,12">
                <Run Text="These open automatically with Windows. Turning off the heavy ones makes your PC ready faster. The colored tag shows how much each one slows you down."/>
            </TextBlock>

            <ItemsControl ItemsSource="{Binding StartupItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="232" Margin="0,0,12,12" Padding="16,14"
                                Background="{StaticResource BgCardBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="12" ToolTip="{Binding Command}">
                            <StackPanel>
                                <!-- Name + toggle -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource BodyText}"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                              Command="{Binding DataContext.ToggleStartupItemCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"/>
                                </Grid>

                                <!-- Publisher -->
                                <TextBlock Text="{Binding Publisher}" Style="{StaticResource CaptionText}"
                                           TextTrimming="CharacterEllipsis" Opacity="0.7" Margin="0,2,0,10"/>

                                <!-- Impact badge -->
                                <Border HorizontalAlignment="Left" CornerRadius="6" Padding="8,3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#2222C55E"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ImpactLabel}" Value="High">
                                                    <Setter Property="Background" Value="#22EF4444"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ImpactLabel}" Value="Medium">
                                                    <Setter Property="Background" Value="#22F59E0B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                                <Setter Property="Text"       Value="Low impact"/>
                                                <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ImpactLabel}" Value="High">
                                                        <Setter Property="Text"       Value="High impact"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ImpactLabel}" Value="Medium">
                                                        <Setter Property="Text"       Value="Medium impact"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AccentYellowBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Advanced (demoted) — Virtual memory / page file -->
            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAutoPilotActive}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Setter Property="Opacity"   Value="0.4"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Advanced · Virtual memory (page file)" Style="{StaticResource HeadingSmall}"/>
                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,4">
                        Windows uses a file on disk as backup memory when RAM fills up. A fixed size avoids
                        stutter from resizing on the fly. Most people can leave this alone. Requires a restart.
                    </TextBlock>
                    <TextBlock Text="{Binding CurrentPagefileText}" Style="{StaticResource CaptionText}"
                               Foreground="{StaticResource AccentGreenBrush}" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding RecommendedPagefileText}" Style="{StaticResource CaptionText}"
                               Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,12"/>

                    <StackPanel Width="180" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <TextBlock Text="Fixed size (MB)" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding PagefileInitialMb, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Apply" Command="{Binding ConfigurePagefileCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/>
                        <Button Content="Reset to default" Command="{Binding RevertPagefileCommand}"
                                Style="{StaticResource GhostButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Status line -->
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" Margin="2,14,0,0"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
