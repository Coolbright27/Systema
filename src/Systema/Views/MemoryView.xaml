<UserControl x:Class="Systema.Views.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Systema.Core.Converters"
             xmlns:ctl="clr-namespace:Systema.Controls"
             Background="Transparent">

    <!-- Windows 11 layout. The memory card is Task Manager's Performance > Memory view: title and
         installed size, a one-minute usage graph on a grid, the composition bar (segments explained
         on hover, as in Task Manager), and the figures underneath. The page file sits right under
         it, then the startup list reads like Settings > Apps > Startup. -->

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Task Manager's stat block: small grey label over a larger value -->
        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>
        <!-- The hardware facts on the right: "Speed:  3200 MT/s" -->
        <Style x:Key="HwLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Margin" Value="0,0,16,6"/>
        </Style>
        <Style x:Key="HwValue" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- One segment of the composition bar -->
        <Style x:Key="CompositionSegment" TargetType="Border">
            <Setter Property="BorderBrush" Value="#6660CDFF"/>
            <Setter Property="BorderThickness" Value="1,0,0,0"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,28">

            <!-- ===== HEADER ===== -->
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="Memory &amp; Startup" Style="{StaticResource HeadingLarge}"/>
                <TextBlock Text="See how your memory is doing and manage the apps that open when your PC starts."
                           Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- ===== MEMORY (Task Manager's Performance > Memory) ===== -->
            <Border Style="{StaticResource ListRowCard}" Padding="22,18,22,20" Margin="0,16,0,4">
                <StackPanel>

                    <!-- Title and installed size -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Memory" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding InstalledText}" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="20" FontWeight="SemiBold" VerticalAlignment="Bottom"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Grid>

                    <!-- Usage graph: the last minute, 0 at the bottom, all usable memory at the top -->
                    <Grid Margin="0,16,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Memory usage" Style="{StaticResource CaptionText}"/>
                        <TextBlock Grid.Column="1" Text="{Binding UsableText}" Style="{StaticResource CaptionText}"/>
                    </Grid>
                    <ctl:UsageGraph Height="160" Capacity="60"
                                    Values="{Binding UsageHistoryValues}"
                                    LineBrush="{StaticResource AccentBlueBrush}"
                                    FillBrush="#2E60CDFF" GridBrush="#1760CDFF" FrameBrush="#6660CDFF"/>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="60 seconds" Style="{StaticResource CaptionText}"/>
                        <TextBlock Grid.Column="1" Text="0" Style="{StaticResource CaptionText}"/>
                    </Grid>

                    <!-- Composition: In use | Modified | Standby | Free, hover a segment for what it means -->
                    <TextBlock Text="Memory composition" Style="{StaticResource CaptionText}" Margin="0,14,0,4"/>
                    <Border Height="32" BorderBrush="#6660CDFF" BorderThickness="1" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding InUseStar}"/>
                                <ColumnDefinition Width="{Binding ModifiedStar}"/>
                                <ColumnDefinition Width="{Binding StandbyStar}"/>
                                <ColumnDefinition Width="{Binding FreeStar}"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#4D60CDFF" ToolTip="{Binding InUseTip}"
                                    ToolTipService.InitialShowDelay="250"/>
                            <Border Grid.Column="1" Style="{StaticResource CompositionSegment}" Background="#3360CDFF"
                                    ToolTip="{Binding ModifiedTip}"/>
                            <Border Grid.Column="2" Style="{StaticResource CompositionSegment}" Background="#1760CDFF"
                                    ToolTip="{Binding StandbyTip}"/>
                            <Border Grid.Column="3" Style="{StaticResource CompositionSegment}" Background="Transparent"
                                    ToolTip="{Binding FreeTip}"/>
                        </Grid>
                    </Border>

                    <!-- Figures: two columns of label-over-value, hardware facts on the right -->
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="170"/>
                            <ColumnDefinition Width="Auto" MinWidth="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,24,14">
                            <TextBlock Text="In use (Compressed)" Style="{StaticResource StatLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding InUseText}" Style="{StaticResource StatValue}"/>
                                <TextBlock Text="{Binding CompressedText}" Style="{StaticResource StatValue}" Margin="6,0,0,0"
                                           Visibility="{Binding HasCompressed, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,24,14">
                            <TextBlock Text="Available" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding AvailableText}" Style="{StaticResource StatValue}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,24,14">
                            <TextBlock Text="Committed" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding CommittedText}" Style="{StaticResource StatValue}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,24,14">
                            <TextBlock Text="Cached" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding CachedText}" Style="{StaticResource StatValue}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Paged pool" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding PagedPoolText}" Style="{StaticResource StatValue}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,24,0">
                            <TextBlock Text="Non-paged pool" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding NonPagedPoolText}" Style="{StaticResource StatValue}"/>
                        </StackPanel>

                        <!-- Hardware (each line only when Windows reports it) -->
                        <Grid Grid.Row="0" Grid.RowSpan="3" Grid.Column="3" VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Speed:" Style="{StaticResource HwLabel}"
                                       Visibility="{Binding HasMemorySpeed, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding MemorySpeed}" Style="{StaticResource HwValue}"
                                       Visibility="{Binding HasMemorySpeed, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Row="1" Text="Slots used:" Style="{StaticResource HwLabel}"
                                       Visibility="{Binding HasSlotsUsed, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SlotsUsed}" Style="{StaticResource HwValue}"
                                       Visibility="{Binding HasSlotsUsed, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Row="2" Text="Form factor:" Style="{StaticResource HwLabel}"
                                       Visibility="{Binding HasFormFactor, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FormFactor}" Style="{StaticResource HwValue}"
                                       Visibility="{Binding HasFormFactor, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Row="3" Text="Hardware reserved:" Style="{StaticResource HwLabel}"
                                       Visibility="{Binding HasHardwareReserved, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding HardwareReserved}" Style="{StaticResource HwValue}"
                                       Visibility="{Binding HasHardwareReserved, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== VIRTUAL MEMORY (PAGE FILE), right under the memory it backs ===== -->
            <!-- Locked while Auto Pilot runs, exactly as before. -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAutoPilotActive}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="Opacity"   Value="0.4"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <ctl:SettingsCard Header="Virtual memory (page file)">
                    <ctl:SettingsCard.Description>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardDescription}">
                                Windows uses a file on disk as backup memory when RAM fills up. A fixed size avoids
                                stutter from resizing on the fly, and Windows decides lets it grow and shrink on its
                                own. Most people can leave this alone. Requires a restart.
                            </TextBlock>
                            <TextBlock Text="{Binding CurrentPagefileText}" Style="{StaticResource CardNoteGood}"/>
                            <TextBlock Text="{Binding RecommendedPagefileText}" Style="{StaticResource CardNote}"
                                       Foreground="{StaticResource AccentBlueBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </ctl:SettingsCard.Description>
                    <!-- Pick a size, then Apply (it lights up only when the choice differs from
                         what's set). "Windows decides" is Windows' own default, so there's no
                         separate reset button. -->
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="200" Style="{StaticResource DarkComboBox}" VerticalAlignment="Center"
                                  ItemsSource="{Binding PagefileOptions}" DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedPagefileOption, Mode=TwoWay}"/>
                        <Button Content="Apply" Command="{Binding ConfigurePagefileCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </ctl:SettingsCard>
            </StackPanel>

            <!-- ===== STARTUP ===== -->
            <TextBlock Text="Startup" Style="{StaticResource SettingsGroupHeader}"/>

            <!-- Speed-up recommendation: outlined in the accent so it stands out from the list -->
            <ctl:SettingsCard Header="Speed up your startup" BorderBrush="{StaticResource AccentBlueBrush}"
                              Visibility="{Binding HasStartupRecommendation, Converter={StaticResource BoolToVis}}">
                <ctl:SettingsCard.Description>
                    <StackPanel>
                        <TextBlock Text="{Binding StartupRecommendationText}" Style="{StaticResource CardDescription}"
                                   Foreground="{StaticResource AccentBlueBrush}" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource CardNote}">
                            <Run Text="These apps make your PC slower to get ready after you turn it on: "/>
                            <Run Text="{Binding HighImpactNames, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Run Text=". You can still open them anytime."/>
                        </TextBlock>
                    </StackPanel>
                </ctl:SettingsCard.Description>
                <Button Content="Turn them all off" Command="{Binding DisableHeavyStartupCommand}"
                        Style="{StaticResource PrimaryButton}"/>
            </ctl:SettingsCard>

            <!-- All startup apps -->
            <TextBlock Text="All startup apps" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="2,14,0,2"/>
            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="2,0,0,8">
                <Run Text="These open automatically with Windows. Turning off the heavy ones makes your PC ready faster. The colored tag shows how much each one slows you down."/>
            </TextBlock>

            <ItemsControl ItemsSource="{Binding StartupItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ListRowCard}" ToolTip="{Binding Command}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Name + publisher -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Publisher}" Style="{StaticResource CaptionText}"
                                               TextTrimming="CharacterEllipsis" Opacity="0.7" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Impact badge -->
                                <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="4" Padding="8,3"
                                        Margin="0,0,20,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#2222C55E"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ImpactLabel}" Value="High">
                                                    <Setter Property="Background" Value="#22EF4444"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ImpactLabel}" Value="Medium">
                                                    <Setter Property="Background" Value="#22F59E0B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                                <Setter Property="Text"       Value="Low impact"/>
                                                <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ImpactLabel}" Value="High">
                                                        <Setter Property="Text"       Value="High impact"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ImpactLabel}" Value="Medium">
                                                        <Setter Property="Text"       Value="Medium impact"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AccentYellowBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <!-- Switch -->
                                <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                          Command="{Binding DataContext.ToggleStartupItemCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Status line -->
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" Margin="2,14,0,0"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
