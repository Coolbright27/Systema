<UserControl x:Class="Systema.Views.NvidiaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Systema.Core.Converters"
             xmlns:ctl="clr-namespace:Systema.Controls"
             Background="Transparent">

    <!-- Windows 11 Settings layout: one SettingsCard per driver setting, grouped under headers.
         Same bindings and text as before; only the layout changed. -->

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Mode name plus a short hint, same shape as the Dell thermal selector. The hint shows
             in the open list only: the closed box has no ComboBoxItem above it, so the trigger
             hides the hint there and the mode name is never cut off. -->
        <DataTemplate x:Key="PowerModeItemTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Note, StringFormat='({0})'}"
                           FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,28">

            <!-- ===== HEADER ===== -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="NVIDIA graphics" Style="{StaticResource HeadingLarge}"/>
                    <TextBlock Text="{Binding AdapterName}" Style="{StaticResource CaptionText}"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Open NVIDIA Control Panel"
                            Style="{StaticResource GhostButton}" Padding="14,8" Margin="0,0,8,0"
                            Command="{Binding OpenControlPanelCommand}"/>
                    <Button Content="Re-detect"
                            Style="{StaticResource GhostButton}" Padding="14,8"
                            Command="{Binding DetectCommand}"/>
                </StackPanel>
            </Grid>

            <!-- ===== REBOOT HINT (Windows 11 informational bar) ===== -->
            <Border Margin="0,12,0,0" Padding="14,10" CornerRadius="6" Background="{DynamicResource AccentAlpha10Brush}"
                    BorderBrush="{DynamicResource AccentAlpha20Brush}" BorderThickness="1"
                    Visibility="{Binding ShowRebootHint, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x24D8;" FontSize="14" Foreground="{DynamicResource AccentBlueBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="NVIDIA power changes take effect after you restart your PC."/>
                </StackPanel>
            </Border>

            <!-- ══════════════ POWER ══════════════ -->
            <TextBlock Text="Power" Style="{StaticResource SettingsGroupHeader}"/>

            <!-- ===== GPU Power Management (PowerMizer / render-standby equivalent) ===== -->
            <ctl:SettingsCard Header="GPU power management (similar to RC6)" RecommendKey="NvidiaPowerManagement">
                <ctl:SettingsCard.Description>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardDescription}">
                            Controls how the NVIDIA GPU manages power when it's idle. This is the PowerMizer state,
                            NVIDIA's take on Intel's RC6 render standby, and it's a driver-registry setting
                            <Run FontWeight="SemiBold">the NVIDIA Control Panel doesn't expose</Run>. On lets the GPU
                            idle down to save power and run cooler, which is the driver default. Off forces "prefer
                            maximum performance," so it holds full clocks all the time, on both AC and battery.
                            <Run FontStyle="Italic">Takes effect after a restart.</Run>
                        </TextBlock>
                        <!-- Laptops only: a desktop is recommended Off (see the pill). -->
                        <TextBlock Style="{StaticResource CardNoteWarn}"
                                   Visibility="{Binding IsLaptop, Converter={StaticResource BoolToVis}}"
                                   Text="On a laptop, full clocks make more heat and drain more battery than the cooling can keep up with, so turning this Off often causes thermal throttling that makes things slower, not faster."/>
                        <TextBlock Style="{StaticResource CardNote}">
                            <Run Text="Current: "/><Run Text="{Binding PowerSavingDetected, Mode=OneWay}"
                                 Foreground="{DynamicResource AccentGreenBrush}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>
                </ctl:SettingsCard.Description>
                <StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                              IsChecked="{Binding PowerSavingOn, Mode=TwoWay}"/>
                    <Button Content="Reset to default" Style="{StaticResource GhostButton}"
                            Margin="0,8,0,0" HorizontalAlignment="Right" FontSize="11" Padding="10,4"
                            Command="{Binding ResetSettingCommand}" CommandParameter="PowerManagement"/>
                </StackPanel>
            </ctl:SettingsCard>

            <!-- ===== POWER MANAGEMENT MODE =====
                 One group: the setting on top, its plugged-in and battery pickers as rows under it. -->
            <Border Style="{StaticResource ExpanderCard}">
            <StackPanel>
            <ctl:SettingsCard Header="Power management mode" Badge="Experimental"
                              Style="{StaticResource ExpanderHeaderCard}">
                <ctl:SettingsCard.Description>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardDescription}">
                            The same dropdown as Power management mode in the NVIDIA app's global settings. Optimal power
                            lets the card drop its clocks whenever it can, Normal leaves the decision to the driver, and
                            Prefer maximum performance holds full clocks all the time.
                            <Run FontStyle="Italic">Applies straight away, no restart needed.</Run>
                        </TextBlock>
                        <TextBlock Style="{StaticResource CardNote}"
                                   Text="Experimental: this one is still being tested. It might change, or be removed in a future update."/>

                        <!-- Laptops only. On a thin chassis the fastest setting is often the slowest one:
                             holding full clocks makes heat the cooler cannot shift, the card throttles, and
                             the user ends up below where Optimal power would have left them. -->
                        <Border Margin="0,10,0,0" Padding="12,8" CornerRadius="4" Background="{DynamicResource CautionAlpha10Brush}"
                                MaxWidth="680" HorizontalAlignment="Left"
                                Visibility="{Binding IsLaptop, Converter={StaticResource BoolToVis}}">
                            <TextBlock TextWrapping="Wrap"
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{DynamicResource AccentYellowBrush}">
                                On a laptop, more power does not always mean more speed. Holding full clocks makes
                                a lot of heat, and once the chassis gets hot the card throttles itself to cool down,
                                so you can end up slower than Optimal power would have been. Save Prefer maximum
                                performance for laptops that cool well and have room to breathe. On a bed, a couch,
                                or a cramped desk, the gentler settings usually run faster.
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </ctl:SettingsCard.Description>
            </ctl:SettingsCard>

            <!-- Plugged in / desktop -->
            <ctl:SettingsCard Header="When plugged in" Description="Used on AC power, and always on a desktop."
                              RecommendKey="NvidiaModePluggedIn"
                              Style="{StaticResource ExpanderItem}">
                <ComboBox Width="300" Style="{StaticResource DarkComboBox}"
                          ItemsSource="{Binding PowerModeOptions}"
                          ItemTemplate="{StaticResource PowerModeItemTemplate}"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding PowerModeAc, Mode=TwoWay}"/>
            </ctl:SettingsCard>

            <!-- On battery: laptops only -->
            <Grid Visibility="{Binding IsLaptop, Converter={StaticResource BoolToVis}}">
                <ctl:SettingsCard Header="On battery" Style="{StaticResource ExpanderItem}" RecommendKey="NvidiaModeBattery"
                                  Description="Used when you're unplugged. Optimal power is usually the right pick here, since full clocks on battery mostly make heat and drain runtime.">
                    <ComboBox Width="300" Style="{StaticResource DarkComboBox}"
                              ItemsSource="{Binding PowerModeOptions}"
                              ItemTemplate="{StaticResource PowerModeItemTemplate}"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding PowerModeBattery, Mode=TwoWay}"/>
                </ctl:SettingsCard>
            </Grid>
            </StackPanel>
            </Border>

            <!-- ══════════════ FRAME RATE ══════════════ -->
            <StackPanel Visibility="{Binding IsFpsCapAvailable, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Frame rate" Style="{StaticResource SettingsGroupHeader}"/>

                <ctl:SettingsCard Header="Max frame rate (FPS cap)" RecommendKey="NvidiaFpsCap">
                    <ctl:SettingsCard.Description>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardDescription}">
                                Caps your framerate driver-wide with NVIDIA's own frame limiter, the
                                <Run FontWeight="SemiBold">same setting the NVIDIA app uses</Run> for Max Frame Rate.
                                A cap near your refresh rate cuts GPU heat, fan noise, and power draw with no visible
                                downside. Allowed range is 20 to 999. Set it to 0 (or click Reset) to remove the cap.
                            </TextBlock>

                            <!-- Real current value, read live from the driver -->
                            <TextBlock Style="{StaticResource CardNote}">
                                <Run Text="{Binding FpsCapCurrentText, Mode=OneWay}"
                                     Foreground="{DynamicResource AccentGreenBrush}" FontWeight="SemiBold"/>
                            </TextBlock>

                            <TextBlock Text="FPS cap  (20 to 999, or 0 for off)" Style="{StaticResource CaptionText}" Margin="0,14,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="110"
                                         Text="{Binding FpsCapInput, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DarkTextBox}"/>
                                <Button Content="Monitor refresh rate" Command="{Binding UseMonitorRefreshCommand}"
                                        Style="{StaticResource GhostButton}" Padding="12,8" Margin="8,0,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Apply" Command="{Binding ApplyFpsCapCommand}"
                                        Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                                <Button Content="Reset" Command="{Binding ResetFpsCapCommand}"
                                        Style="{StaticResource GhostButton}"/>
                            </StackPanel>
                        </StackPanel>
                    </ctl:SettingsCard.Description>
                </ctl:SettingsCard>
            </StackPanel>

            <!-- ══════════════ KEEP YOUR SETTINGS + REVERT ALL ══════════════ -->
            <TextBlock Text="Keep your settings" Style="{StaticResource SettingsGroupHeader}"/>

            <ctl:SettingsCard Header="Re-apply after driver updates"
                              Description="NVIDIA driver updates can wipe this setting. When on, Systema re-applies your choice a few seconds after startup.">
                <CheckBox Style="{StaticResource ToggleSwitch}"
                          IsChecked="{Binding ReapplyAfterDriverUpdate, Mode=TwoWay}"/>
            </ctl:SettingsCard>

            <ctl:SettingsCard Header="Revert all"
                              Description="Restore every NVIDIA power setting to the driver's defaults.">
                <Button Content="Revert all NVIDIA settings to default"
                        Style="{StaticResource GhostButton}" Padding="14,8"
                        Command="{Binding RevertAllCommand}"/>
            </ctl:SettingsCard>

            <!-- ===== STATUS ===== -->
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="2,14,0,0"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
