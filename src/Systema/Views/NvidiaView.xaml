<UserControl x:Class="Systema.Views.NvidiaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Systema.Core.Converters"
             Background="Transparent">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,28">

            <!-- ===== HEADER ===== -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Nvidia Graphics" Style="{StaticResource HeadingLarge}"/>
                    <TextBlock Text="{Binding AdapterName}" Style="{StaticResource CaptionText}"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Open NVIDIA Control Panel"
                            Style="{StaticResource GhostButton}" Padding="14,8" Margin="0,0,8,0"
                            Command="{Binding OpenControlPanelCommand}"/>
                    <Button Content="Re-detect"
                            Style="{StaticResource GhostButton}" Padding="14,8"
                            Command="{Binding DetectCommand}"/>
                </StackPanel>
            </Grid>

            <!-- ===== REBOOT HINT ===== -->
            <Border Margin="0,0,0,16" Padding="12,8" CornerRadius="6" Background="#1A4F8DF7"
                    Visibility="{Binding ShowRebootHint, Converter={StaticResource BoolToVis}}">
                <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionText}"
                           Foreground="{StaticResource AccentBlueBrush}"
                           Text="NVIDIA power changes take effect after you restart your PC."/>
            </Border>

            <!-- ===== CARD: GPU Power Management (PowerMizer / render-standby equivalent) ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Text="GPU Power Management (Similar to RC6)" Style="{StaticResource HeadingMedium}" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="560">
                            Controls how the NVIDIA GPU manages power when idle (the PowerMizer state — NVIDIA's
                            equivalent of Intel's RC6 render standby). It's a driver-registry setting
                            <Run FontWeight="SemiBold">not exposed in the NVIDIA Control Panel</Run>. On lets the GPU
                            idle down to save power and run cooler (the driver default); Off forces "prefer maximum
                            performance" — full clocks all the time, on both AC and battery.
                            <Run FontStyle="Italic">Takes effect after a restart.</Run>
                        </TextBlock>
                        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="560" Margin="0,8,0,0"
                                   Foreground="{StaticResource AccentYellowBrush}"
                                   Text="Recommended On for laptops — full clocks make more heat and drain more battery than a thermally-limited laptop can sustain, so turning it Off often causes thermal throttling that makes things slower, not faster."/>
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource CaptionText}">
                            <Run Text="Current: "/><Run Text="{Binding PowerSavingDetected, Mode=OneWay}"
                                 Foreground="{StaticResource AccentGreenBrush}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                  IsChecked="{Binding PowerSavingOn, Mode=TwoWay}"/>
                        <Button Content="Reset to Default" Style="{StaticResource GhostButton}"
                                Margin="0,8,0,0" HorizontalAlignment="Right" FontSize="11" Padding="10,4"
                                Command="{Binding ResetSettingCommand}" CommandParameter="PowerManagement"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== PERSISTENCE + REVERT ALL ===== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="Re-apply after driver updates" Style="{StaticResource HeadingMedium}" Margin="0,0,0,4"/>
                            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="560"
                                       Text="NVIDIA driver updates can wipe this setting. When on, Systema re-applies your choice a few seconds after startup."/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                  IsChecked="{Binding ReapplyAfterDriverUpdate, Mode=TwoWay}"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,4,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0"
                                   TextWrapping="Wrap" Style="{StaticResource CaptionText}"
                                   Text="Restore every NVIDIA power setting to the driver's defaults."/>
                        <Button Grid.Column="1" Content="Revert All Nvidia Settings to Default"
                                Style="{StaticResource GhostButton}" Padding="14,8"
                                Command="{Binding RevertAllCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== STATUS ===== -->
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}"
                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="2,14,0,0"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
