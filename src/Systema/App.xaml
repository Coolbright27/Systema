<Application x:Class="Systema.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Systema.Core.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Slot 0 is the palette. ThemeManager replaces it with Palette.Light.xaml when
                     Windows is in light mode (and swaps it live when that changes). -->
                <ResourceDictionary Source="Resources/Themes/Palette.Dark.xaml"/>
                <ResourceDictionary Source="Resources/Themes/Dark.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Global converters -->
            <conv:BoolToVisibilityConverter x:Key="GlobalBoolToVis"/>
            <conv:SafetyLevelToColorConverter x:Key="GlobalSafetyColor"/>
            <conv:SafetyLevelToBadgeConverter x:Key="GlobalSafetyBadge"/>
            <conv:EqualityConverter x:Key="GlobalEquality"/>

            <!-- The SystemColors.WindowBrushKey override (ComboBox popups) now lives in each
                 palette, so it follows the theme. It must stay at app scope, never in a style's
                 Resources setter (that threw a XamlParseException once). -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
