<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Systema.Core.Converters">

    <!-- ============================================================ -->
    <!--  COLORS — cool charcoal system palette                        -->
    <!--  Surfaces climb in three steps only: base → chrome → panel,   -->
    <!--  each a few percent lighter, so nothing needs a bright        -->
    <!--  outline to separate it.                                      -->
    <!--  ONE accent (sky) carries every interactive element. Green /  -->
    <!--  amber / red are STATUS ONLY — never decoration.              -->
    <!-- ============================================================ -->
    <Color x:Key="BgPrimaryColor">#111315</Color>   <!-- Rich Charcoal — app base      -->
    <Color x:Key="BgSurfaceColor">#171A1D</Color>   <!-- Graphite — title bar, inputs  -->
    <Color x:Key="BgSidebarColor">#171A1D</Color>   <!-- Graphite — nav chrome         -->
    <Color x:Key="BgCardColor">#1E2227</Color>      <!-- Dark Slate — elevated panels  -->
    <Color x:Key="AccentBlueColor">#38BDF8</Color>  <!-- the single accent             -->
    <Color x:Key="AccentGreenColor">#22C55E</Color> <!-- success                       -->
    <Color x:Key="AccentYellowColor">#F59E0B</Color><!-- warning                       -->
    <Color x:Key="AccentRedColor">#EF4444</Color>   <!-- error                         -->
    <Color x:Key="TextPrimaryColor">#F3F5F7</Color>
    <Color x:Key="TextSecondaryColor">#B4BEC8</Color>
    <Color x:Key="TextTertiaryColor">#88919C</Color>
    <Color x:Key="DisabledColor">#5F6873</Color>
    <Color x:Key="BorderColor">#2E343B</Color>
    <Color x:Key="HoverColor">#252B31</Color>

    <SolidColorBrush x:Key="BgPrimaryBrush" Color="{StaticResource BgPrimaryColor}"/>
    <SolidColorBrush x:Key="BgSurfaceBrush" Color="{StaticResource BgSurfaceColor}"/>
    <SolidColorBrush x:Key="BgSidebarBrush" Color="{StaticResource BgSidebarColor}"/>
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}"/>
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlueColor}"/>
    <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreenColor}"/>
    <SolidColorBrush x:Key="AccentYellowBrush" Color="{StaticResource AccentYellowColor}"/>
    <SolidColorBrush x:Key="AccentRedBrush" Color="{StaticResource AccentRedColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}"/>
    <SolidColorBrush x:Key="DisabledBrush" Color="{StaticResource DisabledColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent"/>

    <!-- ============================================================ -->
    <!--  TYPOGRAPHY — Windows 11 (Segoe UI Variable + Fluent ramp)   -->
    <!-- ============================================================ -->
    <!-- Segoe UI Variable is Win11's UI face and ships in THREE optical sizes.
         Using the right one per size is what makes text look native rather than
         merely "scaled": Display is drawn for large headings (tighter, more
         contrast), Text for reading sizes, Small for 12px and under (opened-up
         spacing so it stays legible). Every family falls back to plain Segoe UI,
         so Windows 10 machines simply keep the old face — nothing breaks.
         Verified on Win11: all three resolve in WPF with real Light/Normal/
         SemiBold/Bold weights, so nothing is faux-bolded. -->
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="MainFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="SmallFont">Segoe UI Variable Small, Segoe UI</FontFamily>

    <!-- Sizes follow the Fluent type ramp. LineHeight is set explicitly with
         BlockLineHeight so vertical rhythm is consistent instead of inherited
         from each glyph run. -->

    <!-- Fluent "Title" — page headings -->
    <Style x:Key="HeadingLarge" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="36"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- Fluent "Subtitle" — card / section headings -->
    <Style x:Key="HeadingMedium" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="24"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- Fluent "Body Strong" — inline emphasis / small headings -->
    <Style x:Key="HeadingSmall" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="20"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- Fluent "Body" -->
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="LineHeight" Value="20"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <!-- Left-align so a MaxWidth-constrained block stays under its heading instead of
             being centered in a wider slot (WPF centers Stretch elements past MaxWidth).
             An explicit HorizontalAlignment on the element still overrides this. -->
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- Fluent "Caption" — uses the Small optical size -->
    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SmallFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="LineHeight" Value="16"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- ============================================================ -->
    <!--  PRIMARY BUTTON                                              -->
    <!-- ============================================================ -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
        <Setter Property="Foreground" Value="#0D0F14"/>
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- STATE LAYER pattern: hover/press are a white veil faded in over the
                         button rather than a second hard-coded colour. It works over any
                         background (primary, danger, custom), so no per-variant hover tint
                         has to be kept in sync with the palette, and fading Opacity avoids
                         animating a shared SolidColorBrush (WPF freezes those). -->
                    <Grid x:Name="Wrap">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderBrush="Transparent" BorderThickness="2"/>
                        <Border x:Name="State" CornerRadius="8" Background="#FFFFFF"
                                Opacity="0" IsHitTestVisible="False"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="State"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.12" Duration="0:0:0.13"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="State"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.13"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- Press stays instant: delayed feedback on click feels broken. -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Wrap" Property="Opacity" Value="0.80"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource DisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!--  DANGER BUTTON                                               -->
    <!-- ============================================================ -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{StaticResource AccentRedBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <!-- No hover override needed: the inherited state layer tints whatever
             background this button has, so danger red animates like every other. -->
    </Style>

    <!-- ============================================================ -->
    <!--  EXPANDER BUTTON  (transparent, borderless section header)   -->
    <!-- ============================================================ -->
    <Style x:Key="ExpanderButton" TargetType="Button">
        <Setter Property="Background"                 Value="Transparent"/>
        <Setter Property="BorderThickness"            Value="0"/>
        <Setter Property="Padding"                    Value="0"/>
        <Setter Property="Cursor"                     Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="bg" Background="#FFFFFF" Opacity="0"
                                CornerRadius="8" IsHitTestVisible="False"/>
                        <ContentPresenter HorizontalAlignment="Stretch"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="bg"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.05" Duration="0:0:0.13"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="bg"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.13"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!--  GHOST BUTTON                                                -->
    <!-- ============================================================ -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Wrap">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"/>
                        <Border x:Name="State" CornerRadius="8" Background="#FFFFFF"
                                Opacity="0" IsHitTestVisible="False"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="State"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.07" Duration="0:0:0.13"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="State"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.13"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Wrap" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Wrap" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!--  CARD / SURFACE PANEL                                        -->
    <!-- ============================================================ -->
    <Style x:Key="Card" TargetType="Border">
        <!-- Opaque elevated panel, ~6% lighter than the app base. No translucency
             (there is no backdrop to reveal) and no shadow — the small lift in
             lightness plus the hairline border is the whole separation. -->
        <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <!-- ============================================================ -->
    <!--  TOGGLE SWITCH (CheckBox styled)                             -->
    <!-- ============================================================ -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel x:Name="Root" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="Track" Width="44" Height="24" CornerRadius="12"
                                Background="{StaticResource BorderBrush}" Cursor="Hand"
                                BorderBrush="Transparent" BorderThickness="2">
                            <Grid>
                                <!-- Accent fill faded in when checked. Layering an opaque
                                     accent over the dark track means the "on" colour is an
                                     Opacity animation, never a SolidColorBrush colour
                                     animation (shared theme brushes are frozen). -->
                                <Border x:Name="TrackOn" CornerRadius="10"
                                        Background="{StaticResource AccentBlueBrush}" Opacity="0"/>
                                <!-- ONE thumb that slides, the way the Win11 toggle behaves -->
                                <Border x:Name="Thumb" Width="16" Height="16" CornerRadius="8"
                                        Background="#FFFFFF" Opacity="0.72"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Margin="2,0,0,0">
                                    <Border.RenderTransform>
                                        <TranslateTransform X="0"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <!-- Track inner width is 40 (44 less the 2px border each side); the
                             thumb spans x=2..18, so its travel to the right edge is 20px. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="20" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TrackOn"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.16"/>
                                        <DoubleAnimation Storyboard.TargetName="Thumb"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.16"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="0" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TrackOn"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16"/>
                                        <DoubleAnimation Storyboard.TargetName="Thumb"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.72" Duration="0:0:0.16"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <!-- Keyboard focus ring -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                        </Trigger>
                        <!-- Disabled: dim the whole control so it reads as non-interactive -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root"   Property="Opacity" Value="0.4"/>
                            <Setter TargetName="Track"  Property="Cursor"  Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- ============================================================ -->
    <!--  LISTVIEW / DATAGRID                                         -->
    <!-- ============================================================ -->
    <Style x:Key="DarkListView" TargetType="ListView">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="DarkListViewItem" TargetType="ListViewItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="4" Margin="0,1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#2E343B"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!--  SCROLLBAR                                                   -->
    <!-- ============================================================ -->
    <!-- Reusable thumb: rounded pill that brightens on hover/drag and never
         shrinks below a usable size on very long content (MinHeight/MinWidth). -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBorder" Background="#2E343B" CornerRadius="3"
                            MinHeight="24" MinWidth="6"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="#3D4650"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="#4A5560"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid>
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- Horizontal orientation: swap the dimensions and un-reverse the track
             so dark-themed horizontal bars match (previously fell back to white
             Win11 chrome). -->
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid>
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================ -->
    <!--  COMBOBOX                                                     -->
    <!-- ============================================================ -->
    <!--
        DarkComboBox needs a full custom ControlTemplate. Without it, the default
        WPF/Win11 ComboBox theme renders white chrome regardless of the Background
        setter — which made selected DNS profile text appear white-on-white in
        System Tweaks. The template below draws its own dark border + dark
        selection content presenter + dark popup so theming is consistent.

        DO NOT add `<Setter Property="Resources">` here. FrameworkElement.Resources
        is a plain CLR property, not a DependencyProperty, so WPF's BAML reader
        rejects it with ArgumentNullException during template load and crashes
        the entire view (the v1.7.72/73 System Tweaks crash). The
        SystemColors.WindowBrushKey override for popup background is in App.xaml.
    -->
    <Style x:Key="DarkComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource BgSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!-- Hidden ToggleButton spans the whole control so any click opens the popup -->
                        <ToggleButton x:Name="ToggleButton"
                                      Grid.Column="2"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Chrome"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                            </Grid.ColumnDefinitions>
                                            <Path x:Name="Arrow"
                                                  Grid.Column="1"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="{StaticResource TextSecondaryBrush}"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <!-- Background passes through TemplatedParent.Background -->
                            <ToggleButton.Background>
                                <Binding Path="Background" RelativeSource="{RelativeSource TemplatedParent}"/>
                            </ToggleButton.Background>
                            <ToggleButton.BorderBrush>
                                <Binding Path="BorderBrush" RelativeSource="{RelativeSource TemplatedParent}"/>
                            </ToggleButton.BorderBrush>
                            <ToggleButton.BorderThickness>
                                <Binding Path="BorderThickness" RelativeSource="{RelativeSource TemplatedParent}"/>
                            </ToggleButton.BorderThickness>
                        </ToggleButton>

                        <!-- Selected item display — dark text on dark background -->
                        <ContentPresenter x:Name="ContentSite"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          Margin="10,6,28,6"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"/>

                        <!-- Dropdown popup -->
                        <Popup x:Name="Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Grid x:Name="DropDown"
                                  SnapsToDevicePixels="True"
                                  MinWidth="{TemplateBinding ActualWidth}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border x:Name="DropDownBorder"
                                        Background="{StaticResource BgSurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"/>
                                <ScrollViewer Margin="2"
                                              SnapsToDevicePixels="True"
                                              VerticalScrollBarVisibility="Auto">
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- Dark-themed dropdown items -->
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Background" Value="{StaticResource BgSurfaceBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                    <Setter Property="Padding" Value="10,6"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="ItemBorder"
                                        Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}"
                                        CornerRadius="2">
                                    <ContentPresenter
                                        TextElement.Foreground="{TemplateBinding Foreground}"
                                        TextElement.FontFamily="{TemplateBinding FontFamily}"
                                        TextElement.FontSize="{TemplateBinding FontSize}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <!-- ORDER MATTERS. IsSelected must come FIRST so that when an
                                         item is both selected and highlighted (which is exactly what
                                         happens the moment the dropdown opens) IsHighlighted wins and
                                         sets BOTH background and foreground. With the order reversed,
                                         IsSelected replaced only the background and left the dark
                                         highlight foreground behind — dark text on a dark row. -->
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource HoverBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                                        <Setter Property="Foreground" Value="#0D0F14"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- IMPLICIT ComboBox style — every ComboBox gets the dark theme automatically.
         Without this, a ComboBox that forgets Style="{StaticResource DarkComboBox}"
         falls back to WPF's built-in template, whose dropdown items draw with the
         system control-text colour (black). Because App.xaml overrides
         SystemColors.WindowBrushKey to a dark brush so popups aren't white, that
         combination rendered black text on a black popup — unreadable. Making the
         style implicit means a ComboBox added later cannot reintroduce the bug. -->
    <Style TargetType="ComboBox" BasedOn="{StaticResource DarkComboBox}"/>

    <!-- ============================================================ -->
    <!--  TITLE-BAR CLOSE BUTTON                                      -->
    <!-- ============================================================ -->
    <!-- Win11 caption proportions with the familiar red hover. The glyph is a
         vector Path, not the "✕" character, so it stays perfectly crisp and
         evenly weighted at any DPI instead of depending on font hinting. The red
         is a state layer faded in (same approach as the other buttons) rather
         than a background swap, so it eases in and needs no colour animation. -->
    <Style x:Key="CaptionCloseButton" TargetType="Button">
        <Setter Property="Width"  Value="44"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Fill" Background="#C42B1C" Opacity="0" CornerRadius="8"/>
                        <Path x:Name="Glyph"
                              Data="M 0,0 L 10,10 M 10,0 L 0,10"
                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.25"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glyph" Property="Stroke" Value="#FFFFFF"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fill"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.13"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fill"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.13"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="#A82318"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!--  SEPARATOR                                                   -->
    <!-- ============================================================ -->
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="0,8"/>
    </Style>

    <!-- ============================================================ -->
    <!--  PROGRESS BAR                                                -->
    <!-- ============================================================ -->
    <Style x:Key="AccentProgressBar" TargetType="ProgressBar">
        <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
        <Setter Property="Height" Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="3" Height="6">
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                HorizontalAlignment="Left" CornerRadius="3"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!--  SIDEBAR NAV BUTTON                                          -->
    <!-- ============================================================ -->
    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- Left accent bar — only visible when active -->
                        <Border x:Name="AccentBar"
                                Width="3" CornerRadius="0,2,2,0"
                                Background="{StaticResource AccentBlueBrush}"
                                HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                Opacity="0"/>
                        <!-- Main button body, inset slightly to clear the accent bar -->
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}"
                                Margin="4,0,0,0">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <!-- Keyboard focus: reuse the sidebar's own visual language — a
                             soft background highlight + the left accent bar — instead of
                             a hard blue outline box, which clashed with the flat nav. -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg"        Property="Background" Value="{StaticResource HoverBrush}"/>
                            <Setter TargetName="AccentBar" Property="Opacity"    Value="0.6"/>
                            <Setter Property="Foreground"  Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="1"/>
                        </Trigger>
                        <!-- Show left accent bar when this nav button is the active section -->
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <MultiBinding>
                                    <MultiBinding.Converter>
                                        <conv:EqualityConverter/>
                                    </MultiBinding.Converter>
                                    <Binding Path="DataContext.ActiveSection"
                                             RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Tag"/>
                                </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter TargetName="AccentBar" Property="Opacity" Value="1"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Active state: section name (Tag) matches DataContext.ActiveSection -->
            <DataTrigger Value="True">
                <DataTrigger.Binding>
                    <MultiBinding>
                        <MultiBinding.Converter>
                            <conv:EqualityConverter/>
                        </MultiBinding.Converter>
                        <Binding Path="DataContext.ActiveSection"
                                 RelativeSource="{RelativeSource AncestorType=Window}"/>
                        <Binding RelativeSource="{RelativeSource Self}" Path="Tag"/>
                    </MultiBinding>
                </DataTrigger.Binding>
                <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================ -->
    <!--  TEXTBOX                                                     -->
    <!-- ============================================================ -->
    <Style x:Key="DarkTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BgSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CaretBrush" Value="{StaticResource AccentBlueBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBlueBrush}"/>
        <Setter Property="SelectionOpacity" Value="0.35"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!--  SECTION LABEL  (uppercase category headers)                 -->
    <!-- ============================================================ -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- ============================================================ -->
    <!--  STATUS PILL  (small inline status badges)                   -->
    <!-- ============================================================ -->
    <Style x:Key="StatusPillGreen" TargetType="Border">
        <Setter Property="Background" Value="#16231B"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,2"/>
    </Style>

    <Style x:Key="StatusPillRed" TargetType="Border">
        <Setter Property="Background" Value="#251A1C"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,2"/>
    </Style>

    <Style x:Key="StatusPillGray" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,2"/>
    </Style>

    <!-- ============================================================ -->
    <!--  HELPER / INFORMATIONAL TEXT  (muted blue)                   -->
    <!--  Use this for status messages, hints, and supporting info    -->
    <!--  text — NOT for primary content. Examples: "Active plan: X", -->
    <!--  "Battery pause is supported", recommended-value hints.      -->
    <!-- ============================================================ -->
    <Style x:Key="HelperText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
        <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
    </Style>

</ResourceDictionary>
