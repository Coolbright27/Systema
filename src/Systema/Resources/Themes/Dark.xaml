<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Systema.Core.Converters"
                    xmlns:ctl="clr-namespace:Systema.Controls">

    <!-- ============================================================ -->
    <!--  COLORS — Windows 11 dark                                     -->
    <!--  Neutral greys with no hue bias, matching the Windows 11      -->
    <!--  Settings app: #202020 window, #2B2B2B cards, and the system  -->
    <!--  default dark accent #60CDFF. Green / amber / red stay STATUS -->
    <!--  ONLY and are unchanged, because pages tint them by hand.     -->
    <!--  Every key below existed before the overhaul and keeps its    -->
    <!--  meaning; only the values moved. New keys are additive.       -->
    <!-- ============================================================ -->
    <Color x:Key="BgPrimaryColor">#202020</Color>   <!-- window base, title bar, nav pane -->
    <Color x:Key="BgSurfaceColor">#2D2D2D</Color>   <!-- inputs and inset boxes           -->
    <Color x:Key="BgSidebarColor">#202020</Color>   <!-- nav pane sits on the window base -->
    <Color x:Key="BgCardColor">#2B2B2B</Color>      <!-- settings cards                   -->
    <Color x:Key="AccentBlueColor">#60CDFF</Color>  <!-- Windows 11 default dark accent   -->
    <Color x:Key="AccentGreenColor">#22C55E</Color> <!-- success                          -->
    <Color x:Key="AccentYellowColor">#F59E0B</Color><!-- warning                          -->
    <Color x:Key="AccentRedColor">#EF4444</Color>   <!-- error                            -->
    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#C8C8C8</Color>
    <Color x:Key="TextTertiaryColor">#9A9A9A</Color>
    <Color x:Key="DisabledColor">#6B6B6B</Color>
    <Color x:Key="BorderColor">#353535</Color>
    <Color x:Key="HoverColor">#333333</Color>

    <SolidColorBrush x:Key="BgPrimaryBrush" Color="{StaticResource BgPrimaryColor}"/>
    <SolidColorBrush x:Key="BgSurfaceBrush" Color="{StaticResource BgSurfaceColor}"/>
    <SolidColorBrush x:Key="BgSidebarBrush" Color="{StaticResource BgSidebarColor}"/>
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}"/>
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlueColor}"/>
    <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreenColor}"/>
    <SolidColorBrush x:Key="AccentYellowBrush" Color="{StaticResource AccentYellowColor}"/>
    <SolidColorBrush x:Key="AccentRedBrush" Color="{StaticResource AccentRedColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}"/>
    <SolidColorBrush x:Key="DisabledBrush" Color="{StaticResource DisabledColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent"/>

    <!-- Windows 11 control layers. The fills are translucent white, the way WinUI defines
         them, so a button or input reads correctly on the window base AND on a card without
         needing a second colour for each surface. -->
    <SolidColorBrush x:Key="TextOnAccentBrush"      Color="#000000"/>   <!-- text on accent fills -->
    <SolidColorBrush x:Key="ControlFillBrush"       Color="#0FFFFFFF"/> <!-- buttons, inputs      -->
    <SolidColorBrush x:Key="ControlFillHoverBrush"  Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="ControlStrokeBrush"     Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="NavHoverBrush"          Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="NavSelectedBrush"       Color="#15FFFFFF"/>
    <SolidColorBrush x:Key="SubtleSelectedBrush"    Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="PopupBrush"             Color="#2C2C2C"/>   <!-- menus, dropdowns, tooltips -->
    <SolidColorBrush x:Key="PopupStrokeBrush"       Color="#3A3A3A"/>
    <SolidColorBrush x:Key="PopupItemHoverBrush"    Color="#16FFFFFF"/>
    <SolidColorBrush x:Key="InputFocusBrush"        Color="#1F1F1F"/>   <!-- a focused input darkens -->
    <SolidColorBrush x:Key="ToggleOffStrokeBrush"   Color="#9A9A9A"/>

    <!-- ============================================================ -->
    <!--  TYPOGRAPHY — Windows 11 (Segoe UI Variable + Fluent ramp)   -->
    <!-- ============================================================ -->
    <!-- Segoe UI Variable is Win11's UI face and ships in THREE optical sizes.
         Using the right one per size is what makes text look native rather than
         merely "scaled": Display is drawn for large headings (tighter, more
         contrast), Text for reading sizes, Small for 12px and under (opened-up
         spacing so it stays legible). Every family falls back to plain Segoe UI,
         so Windows 10 machines simply keep the old face — nothing breaks.
         Verified on Win11: all three resolve in WPF with real Light/Normal/
         SemiBold/Bold weights, so nothing is faux-bolded. -->
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="MainFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="SmallFont">Segoe UI Variable Small, Segoe UI</FontFamily>

    <!-- Sizes follow the Fluent type ramp. LineHeight is set explicitly with
         BlockLineHeight so vertical rhythm is consistent instead of inherited
         from each glyph run. -->

    <!-- Fluent "Title" — page headings -->
    <Style x:Key="HeadingLarge" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="36"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- Fluent "Subtitle" — card / section headings -->
    <Style x:Key="HeadingMedium" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="24"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- Fluent "Body Strong" — inline emphasis / small headings -->
    <Style x:Key="HeadingSmall" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="20"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- Fluent "Body" -->
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="LineHeight" Value="20"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <!-- Left-align so a MaxWidth-constrained block stays under its heading instead of
             being centered in a wider slot (WPF centers Stretch elements past MaxWidth).
             An explicit HorizontalAlignment on the element still overrides this. -->
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- Fluent "Caption" — uses the Small optical size -->
    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SmallFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="LineHeight" Value="16"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- ============================================================ -->
    <!--  PRIMARY BUTTON                                              -->
    <!-- ============================================================ -->
    <!-- Windows 11 accent button: 4px corners, regular weight, black text on the accent. -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Padding" Value="18,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- STATE LAYER pattern: hover/press are a white veil faded in over the
                         button rather than a second hard-coded colour. It works over any
                         background (primary, danger, custom), so no per-variant hover tint
                         has to be kept in sync with the palette, and fading Opacity avoids
                         animating a shared SolidColorBrush (WPF freezes those). -->
                    <Grid x:Name="Wrap">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                BorderBrush="Transparent" BorderThickness="2"/>
                        <Border x:Name="State" CornerRadius="4" Background="#FFFFFF"
                                Opacity="0" IsHitTestVisible="False"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="State"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.12" Duration="0:0:0.13"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="State"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.13"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- Press stays instant: delayed feedback on click feels broken. -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Wrap" Property="Opacity" Value="0.80"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource DisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!--  DANGER BUTTON                                               -->
    <!-- ============================================================ -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{StaticResource AccentRedBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <!-- No hover override needed: the inherited state layer tints whatever
             background this button has, so danger red animates like every other. -->
    </Style>

    <!-- ============================================================ -->
    <!--  EXPANDER BUTTON  (transparent, borderless section header)   -->
    <!-- ============================================================ -->
    <!-- Windows 11 expander chevron. Pair with ctl:Motion.Flipped="{Binding IsOpen}" and it
         turns to point up while the section is open. -->
    <Style x:Key="ExpanderChevron" TargetType="Path">
        <Setter Property="Data" Value="M 0 0 L 4.5 4.5 L 9 0"/>
        <Setter Property="Width" Value="9"/>
        <Setter Property="Height" Value="5"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Stroke" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="StrokeThickness" Value="1.2"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
    </Style>

    <Style x:Key="ExpanderButton" TargetType="Button">
        <Setter Property="Background"                 Value="Transparent"/>
        <Setter Property="BorderThickness"            Value="0"/>
        <Setter Property="Padding"                    Value="0"/>
        <Setter Property="Cursor"                     Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="bg" Background="#FFFFFF" Opacity="0"
                                CornerRadius="4" IsHitTestVisible="False"/>
                        <ContentPresenter HorizontalAlignment="Stretch"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="bg"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.05" Duration="0:0:0.13"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="bg"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.13"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!--  GHOST BUTTON                                                -->
    <!-- ============================================================ -->
    <!-- Windows 11 standard button. The fill is translucent so it sits correctly on the
         window base and on cards alike. The key keeps its old name so the 42 pages and
         styles that use it pick up the new look without being edited. -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ControlFillBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="16,7"/>
        <Setter Property="BorderBrush" Value="{StaticResource ControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Wrap">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"/>
                        <Border x:Name="State" CornerRadius="4" Background="#FFFFFF"
                                Opacity="0" IsHitTestVisible="False"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="State"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.07" Duration="0:0:0.13"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="State"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.13"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Wrap" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Wrap" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!--  CARD / SURFACE PANEL                                        -->
    <!-- ============================================================ -->
    <Style x:Key="Card" TargetType="Border">
        <!-- Windows 11 settings card: #2B2B2B on the #202020 window, a hairline edge and
             8px corners. No shadow, no translucency: the lift in lightness is the whole
             separation, exactly as in the Settings app. -->
        <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="20"/>
        <!-- Fades and rises into place when its page opens (Controls/Motion.cs). -->
        <Setter Property="ctl:Motion.Entrance" Value="True"/>
    </Style>

    <!-- ============================================================ -->
    <!--  TOGGLE SWITCH (CheckBox styled)                             -->
    <!-- ============================================================ -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <!-- Windows 11 toggle: a 40x20 track, outlined when off and accent-filled when
                     on, with a 12px thumb that slides 20px and grows slightly under the pointer.
                     Colour changes are opacity cross-fades between stacked layers, never brush
                     colour animations, because shared theme brushes are frozen.
                     The template part names (Root, Track, TrackOn, Thumb) are kept from the old
                     template. Seven local styles derive from this one; they only add IsEnabled,
                     Opacity and ToolTip triggers, which work unchanged. -->
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel x:Name="Root" Orientation="Horizontal" VerticalAlignment="Center"
                                Background="Transparent">
                        <Grid x:Name="Track" Width="40" Height="20" Cursor="Hand">
                            <Border x:Name="TrackOff" CornerRadius="10" BorderThickness="1"
                                    BorderBrush="{StaticResource ToggleOffStrokeBrush}"
                                    Background="Transparent"/>
                            <Border x:Name="TrackHover" CornerRadius="10"
                                    Background="{StaticResource ControlFillBrush}" Opacity="0"/>
                            <Border x:Name="TrackOn" CornerRadius="10"
                                    Background="{StaticResource AccentBlueBrush}" Opacity="0"/>
                            <Border x:Name="FocusRing" CornerRadius="13" Margin="-3" BorderThickness="2"
                                    BorderBrush="{StaticResource TextPrimaryBrush}" Opacity="0"/>
                            <Grid x:Name="Thumb" Width="12" Height="12" Margin="4,0,0,0"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        <TranslateTransform X="0"/>
                                    </TransformGroup>
                                </Grid.RenderTransform>
                                <Ellipse x:Name="ThumbOff" Fill="{StaticResource TextSecondaryBrush}"/>
                                <Ellipse x:Name="ThumbOn" Fill="{StaticResource TextOnAccentBrush}" Opacity="0"/>
                            </Grid>
                        </Grid>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <!-- Thumb spans x=4..16 of the 40px track; 20px of travel puts it at 24..36,
                             leaving the same 4px margin on the right. 167 ms is WinUI's
                             ControlFastAnimationDuration. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                         To="20" Duration="0:0:0.167">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TrackOn"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.083"/>
                                        <DoubleAnimation Storyboard.TargetName="ThumbOn"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.083"/>
                                        <DoubleAnimation Storyboard.TargetName="ThumbOff"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.083"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                         To="0" Duration="0:0:0.167">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TrackOn"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.083"/>
                                        <DoubleAnimation Storyboard.TargetName="ThumbOn"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.083"/>
                                        <DoubleAnimation Storyboard.TargetName="ThumbOff"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.083"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- Pointer over: the thumb grows 12 to 14px and an off track picks up
                             a faint fill, the same feedback WinUI gives. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="1.1667" Duration="0:0:0.083"/>
                                        <DoubleAnimation Storyboard.TargetName="Thumb"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                         To="1.1667" Duration="0:0:0.083"/>
                                        <DoubleAnimation Storyboard.TargetName="TrackHover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.083"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="1" Duration="0:0:0.083"/>
                                        <DoubleAnimation Storyboard.TargetName="Thumb"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                         To="1" Duration="0:0:0.083"/>
                                        <DoubleAnimation Storyboard.TargetName="TrackHover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.083"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- Keyboard focus: the Windows 11 focus ring -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                        </Trigger>
                        <!-- Disabled: dim the whole control so it reads as non-interactive -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root"   Property="Opacity" Value="0.4"/>
                            <Setter TargetName="Track"  Property="Cursor"  Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- ============================================================ -->
    <!--  LISTVIEW / DATAGRID                                         -->
    <!-- ============================================================ -->
    <Style x:Key="DarkListView" TargetType="ListView">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="DarkListViewItem" TargetType="ListViewItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="4" Margin="0,1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource NavSelectedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!--  SCROLLBAR                                                   -->
    <!-- ============================================================ -->
    <!-- Reusable thumb: rounded pill that brightens on hover/drag and never
         shrinks below a usable size on very long content (MinHeight/MinWidth). -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBorder" Background="#4D4D4D" CornerRadius="3"
                            MinHeight="24" MinWidth="6"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="#626262"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="#767676"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid>
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- Horizontal orientation: swap the dimensions and un-reverse the track
             so dark-themed horizontal bars match (previously fell back to white
             Win11 chrome). -->
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid>
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================ -->
    <!--  COMBOBOX                                                     -->
    <!-- ============================================================ -->
    <!--
        DarkComboBox needs a full custom ControlTemplate. Without it, the default
        WPF/Win11 ComboBox theme renders white chrome regardless of the Background
        setter — which made selected DNS profile text appear white-on-white in
        System Tweaks. The template below draws its own dark border + dark
        selection content presenter + dark popup so theming is consistent.

        DO NOT add `<Setter Property="Resources">` here. FrameworkElement.Resources
        is a plain CLR property, not a DependencyProperty, so WPF's BAML reader
        rejects it with ArgumentNullException during template load and crashes
        the entire view (the v1.7.72/73 System Tweaks crash). The
        SystemColors.WindowBrushKey override for popup background is in App.xaml.
    -->
    <Style x:Key="DarkComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource ControlFillBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!-- Hidden ToggleButton spans the whole control so any click opens the popup -->
                        <ToggleButton x:Name="ToggleButton"
                                      Grid.Column="2"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Chrome"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="28"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Windows 11 chevron, stroked rather than a filled triangle -->
                                            <Path x:Name="Arrow"
                                                  Grid.Column="1"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Data="M 0 0 L 4.5 4.5 L 9 0"
                                                  Stroke="{StaticResource TextSecondaryBrush}"
                                                  StrokeThickness="1.2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Fill="Transparent"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ControlFillHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <!-- Background passes through TemplatedParent.Background -->
                            <ToggleButton.Background>
                                <Binding Path="Background" RelativeSource="{RelativeSource TemplatedParent}"/>
                            </ToggleButton.Background>
                            <ToggleButton.BorderBrush>
                                <Binding Path="BorderBrush" RelativeSource="{RelativeSource TemplatedParent}"/>
                            </ToggleButton.BorderBrush>
                            <ToggleButton.BorderThickness>
                                <Binding Path="BorderThickness" RelativeSource="{RelativeSource TemplatedParent}"/>
                            </ToggleButton.BorderThickness>
                        </ToggleButton>

                        <!-- Selected item display — dark text on dark background -->
                        <ContentPresenter x:Name="ContentSite"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          Margin="10,6,28,6"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"/>

                        <!-- Dropdown popup -->
                        <Popup x:Name="Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Grid x:Name="DropDown"
                                  SnapsToDevicePixels="True"
                                  MinWidth="{TemplateBinding ActualWidth}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border x:Name="DropDownBorder"
                                        Background="{StaticResource PopupBrush}"
                                        BorderBrush="{StaticResource PopupStrokeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"/>
                                <ScrollViewer Margin="4"
                                              SnapsToDevicePixels="True"
                                              VerticalScrollBarVisibility="Auto">
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- Dark-themed dropdown items -->
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                    <Setter Property="Padding" Value="12,7"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <!-- Windows 11 list item: a subtle rounded highlight, with a small accent
                                 pill marking the selected entry, instead of a full accent-filled row. -->
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Grid Margin="0,1">
                                    <Border x:Name="ItemBorder"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="4"/>
                                    <Border x:Name="SelectedPill" Width="3" Height="16" CornerRadius="1.5"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Background="{StaticResource AccentBlueBrush}" Opacity="0"/>
                                    <ContentPresenter
                                        Margin="{TemplateBinding Padding}"
                                        TextElement.Foreground="{TemplateBinding Foreground}"
                                        TextElement.FontFamily="{TemplateBinding FontFamily}"
                                        TextElement.FontSize="{TemplateBinding FontSize}"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <!-- ORDER MATTERS. IsSelected comes first so that when an item is
                                         both selected and highlighted (which is exactly what happens the
                                         moment the dropdown opens) IsHighlighted wins the background.
                                         Both states keep the primary text colour, so a dark-text-on-dark-row
                                         combination can't happen in either order. -->
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SubtleSelectedBrush}"/>
                                        <Setter TargetName="SelectedPill" Property="Opacity" Value="1"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource PopupItemHoverBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- IMPLICIT ComboBox style — every ComboBox gets the dark theme automatically.
         Without this, a ComboBox that forgets Style="{StaticResource DarkComboBox}"
         falls back to WPF's built-in template, whose dropdown items draw with the
         system control-text colour (black). Because App.xaml overrides
         SystemColors.WindowBrushKey to a dark brush so popups aren't white, that
         combination rendered black text on a black popup — unreadable. Making the
         style implicit means a ComboBox added later cannot reintroduce the bug. -->
    <Style TargetType="ComboBox" BasedOn="{StaticResource DarkComboBox}"/>

    <!-- ============================================================ -->
    <!--  TITLE-BAR CLOSE BUTTON                                      -->
    <!-- ============================================================ -->
    <!-- Win11 caption proportions with the familiar red hover. The glyph is a
         vector Path, not the "✕" character, so it stays perfectly crisp and
         evenly weighted at any DPI instead of depending on font hinting. The red
         is a state layer faded in (same approach as the other buttons) rather
         than a background swap, so it eases in and needs no colour animation. -->
    <!-- Windows 11 proportions: a full-height, square 46px caption button in the corner.
         DWM rounds the window corner itself, so the square hover fill is clipped to match. -->
    <Style x:Key="CaptionCloseButton" TargetType="Button">
        <Setter Property="Width"  Value="46"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Fill" Background="#C42B1C" Opacity="0" CornerRadius="0"/>
                        <Path x:Name="Glyph"
                              Data="M 0,0 L 10,10 M 10,0 L 0,10"
                              Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glyph" Property="Stroke" Value="#FFFFFF"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fill"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.13"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fill"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.13"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="#A82318"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!--  SEPARATOR                                                   -->
    <!-- ============================================================ -->
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="0,8"/>
    </Style>

    <!-- ============================================================ -->
    <!--  PROGRESS BAR                                                -->
    <!-- ============================================================ -->
    <Style x:Key="AccentProgressBar" TargetType="ProgressBar">
        <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
        <Setter Property="Height" Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="3" Height="6">
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                HorizontalAlignment="Left" CornerRadius="3"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!--  SIDEBAR NAV BUTTON                                          -->
    <!-- ============================================================ -->
    <!-- Windows 11 NavigationView item: 36px tall, 4px corners, primary text on every item.
         The selected item gets a subtle fill here. The accent pill that marks it is ONE shared
         indicator in MainWindow that slides between items the way NavigationView animates,
         rather than a bar drawn inside each button, so this template has no accent bar. -->
    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4"/>
                        <Border x:Name="Hover" Background="{StaticResource NavHoverBrush}" CornerRadius="4"
                                Opacity="0" IsHitTestVisible="False"/>
                        <Border x:Name="FocusRing" CornerRadius="6" Margin="-2" BorderThickness="2"
                                BorderBrush="{StaticResource TextPrimaryBrush}"
                                Opacity="0" IsHitTestVisible="False"/>
                        <ContentPresenter x:Name="Presenter" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.083"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.083"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- Press stays instant: delayed feedback on click feels broken. -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Presenter" Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <!-- Keyboard focus: the Windows 11 focus ring -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Active state: section name (Tag) matches DataContext.ActiveSection.
                 Same binding as before the overhaul; only the visual changed. -->
            <DataTrigger Value="True">
                <DataTrigger.Binding>
                    <MultiBinding>
                        <MultiBinding.Converter>
                            <conv:EqualityConverter/>
                        </MultiBinding.Converter>
                        <Binding Path="DataContext.ActiveSection"
                                 RelativeSource="{RelativeSource AncestorType=Window}"/>
                        <Binding RelativeSource="{RelativeSource Self}" Path="Tag"/>
                    </MultiBinding>
                </DataTrigger.Binding>
                <Setter Property="Background" Value="{StaticResource NavSelectedBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================ -->
    <!--  TEXTBOX                                                     -->
    <!-- ============================================================ -->
    <!-- Windows 11 text input: subtle fill, 4px corners, and an accent underline when focused. -->
    <Style x:Key="DarkTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource ControlFillBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CaretBrush" Value="{StaticResource AccentBlueBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBlueBrush}"/>
        <Setter Property="SelectionOpacity" Value="0.35"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Border>
                        <Border x:Name="FocusLine" Height="2" VerticalAlignment="Bottom" Margin="1,0"
                                CornerRadius="0,0,4,4" Background="{StaticResource AccentBlueBrush}"
                                Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Hover first, so a focused box keeps its focused look under the pointer. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource ControlFillHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource InputFocusBrush}"/>
                            <Setter TargetName="FocusLine" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!--  SECTION LABEL  (uppercase category headers)                 -->
    <!-- ============================================================ -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- ============================================================ -->
    <!--  STATUS PILL  (small inline status badges)                   -->
    <!-- ============================================================ -->
    <Style x:Key="StatusPillGreen" TargetType="Border">
        <Setter Property="Background" Value="#16231B"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,2"/>
    </Style>

    <Style x:Key="StatusPillRed" TargetType="Border">
        <Setter Property="Background" Value="#251A1C"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,2"/>
    </Style>

    <Style x:Key="StatusPillGray" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,2"/>
    </Style>

    <!-- ============================================================ -->
    <!--  HELPER / INFORMATIONAL TEXT  (muted blue)                   -->
    <!--  Use this for status messages, hints, and supporting info    -->
    <!--  text — NOT for primary content. Examples: "Active plan: X", -->
    <!--  "Battery pause is supported", recommended-value hints.      -->
    <!-- ============================================================ -->
    <Style x:Key="HelperText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
        <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
    </Style>

    <!-- ============================================================ -->
    <!--  SETTINGS PAGES  (Windows 11 Settings layout)                -->
    <!-- ============================================================ -->

    <!-- Windows 11 check box: 20px rounded square, outlined when clear, accent-filled with a
         black tick when checked. Keyed, not implicit, so it only reaches the check boxes a
         converted page asks for; unstyled ones elsewhere keep their current look until their
         page is converted. -->
    <Style x:Key="Win11CheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- Grid, not a horizontal StackPanel, so a long label wraps. The transparent
                         padded Border makes the whole padded area (a full list row) clickable. -->
                    <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="20" Height="20" VerticalAlignment="Center">
                            <Border x:Name="BoxOff" CornerRadius="4" BorderThickness="1"
                                    BorderBrush="{StaticResource ToggleOffStrokeBrush}" Background="Transparent"/>
                            <Border x:Name="BoxHover" CornerRadius="4" Background="{StaticResource ControlFillBrush}" Opacity="0"/>
                            <Border x:Name="BoxOn" CornerRadius="4" Background="{StaticResource AccentBlueBrush}" Opacity="0"/>
                            <Border x:Name="FocusRing" CornerRadius="6" Margin="-3" BorderThickness="2"
                                    BorderBrush="{StaticResource TextPrimaryBrush}" Opacity="0"/>
                            <Path x:Name="Tick" Data="M 4.5 10.5 L 8.5 14 L 15.5 6.5" Opacity="0"
                                  Stroke="{StaticResource TextOnAccentBrush}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Grid>
                        <ContentPresenter x:Name="Label" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Label" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BoxHover" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="BoxOn" Property="Opacity" Value="1"/>
                            <Setter TargetName="Tick" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A row in a list page (apps to remove, startup apps): the card look without the
         header/description layout, for rows whose content is built by an ItemTemplate. -->
    <Style x:Key="ListRowCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="ctl:Motion.Entrance" Value="True"/>
    </Style>

    <!-- Group header above a run of cards: Windows 11 "Body Strong". -->
    <Style x:Key="SettingsGroupHeader" TargetType="TextBlock" BasedOn="{StaticResource HeadingSmall}">
        <Setter Property="Margin" Value="2,24,0,8"/>
    </Style>

    <!-- Text under a card's header. Wraps, and stays at a readable width. -->
    <Style x:Key="CardDescription" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SmallFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="LineHeight" Value="17"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="MaxWidth" Value="680"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <!-- Extra lines under a description: a neutral note, a caution, or a reassurance. -->
    <Style x:Key="CardNote" TargetType="TextBlock" BasedOn="{StaticResource CardDescription}">
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
    <Style x:Key="CardNoteWarn" TargetType="TextBlock" BasedOn="{StaticResource CardNote}">
        <Setter Property="Foreground" Value="{StaticResource AccentYellowBrush}"/>
    </Style>
    <Style x:Key="CardNoteGood" TargetType="TextBlock" BasedOn="{StaticResource CardNote}">
        <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
    </Style>

    <!-- One setting per card: header (+ optional badge) and description on the left, the
         control on the right. Controls/SettingsCard.cs has the properties. Cards stack with a
         4px gap, the rhythm Windows Settings uses. -->
    <ctl:StringDescriptionSelector x:Key="SettingsCardDescriptionSelector">
        <ctl:StringDescriptionSelector.StringTemplate>
            <DataTemplate>
                <TextBlock Text="{Binding}" Style="{StaticResource CardDescription}"/>
            </DataTemplate>
        </ctl:StringDescriptionSelector.StringTemplate>
    </ctl:StringDescriptionSelector>

    <Style TargetType="ctl:SettingsCard">
        <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="18,14"/>
        <Setter Property="ctl:Motion.Entrance" Value="True"/>
        <Setter Property="MinHeight" Value="68"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="BadgeBrush" Value="{StaticResource AccentBlueBrush}"/>
        <Setter Property="ExtraBadgeBrush" Value="{StaticResource AccentGreenBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctl:SettingsCard">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            MinHeight="{TemplateBinding MinHeight}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path x:Name="IconPath" Grid.Column="0" Width="18" Height="18" Stretch="Uniform"
                                  Margin="0,0,16,0" VerticalAlignment="Center"
                                  Data="{TemplateBinding IconData}"
                                  Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <ContentPresenter Content="{TemplateBinding Header}" VerticalAlignment="Center"
                                                      TextElement.FontSize="14"
                                                      TextElement.Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <Border x:Name="BadgePill" Margin="8,0,0,0" CornerRadius="4" Padding="6,1"
                                            VerticalAlignment="Center" BorderThickness="1"
                                            BorderBrush="{TemplateBinding BadgeBrush}"
                                            Background="{StaticResource ControlFillBrush}">
                                        <TextBlock Text="{TemplateBinding Badge}" FontSize="11"
                                                   Foreground="{TemplateBinding BadgeBrush}"/>
                                    </Border>
                                    <Border x:Name="ExtraBadgePill" Margin="6,0,0,0" CornerRadius="4" Padding="6,1"
                                            VerticalAlignment="Center" BorderThickness="1"
                                            BorderBrush="{TemplateBinding ExtraBadgeBrush}"
                                            Background="{StaticResource ControlFillBrush}">
                                        <TextBlock Text="{TemplateBinding ExtraBadge}" FontSize="11"
                                                   Foreground="{TemplateBinding ExtraBadgeBrush}"/>
                                    </Border>
                                </StackPanel>
                                <!-- Plain-string descriptions (Description="…") render exactly like the
                                     TextBlock ones written with CardDescription. A selector, not a typed
                                     DataTemplate in Resources, so it only ever touches this presenter's own
                                     content and never the captions of buttons nested in a description. -->
                                <ContentPresenter x:Name="DescriptionHost" Content="{TemplateBinding Description}"
                                                  ContentTemplateSelector="{StaticResource SettingsCardDescriptionSelector}"
                                                  Margin="0,3,0,0"
                                                  TextElement.FontSize="12"
                                                  TextElement.Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <ContentPresenter Grid.Column="2" Margin="20,0,0,0"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IconData" Value="{x:Null}">
                            <Setter TargetName="IconPath" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Badge" Value="{x:Null}">
                            <Setter TargetName="BadgePill" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="ExtraBadge" Value="{x:Null}">
                            <Setter TargetName="ExtraBadgePill" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="DescriptionHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!--  SETTINGS EXPANDER (Windows 11)                              -->
    <!-- ============================================================ -->
    <!-- A section that opens to show its settings: a card whose header row (an ExpanderButton
         with a rotating chevron) sits above child rows split by hairlines. -->
    <Style x:Key="ExpanderCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="ctl:Motion.Entrance" Value="True"/>
    </Style>

    <!-- Title in an expander's header row: same size and colour as a SettingsCard header -->
    <Style x:Key="ExpanderHeaderTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- A setting inside an open expander: square, transparent, a hairline above, and indented
         a little so it reads as belonging to the header above it. -->
    <Style x:Key="ExpanderItem" TargetType="ctl:SettingsCard" BasedOn="{StaticResource {x:Type ctl:SettingsCard}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="34,12,18,12"/>
        <Setter Property="MinHeight" Value="60"/>
        <Setter Property="ctl:Motion.Entrance" Value="False"/>
    </Style>

    <!-- The top row of a group that is always open (a setting with its own sub-settings under
         it, like NVIDIA's power mode with plugged-in and battery pickers): a SettingsCard with no
         chrome of its own, sitting inside an ExpanderCard above its ExpanderItem rows. -->
    <Style x:Key="ExpanderHeaderCard" TargetType="ctl:SettingsCard" BasedOn="{StaticResource {x:Type ctl:SettingsCard}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="ctl:Motion.Entrance" Value="False"/>
    </Style>

    <!-- Free-form content inside an open expander (tables, number pickers), same inset and hairline -->
    <Style x:Key="ExpanderBlock" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="34,14,18,14"/>
    </Style>

    <!-- ============================================================ -->
    <!--  TOOLTIP  (implicit, Windows 11)                             -->
    <!-- ============================================================ -->
    <!-- Implicit, so every tooltip in the app picks it up, including the ones that local
         styles set through a ToolTip setter. Long tooltips wrap instead of running off
         the screen. Only the look changes: content, timing and placement are WPF's own. -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource SmallFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource PopupBrush}"
                            BorderBrush="{StaticResource PopupStrokeBrush}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="9,6,9,7" MaxWidth="360">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
