<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Systema.Core.Converters"
                    xmlns:ctl="clr-namespace:Systema.Controls">

    <!-- Colours live in Palette.Dark.xaml / Palette.Light.xaml (same keys). Core/ThemeManager.cs
         loads the one matching Windows, live, so everything here refers to them with
         DynamicResource. This file holds the styles for both themes. -->

    <!-- ============================================================ -->
    <!--  TYPOGRAPHY — Windows 11 (Segoe UI Variable + Fluent ramp)   -->
    <!-- ============================================================ -->
    <!-- Segoe UI Variable is Win11's UI face and ships in THREE optical sizes.
         Using the right one per size is what makes text look native rather than
         merely "scaled": Display is drawn for large headings (tighter, more
         contrast), Text for reading sizes, Small for 12px and under (opened-up
         spacing so it stays legible). Every family falls back to plain Segoe UI,
         so Windows 10 machines simply keep the old face — nothing breaks.
         Verified on Win11: all three resolve in WPF with real Light/Normal/
         SemiBold/Bold weights, so nothing is faux-bolded. -->
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="MainFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="SmallFont">Segoe UI Variable Small, Segoe UI</FontFamily>

    <!-- Sizes follow the Fluent type ramp. LineHeight is set explicitly with
         BlockLineHeight so vertical rhythm is consistent instead of inherited
         from each glyph run. -->

    <!-- Fluent "Title" — page headings -->
    <Style x:Key="HeadingLarge" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="36"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- Fluent "Subtitle" — card / section headings -->
    <Style x:Key="HeadingMedium" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="24"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- Fluent "Body Strong" — inline emphasis / small headings -->
    <Style x:Key="HeadingSmall" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="20"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- Fluent "Body" -->
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="LineHeight" Value="20"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <!-- Left-align so a MaxWidth-constrained block stays under its heading instead of
             being centered in a wider slot (WPF centers Stretch elements past MaxWidth).
             An explicit HorizontalAlignment on the element still overrides this. -->
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- Fluent "Caption" — uses the Small optical size -->
    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SmallFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="LineHeight" Value="16"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- ============================================================ -->
    <!--  KEYBOARD FOCUS RING                                         -->
    <!-- ============================================================ -->
    <!-- Windows 11's focus ring: 2px white outside a 1px dark line, a few px out from the control.
         WPF only shows a FocusVisualStyle for keyboard focus (Tab), never on a mouse click. -->
    <Style x:Key="Win11FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="7" BorderThickness="2" BorderBrush="{DynamicResource FocusStrokeOuterBrush}" SnapsToDevicePixels="True">
                        <Border CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource FocusStrokeInnerBrush}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!--  PRIMARY BUTTON                                              -->
    <!-- ============================================================ -->
    <!-- Windows 11 accent button: 4px corners, regular weight, black text on the accent. -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource AccentBlueBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Padding" Value="18,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Win11FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- STATE LAYER pattern: hover/press are a white veil faded in over the
                         button rather than a second hard-coded colour. It works over any
                         background (primary, danger, custom), so no per-variant hover tint
                         has to be kept in sync with the palette, and fading Opacity avoids
                         animating a shared SolidColorBrush (WPF freezes those). -->
                    <Grid x:Name="Wrap">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                BorderBrush="Transparent" BorderThickness="2"/>
                        <Border x:Name="State" CornerRadius="4" Background="#FFFFFF"
                                Opacity="0" IsHitTestVisible="False"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="State"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.12" Duration="0:0:0.13"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="State"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.13"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- Press stays instant: delayed feedback on click feels broken. -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Wrap" Property="Opacity" Value="0.80"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!--  DANGER BUTTON                                               -->
    <!-- ============================================================ -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{DynamicResource AccentRedBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <!-- No hover override needed: the inherited state layer tints whatever
             background this button has, so danger red animates like every other. -->
    </Style>

    <!-- ============================================================ -->
    <!--  EXPANDER BUTTON  (transparent, borderless section header)   -->
    <!-- ============================================================ -->
    <!-- Windows 11 expander chevron. Pair with ctl:Motion.Flipped="{Binding IsOpen}" and it
         turns to point up while the section is open. -->
    <Style x:Key="ExpanderChevron" TargetType="Path">
        <Setter Property="Data" Value="M 0 0 L 4.5 4.5 L 9 0"/>
        <Setter Property="Width" Value="9"/>
        <Setter Property="Height" Value="5"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="StrokeThickness" Value="1.2"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
    </Style>

    <Style x:Key="ExpanderButton" TargetType="Button">
        <Setter Property="Background"                 Value="Transparent"/>
        <Setter Property="BorderThickness"            Value="0"/>
        <Setter Property="Padding"                    Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="bg" Background="{DynamicResource StateLayerBrush}" Opacity="0"
                                CornerRadius="4" IsHitTestVisible="False"/>
                        <ContentPresenter HorizontalAlignment="Stretch"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="bg"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.05" Duration="0:0:0.13"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="bg"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.13"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!--  GHOST BUTTON                                                -->
    <!-- ============================================================ -->
    <!-- Windows 11 standard button. The fill is translucent so it sits correctly on the
         window base and on cards alike. The key keeps its old name so the 42 pages and
         styles that use it pick up the new look without being edited. -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource ControlFillBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="16,7"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Win11FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Wrap">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"/>
                        <Border x:Name="State" CornerRadius="4" Background="{DynamicResource StateLayerBrush}"
                                Opacity="0" IsHitTestVisible="False"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="State"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.07" Duration="0:0:0.13"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="State"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.13"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Wrap" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Wrap" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!--  CARD / SURFACE PANEL                                        -->
    <!-- ============================================================ -->
    <Style x:Key="Card" TargetType="Border">
        <!-- Windows 11 settings card: #2B2B2B on the #202020 window, a hairline edge and
             8px corners. No shadow, no translucency: the lift in lightness is the whole
             separation, exactly as in the Settings app. -->
        <Setter Property="Background" Value="{DynamicResource CardLayerBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="20"/>
        <!-- Fades and rises into place when its page opens (Controls/Motion.cs). -->
        <Setter Property="ctl:Motion.Entrance" Value="True"/>
    </Style>

    <!-- ============================================================ -->
    <!--  TOGGLE SWITCH (CheckBox styled)                             -->
    <!-- ============================================================ -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Win11FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <!-- Windows 11 toggle: a 40x20 track, outlined when off and accent-filled when
                     on, with a 12px thumb that slides 20px and grows slightly under the pointer.
                     Colour changes are opacity cross-fades between stacked layers, never brush
                     colour animations, because shared theme brushes are frozen.
                     The template part names (Root, Track, TrackOn, Thumb) are kept from the old
                     template. Seven local styles derive from this one; they only add IsEnabled,
                     Opacity and ToolTip triggers, which work unchanged. -->
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel x:Name="Root" Orientation="Horizontal" VerticalAlignment="Center"
                                Background="Transparent">
                        <!-- "On" / "Off" before the switch, exactly as Windows Settings shows it.
                             Tag="NoStateLabel" drops it where the switch already has its own text. -->
                        <TextBlock x:Name="StateText" Text="Off" FontSize="14" Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Grid x:Name="Track" Width="40" Height="20">
                            <Border x:Name="TrackOff" CornerRadius="10" BorderThickness="1"
                                    BorderBrush="{DynamicResource ToggleOffStrokeBrush}"
                                    Background="Transparent"/>
                            <Border x:Name="TrackHover" CornerRadius="10"
                                    Background="{DynamicResource ControlFillBrush}" Opacity="0"/>
                            <Border x:Name="TrackOn" CornerRadius="10"
                                    Background="{DynamicResource AccentBlueBrush}" Opacity="0"/>
                            <Border x:Name="FocusRing" CornerRadius="13" Margin="-3" BorderThickness="2"
                                    BorderBrush="{DynamicResource TextPrimaryBrush}" Opacity="0"/>
                            <Grid x:Name="Thumb" Width="12" Height="12" Margin="4,0,0,0"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        <TranslateTransform X="0"/>
                                    </TransformGroup>
                                </Grid.RenderTransform>
                                <Ellipse x:Name="ThumbOff" Fill="{DynamicResource TextSecondaryBrush}"/>
                                <Ellipse x:Name="ThumbOn" Fill="{DynamicResource TextOnAccentBrush}" Opacity="0"/>
                            </Grid>
                        </Grid>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="StateText" Property="Text" Value="On"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="NoStateLabel">
                            <Setter TargetName="StateText" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <!-- Thumb spans x=4..16 of the 40px track; 20px of travel puts it at 24..36,
                             leaving the same 4px margin on the right. 167 ms is WinUI's
                             ControlFastAnimationDuration. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                         To="20" Duration="0:0:0.167">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TrackOn"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.083"/>
                                        <DoubleAnimation Storyboard.TargetName="ThumbOn"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.083"/>
                                        <DoubleAnimation Storyboard.TargetName="ThumbOff"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.083"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                         To="0" Duration="0:0:0.167">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TrackOn"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.083"/>
                                        <DoubleAnimation Storyboard.TargetName="ThumbOn"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.083"/>
                                        <DoubleAnimation Storyboard.TargetName="ThumbOff"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.083"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- Pointer over: the thumb grows 12 to 14px and an off track picks up
                             a faint fill, the same feedback WinUI gives. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="1.1667" Duration="0:0:0.083"/>
                                        <DoubleAnimation Storyboard.TargetName="Thumb"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                         To="1.1667" Duration="0:0:0.083"/>
                                        <DoubleAnimation Storyboard.TargetName="TrackHover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.083"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="1" Duration="0:0:0.083"/>
                                        <DoubleAnimation Storyboard.TargetName="Thumb"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                         To="1" Duration="0:0:0.083"/>
                                        <DoubleAnimation Storyboard.TargetName="TrackHover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.083"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- Keyboard focus: the Windows 11 focus ring -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                        </Trigger>
                        <!-- Disabled: dim the whole control so it reads as non-interactive -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root"   Property="Opacity" Value="0.4"/>
                            <Setter TargetName="Track"  Property="Cursor"  Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- ============================================================ -->
    <!--  LISTVIEW / DATAGRID                                         -->
    <!-- ============================================================ -->
    <Style x:Key="DarkListView" TargetType="ListView">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="DarkListViewItem" TargetType="ListViewItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="4" Margin="0,1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!--  SCROLLBAR                                                   -->
    <!-- ============================================================ -->
    <!-- Windows 11 scroll bars, as in the Settings app:
           • they float over the content instead of taking a column of their own
           • idle, the thumb is a 2px line; point at the bar and it widens to 6px on a
             rounded track with small arrows, then narrows again shortly after you leave
           • the whole bar fades out when you stop scrolling or moving the mouse over the
             area (Controls/OverlayScroll.cs), unless Windows' "Always show scrollbars" is on
         MinWidth/MinHeight are zeroed on purpose: WPF's built-in theme gives every
         scroll bar a 17px minimum, which is what made the old 8px bars look chunky. -->
    <StreamGeometry x:Key="ScrollArrowUp">M0,4 L4,0 L8,4 Z</StreamGeometry>
    <StreamGeometry x:Key="ScrollArrowDown">M0,0 L8,0 L4,4 Z</StreamGeometry>
    <StreamGeometry x:Key="ScrollArrowLeft">M4,0 L4,8 L0,4 Z</StreamGeometry>
    <StreamGeometry x:Key="ScrollArrowRight">M0,0 L4,4 L0,8 Z</StreamGeometry>

    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBorder" Background="{DynamicResource ScrollInkBrush}" CornerRadius="3"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ScrollInkHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ScrollInkPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The empty track either side of the thumb: click to page up or down. -->
    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The small arrows at each end. Content carries the arrow's geometry. -->
    <Style x:Key="ScrollArrowButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Foreground" Value="{DynamicResource ScrollInkBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent">
                        <Path Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                              Fill="{TemplateBinding Foreground}" Stretch="Uniform"
                              Width="7" Height="7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource ScrollInkHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource ScrollInkPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="TrackBg" Background="{DynamicResource ScrollTrackBrush}" CornerRadius="6" Opacity="0"/>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="12"/>
                            </Grid.RowDefinitions>
                            <RepeatButton x:Name="LineUp" Grid.Row="0" Opacity="0"
                                          Style="{StaticResource ScrollArrowButton}"
                                          Content="{StaticResource ScrollArrowUp}"
                                          Command="ScrollBar.LineUpCommand"/>
                            <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Style="{StaticResource ScrollThumb}"
                                           Width="2" HorizontalAlignment="Center"/>
                                </Track.Thumb>
                            </Track>
                            <RepeatButton x:Name="LineDown" Grid.Row="2" Opacity="0"
                                          Style="{StaticResource ScrollArrowButton}"
                                          Content="{StaticResource ScrollArrowDown}"
                                          Command="ScrollBar.LineDownCommand"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="Width"
                                                         To="6" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="TrackBg" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="LineUp" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="LineDown" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <!-- Stays wide for half a second after the pointer leaves, like Windows. -->
                            <Trigger.ExitActions>
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Thumb" Storyboard.TargetProperty="Width">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="6"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.65" Value="2"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TrackBg" Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="1"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.65" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LineUp" Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="1"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.65" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LineDown" Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="1"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.65" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent" SnapsToDevicePixels="True">
                                <Border x:Name="TrackBg" Background="{DynamicResource ScrollTrackBrush}" CornerRadius="6" Opacity="0"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                    </Grid.ColumnDefinitions>
                                    <RepeatButton x:Name="LineLeft" Grid.Column="0" Opacity="0"
                                                  Style="{StaticResource ScrollArrowButton}"
                                                  Content="{StaticResource ScrollArrowLeft}"
                                                  Command="ScrollBar.LineLeftCommand"/>
                                    <Track x:Name="PART_Track" Grid.Column="1" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageLeftCommand"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageRightCommand"/>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb x:Name="Thumb" Style="{StaticResource ScrollThumb}"
                                                   Height="2" VerticalAlignment="Center"/>
                                        </Track.Thumb>
                                    </Track>
                                    <RepeatButton x:Name="LineRight" Grid.Column="2" Opacity="0"
                                                  Style="{StaticResource ScrollArrowButton}"
                                                  Content="{StaticResource ScrollArrowRight}"
                                                  Command="ScrollBar.LineRightCommand"/>
                                </Grid>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="Height"
                                                                 To="6" Duration="0:0:0.12"/>
                                                <DoubleAnimation Storyboard.TargetName="TrackBg" Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.12"/>
                                                <DoubleAnimation Storyboard.TargetName="LineLeft" Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.12"/>
                                                <DoubleAnimation Storyboard.TargetName="LineRight" Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                            <Storyboard>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Thumb" Storyboard.TargetProperty="Height">
                                                    <LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="6"/>
                                                    <LinearDoubleKeyFrame KeyTime="0:0:0.65" Value="2"/>
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TrackBg" Storyboard.TargetProperty="Opacity">
                                                    <LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="1"/>
                                                    <LinearDoubleKeyFrame KeyTime="0:0:0.65" Value="0"/>
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LineLeft" Storyboard.TargetProperty="Opacity">
                                                    <LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="1"/>
                                                    <LinearDoubleKeyFrame KeyTime="0:0:0.65" Value="0"/>
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LineRight" Storyboard.TargetProperty="Opacity">
                                                    <LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="1"/>
                                                    <LinearDoubleKeyFrame KeyTime="0:0:0.65" Value="0"/>
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Every ScrollViewer: content fills the whole area and the bars float on top at the
         right and bottom edges (pages keep 32px side margins, so nothing sits under them).
         Same part names and bindings as WPF's own template, so lists, text boxes and
         dropdowns scroll exactly as before. -->
    <Style TargetType="ScrollViewer">
        <Setter Property="ctl:OverlayScroll.AutoHide" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                                CanHorizontallyScroll="False" CanVerticallyScroll="False"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                Margin="{TemplateBinding Padding}"/>
                        <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right" Margin="0,2,1,2"
                                   AutomationProperties.AutomationId="VerticalScrollBar" Cursor="Arrow"
                                   Minimum="0" Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        <ScrollBar x:Name="PART_HorizontalScrollBar" Orientation="Horizontal"
                                   VerticalAlignment="Bottom" Margin="2,0,2,1"
                                   AutomationProperties.AutomationId="HorizontalScrollBar" Cursor="Arrow"
                                   Minimum="0" Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!--  COMBOBOX                                                     -->
    <!-- ============================================================ -->
    <!--
        DarkComboBox needs a full custom ControlTemplate. Without it, the default
        WPF/Win11 ComboBox theme renders white chrome regardless of the Background
        setter — which made selected DNS profile text appear white-on-white in
        System Tweaks. The template below draws its own dark border + dark
        selection content presenter + dark popup so theming is consistent.

        DO NOT add `<Setter Property="Resources">` here. FrameworkElement.Resources
        is a plain CLR property, not a DependencyProperty, so WPF's BAML reader
        rejects it with ArgumentNullException during template load and crashes
        the entire view (the v1.7.72/73 System Tweaks crash). The
        SystemColors.WindowBrushKey override for popup background is in App.xaml.
    -->
    <Style x:Key="DarkComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource ControlFillBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!-- Hidden ToggleButton spans the whole control so any click opens the popup -->
                        <ToggleButton x:Name="ToggleButton"
                                      Grid.Column="2"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Chrome"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="28"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Windows 11 chevron, stroked rather than a filled triangle -->
                                            <Path x:Name="Arrow"
                                                  Grid.Column="1"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Data="M 0 0 L 4.5 4.5 L 9 0"
                                                  Stroke="{DynamicResource TextSecondaryBrush}"
                                                  StrokeThickness="1.2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Fill="Transparent"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlFillHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <!-- Background passes through TemplatedParent.Background -->
                            <ToggleButton.Background>
                                <Binding Path="Background" RelativeSource="{RelativeSource TemplatedParent}"/>
                            </ToggleButton.Background>
                            <ToggleButton.BorderBrush>
                                <Binding Path="BorderBrush" RelativeSource="{RelativeSource TemplatedParent}"/>
                            </ToggleButton.BorderBrush>
                            <ToggleButton.BorderThickness>
                                <Binding Path="BorderThickness" RelativeSource="{RelativeSource TemplatedParent}"/>
                            </ToggleButton.BorderThickness>
                        </ToggleButton>

                        <!-- Selected item display — dark text on dark background -->
                        <ContentPresenter x:Name="ContentSite"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          Margin="10,6,28,6"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"/>

                        <!-- Dropdown popup -->
                        <Popup x:Name="Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Grid x:Name="DropDown"
                                  SnapsToDevicePixels="True"
                                  MinWidth="{TemplateBinding ActualWidth}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border x:Name="DropDownBorder"
                                        Background="{DynamicResource PopupBrush}"
                                        BorderBrush="{DynamicResource PopupStrokeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"/>
                                <ScrollViewer Margin="4"
                                              SnapsToDevicePixels="True"
                                              VerticalScrollBarVisibility="Auto">
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- Dark-themed dropdown items -->
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                    <Setter Property="Padding" Value="12,7"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <!-- Windows 11 list item: a subtle rounded highlight, with a small accent
                                 pill marking the selected entry, instead of a full accent-filled row. -->
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Grid Margin="0,1">
                                    <Border x:Name="ItemBorder"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="4"/>
                                    <Border x:Name="SelectedPill" Width="3" Height="16" CornerRadius="1.5"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Background="{DynamicResource AccentBlueBrush}" Opacity="0"/>
                                    <ContentPresenter
                                        Margin="{TemplateBinding Padding}"
                                        TextElement.Foreground="{TemplateBinding Foreground}"
                                        TextElement.FontFamily="{TemplateBinding FontFamily}"
                                        TextElement.FontSize="{TemplateBinding FontSize}"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <!-- ORDER MATTERS. IsSelected comes first so that when an item is
                                         both selected and highlighted (which is exactly what happens the
                                         moment the dropdown opens) IsHighlighted wins the background.
                                         Both states keep the primary text colour, so a dark-text-on-dark-row
                                         combination can't happen in either order. -->
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleSelectedBrush}"/>
                                        <Setter TargetName="SelectedPill" Property="Opacity" Value="1"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource PopupItemHoverBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- IMPLICIT ComboBox style — every ComboBox gets the dark theme automatically.
         Without this, a ComboBox that forgets Style="{StaticResource DarkComboBox}"
         falls back to WPF's built-in template, whose dropdown items draw with the
         system control-text colour (black). Because App.xaml overrides
         SystemColors.WindowBrushKey to a dark brush so popups aren't white, that
         combination rendered black text on a black popup — unreadable. Making the
         style implicit means a ComboBox added later cannot reintroduce the bug. -->
    <Style TargetType="ComboBox" BasedOn="{StaticResource DarkComboBox}"/>

    <!-- ============================================================ -->
    <!--  TITLE-BAR CLOSE BUTTON                                      -->
    <!-- ============================================================ -->
    <!-- Win11 caption proportions with the familiar red hover. The glyph is a
         vector Path, not the "✕" character, so it stays perfectly crisp and
         evenly weighted at any DPI instead of depending on font hinting. The red
         is a state layer faded in (same approach as the other buttons) rather
         than a background swap, so it eases in and needs no colour animation. -->
    <!-- Windows 11 proportions: a full-height, square 46px caption button in the corner.
         DWM rounds the window corner itself, so the square hover fill is clipped to match. -->
    <Style x:Key="CaptionCloseButton" TargetType="Button">
        <Setter Property="Width"  Value="46"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Win11FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Fill" Background="#C42B1C" Opacity="0" CornerRadius="0"/>
                        <Path x:Name="Glyph"
                              Data="M 0,0 L 10,10 M 10,0 L 0,10"
                              Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glyph" Property="Stroke" Value="#FFFFFF"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fill"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.13"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fill"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.13"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="#A82318"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!--  SEPARATOR                                                   -->
    <!-- ============================================================ -->
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="0,8"/>
    </Style>

    <!-- ============================================================ -->
    <!--  PROGRESS BAR                                                -->
    <!-- ============================================================ -->
    <Style x:Key="AccentProgressBar" TargetType="ProgressBar">
        <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBlueBrush}"/>
        <Setter Property="Height" Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="3" Height="6">
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                HorizontalAlignment="Left" CornerRadius="3"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!--  SIDEBAR NAV BUTTON                                          -->
    <!-- ============================================================ -->
    <!-- Windows 11 NavigationView item: 36px tall, 4px corners, primary text on every item.
         The selected item gets a subtle fill here. The accent pill that marks it is ONE shared
         indicator in MainWindow that slides between items the way NavigationView animates,
         rather than a bar drawn inside each button, so this template has no accent bar. -->
    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Win11FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4"/>
                        <Border x:Name="Hover" Background="{DynamicResource NavHoverBrush}" CornerRadius="4"
                                Opacity="0" IsHitTestVisible="False"/>
                        <Border x:Name="FocusRing" CornerRadius="6" Margin="-2" BorderThickness="2"
                                BorderBrush="{DynamicResource TextPrimaryBrush}"
                                Opacity="0" IsHitTestVisible="False"/>
                        <ContentPresenter x:Name="Presenter" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.083"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.083"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- Press stays instant: delayed feedback on click feels broken. -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Presenter" Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <!-- Keyboard focus: the Windows 11 focus ring -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Active state: section name (Tag) matches DataContext.ActiveSection.
                 Same binding as before the overhaul; only the visual changed. -->
            <DataTrigger Value="True">
                <DataTrigger.Binding>
                    <MultiBinding>
                        <MultiBinding.Converter>
                            <conv:EqualityConverter/>
                        </MultiBinding.Converter>
                        <Binding Path="DataContext.ActiveSection"
                                 RelativeSource="{RelativeSource AncestorType=Window}"/>
                        <Binding RelativeSource="{RelativeSource Self}" Path="Tag"/>
                    </MultiBinding>
                </DataTrigger.Binding>
                <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================ -->
    <!--  TEXTBOX                                                     -->
    <!-- ============================================================ -->
    <!-- Windows 11 text input: subtle fill, 4px corners, and an accent underline when focused. -->
    <Style x:Key="DarkTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource ControlFillBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBlueBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBlueBrush}"/>
        <Setter Property="SelectionOpacity" Value="0.35"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Border>
                        <Border x:Name="FocusLine" Height="2" VerticalAlignment="Bottom" Margin="1,0"
                                CornerRadius="0,0,4,4" Background="{DynamicResource AccentBlueBrush}"
                                Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Hover first, so a focused box keeps its focused look under the pointer. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlFillHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource InputFocusBrush}"/>
                            <Setter TargetName="FocusLine" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!--  SECTION LABEL  (uppercase category headers)                 -->
    <!-- ============================================================ -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- ============================================================ -->
    <!--  STATUS PILL  (small inline status badges)                   -->
    <!-- ============================================================ -->
    <Style x:Key="StatusPillGreen" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PillGoodBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentGreenBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,2"/>
    </Style>

    <Style x:Key="StatusPillRed" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PillBadBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentRedBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,2"/>
    </Style>

    <Style x:Key="StatusPillGray" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,2"/>
    </Style>

    <!-- ============================================================ -->
    <!--  HELPER / INFORMATIONAL TEXT  (muted blue)                   -->
    <!--  Use this for status messages, hints, and supporting info    -->
    <!--  text — NOT for primary content. Examples: "Active plan: X", -->
    <!--  "Battery pause is supported", recommended-value hints.      -->
    <!-- ============================================================ -->
    <Style x:Key="HelperText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
        <Setter Property="Foreground" Value="{DynamicResource AccentBlueBrush}"/>
    </Style>

    <!-- ============================================================ -->
    <!--  SETTINGS PAGES  (Windows 11 Settings layout)                -->
    <!-- ============================================================ -->

    <!-- Windows 11 check box: 20px rounded square, outlined when clear, accent-filled with a
         black tick when checked. Keyed, not implicit, so it only reaches the check boxes a
         converted page asks for; unstyled ones elsewhere keep their current look until their
         page is converted. -->
    <Style x:Key="Win11CheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Win11FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- Grid, not a horizontal StackPanel, so a long label wraps. The transparent
                         padded Border makes the whole padded area (a full list row) clickable. -->
                    <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="20" Height="20" VerticalAlignment="Center">
                            <Border x:Name="BoxOff" CornerRadius="4" BorderThickness="1"
                                    BorderBrush="{DynamicResource ToggleOffStrokeBrush}" Background="Transparent"/>
                            <Border x:Name="BoxHover" CornerRadius="4" Background="{DynamicResource ControlFillBrush}" Opacity="0"/>
                            <Border x:Name="BoxOn" CornerRadius="4" Background="{DynamicResource AccentBlueBrush}" Opacity="0"/>
                            <Border x:Name="FocusRing" CornerRadius="6" Margin="-3" BorderThickness="2"
                                    BorderBrush="{DynamicResource TextPrimaryBrush}" Opacity="0"/>
                            <Path x:Name="Tick" Data="M 4.5 10.5 L 8.5 14 L 15.5 6.5" Opacity="0"
                                  Stroke="{DynamicResource TextOnAccentBrush}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Grid>
                        <ContentPresenter x:Name="Label" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Label" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BoxHover" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="BoxOn" Property="Opacity" Value="1"/>
                            <Setter TargetName="Tick" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A row in a list page (apps to remove, startup apps): the card look without the
         header/description layout, for rows whose content is built by an ItemTemplate. -->
    <Style x:Key="ListRowCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardLayerBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="ctl:Motion.Entrance" Value="True"/>
    </Style>

    <!-- Group header above a run of cards: Windows 11 "Body Strong". -->
    <Style x:Key="SettingsGroupHeader" TargetType="TextBlock" BasedOn="{StaticResource HeadingSmall}">
        <Setter Property="Margin" Value="2,24,0,8"/>
    </Style>

    <!-- Text under a card's header. Wraps, and stays at a readable width. -->
    <Style x:Key="CardDescription" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SmallFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="LineHeight" Value="17"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="MaxWidth" Value="680"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <!-- Extra lines under a description: a neutral note, a caution, or a reassurance. -->
    <Style x:Key="CardNote" TargetType="TextBlock" BasedOn="{StaticResource CardDescription}">
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
    <Style x:Key="CardNoteWarn" TargetType="TextBlock" BasedOn="{StaticResource CardNote}">
        <Setter Property="Foreground" Value="{DynamicResource AccentYellowBrush}"/>
    </Style>
    <Style x:Key="CardNoteGood" TargetType="TextBlock" BasedOn="{StaticResource CardNote}">
        <Setter Property="Foreground" Value="{DynamicResource AccentGreenBrush}"/>
    </Style>

    <!-- One setting per card: header (+ optional badge) and description on the left, the
         control on the right. Controls/SettingsCard.cs has the properties. Cards stack with a
         4px gap, the rhythm Windows Settings uses. -->
    <ctl:StringDescriptionSelector x:Key="SettingsCardDescriptionSelector">
        <ctl:StringDescriptionSelector.StringTemplate>
            <DataTemplate>
                <TextBlock Text="{Binding}" Style="{StaticResource CardDescription}"/>
            </DataTemplate>
        </ctl:StringDescriptionSelector.StringTemplate>
    </ctl:StringDescriptionSelector>

    <Style TargetType="ctl:SettingsCard">
        <Setter Property="Background" Value="{DynamicResource CardLayerBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="18,14"/>
        <Setter Property="ctl:Motion.Entrance" Value="True"/>
        <Setter Property="MinHeight" Value="68"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="BadgeBrush" Value="{DynamicResource AccentBlueBrush}"/>
        <Setter Property="ExtraBadgeBrush" Value="{DynamicResource AccentGreenBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctl:SettingsCard">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            MinHeight="{TemplateBinding MinHeight}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path x:Name="IconPath" Grid.Column="0" Width="18" Height="18" Stretch="Uniform"
                                  Margin="0,0,16,0" VerticalAlignment="Center"
                                  Data="{TemplateBinding IconData}"
                                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <ContentPresenter Content="{TemplateBinding Header}" VerticalAlignment="Center"
                                                      TextElement.FontSize="14"
                                                      TextElement.Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <Border x:Name="BadgePill" Margin="8,0,0,0" CornerRadius="4" Padding="6,1"
                                            VerticalAlignment="Center" BorderThickness="1"
                                            BorderBrush="{TemplateBinding BadgeBrush}"
                                            Background="{DynamicResource ControlFillBrush}">
                                        <TextBlock Text="{TemplateBinding Badge}" FontSize="11"
                                                   Foreground="{TemplateBinding BadgeBrush}"/>
                                    </Border>
                                    <Border x:Name="ExtraBadgePill" Margin="6,0,0,0" CornerRadius="4" Padding="6,1"
                                            ToolTip="{TemplateBinding ExtraBadgeToolTip}" ToolTipService.InitialShowDelay="300"
                                            VerticalAlignment="Center" BorderThickness="1"
                                            BorderBrush="{TemplateBinding ExtraBadgeBrush}"
                                            Background="{DynamicResource ControlFillBrush}">
                                        <TextBlock Text="{TemplateBinding ExtraBadge}" FontSize="11"
                                                   Foreground="{TemplateBinding ExtraBadgeBrush}"/>
                                    </Border>
                                </StackPanel>
                                <!-- Plain-string descriptions (Description="…") render exactly like the
                                     TextBlock ones written with CardDescription. A selector, not a typed
                                     DataTemplate in Resources, so it only ever touches this presenter's own
                                     content and never the captions of buttons nested in a description. -->
                                <ContentPresenter x:Name="DescriptionHost" Content="{TemplateBinding Description}"
                                                  ContentTemplateSelector="{StaticResource SettingsCardDescriptionSelector}"
                                                  Margin="0,3,0,0"
                                                  TextElement.FontSize="12"
                                                  TextElement.Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <ContentPresenter Grid.Column="2" Margin="20,0,0,0"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IconData" Value="{x:Null}">
                            <Setter TargetName="IconPath" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Badge" Value="{x:Null}">
                            <Setter TargetName="BadgePill" Property="Visibility" Value="Collapsed"/>
                            <!-- Alone, the green pill keeps the first pill's gap from the header. -->
                            <Setter TargetName="ExtraBadgePill" Property="Margin" Value="8,0,0,0"/>
                        </Trigger>
                        <Trigger Property="ExtraBadge" Value="{x:Null}">
                            <Setter TargetName="ExtraBadgePill" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="DescriptionHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!--  SETTINGS EXPANDER (Windows 11)                              -->
    <!-- ============================================================ -->
    <!-- A section that opens to show its settings: a card whose header row (an ExpanderButton
         with a rotating chevron) sits above child rows split by hairlines. -->
    <Style x:Key="ExpanderCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardLayerBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="ctl:Motion.Entrance" Value="True"/>
    </Style>

    <!-- Title in an expander's header row: same size and colour as a SettingsCard header -->
    <Style x:Key="ExpanderHeaderTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- A setting inside an open expander: square, transparent, a hairline above, and indented
         a little so it reads as belonging to the header above it. -->
    <Style x:Key="ExpanderItem" TargetType="ctl:SettingsCard" BasedOn="{StaticResource {x:Type ctl:SettingsCard}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="34,12,18,12"/>
        <Setter Property="MinHeight" Value="60"/>
        <Setter Property="ctl:Motion.Entrance" Value="False"/>
    </Style>

    <!-- The top row of a group that is always open (a setting with its own sub-settings under
         it, like NVIDIA's power mode with plugged-in and battery pickers): a SettingsCard with no
         chrome of its own, sitting inside an ExpanderCard above its ExpanderItem rows. -->
    <Style x:Key="ExpanderHeaderCard" TargetType="ctl:SettingsCard" BasedOn="{StaticResource {x:Type ctl:SettingsCard}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="ctl:Motion.Entrance" Value="False"/>
    </Style>

    <!-- Free-form content inside an open expander (tables, number pickers), same inset and hairline -->
    <Style x:Key="ExpanderBlock" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="34,14,18,14"/>
    </Style>

    <!-- ============================================================ -->
    <!--  TOOLTIP  (implicit, Windows 11)                             -->
    <!-- ============================================================ -->
    <!-- Implicit, so every tooltip in the app picks it up, including the ones that local
         styles set through a ToolTip setter. Long tooltips wrap instead of running off
         the screen. Only the look changes: content, timing and placement are WPF's own. -->
    <Style TargetType="ToolTip">
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource SmallFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource PopupBrush}"
                            BorderBrush="{DynamicResource PopupStrokeBrush}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="9,6,9,7" MaxWidth="360">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!--  RIGHT-CLICK MENUS                                           -->
    <!-- ============================================================ -->
    <!-- Windows 11 dark menu flyout: rounded 8px, the dropdowns' fill and stroke, 4px-rounded
         highlight. Implicit, so the Cut / Copy / Paste menu WPF gives every text box uses it
         instead of the classic light menu. Systema has no submenus, so items are single rows. -->
    <Style TargetType="ContextMenu">
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource PopupStrokeBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="160">
                        <StackPanel IsItemsHost="True" Grid.IsSharedSizeScope="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="12,0,12,0"
                            MinHeight="32" SnapsToDevicePixels="True">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIcon"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemGesture"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="IconHost" ContentSource="Icon" Width="16" Height="16"
                                              Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                              VerticalAlignment="Center"/>
                            <TextBlock x:Name="Gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                       Margin="28,0,0,0" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PopupItemHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/>
                            <Setter TargetName="Gesture" Property="Foreground" Value="{DynamicResource DisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="-4,4" Background="{DynamicResource PopupStrokeBrush}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
