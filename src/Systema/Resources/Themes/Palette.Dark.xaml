<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================ -->
    <!--  PALETTE — Windows 11 dark                                   -->
    <!-- ============================================================ -->
    <!-- Every colour Systema draws with, for the dark theme. Palette.Light.xaml has the SAME keys
         with Windows 11 light values; Core/ThemeManager.cs loads one or the other to follow Windows
         (Settings > Personalization > Colors), live, and replaces the Accent* brushes with the
         user's own accent colour. Styles and pages refer to these with DynamicResource so a switch
         repaints everything at once.

         Values here are exactly what the dark UI used before the light theme existed, so dark mode
         looks the same: neutral greys matching the Settings app (#202020 window, #2B2B2B cards),
         and green / amber / red for status only. -->
    <Color x:Key="BgPrimaryColor">#202020</Color>   <!-- window base, title bar, nav pane -->
    <Color x:Key="BgSurfaceColor">#2D2D2D</Color>   <!-- inputs and inset boxes           -->
    <Color x:Key="BgSidebarColor">#202020</Color>   <!-- nav pane sits on the window base -->
    <Color x:Key="BgCardColor">#2B2B2B</Color>      <!-- settings cards                   -->
    <Color x:Key="AccentBlueColor">#60CDFF</Color>  <!-- replaced by the user's accent    -->
    <Color x:Key="AccentGreenColor">#22C55E</Color> <!-- success                          -->
    <Color x:Key="AccentYellowColor">#F59E0B</Color><!-- warning                          -->
    <Color x:Key="AccentRedColor">#EF4444</Color>   <!-- error                            -->
    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#C8C8C8</Color>
    <Color x:Key="TextTertiaryColor">#9A9A9A</Color>
    <Color x:Key="DisabledColor">#6B6B6B</Color>
    <Color x:Key="BorderColor">#353535</Color>
    <Color x:Key="HoverColor">#333333</Color>

    <SolidColorBrush x:Key="BgPrimaryBrush" Color="{StaticResource BgPrimaryColor}"/>
    <SolidColorBrush x:Key="BgSurfaceBrush" Color="{StaticResource BgSurfaceColor}"/>
    <SolidColorBrush x:Key="BgSidebarBrush" Color="{StaticResource BgSidebarColor}"/>
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}"/>
    <!-- Card fill for the main window. Solid here; with Mica on, MainWindow swaps in
         CardOverMicaBrush, the Settings app's own card layer, so the wallpaper tint shows through
         (5% white over #202020 is exactly #2B2B2B, so an unfocused window looks the same). -->
    <SolidColorBrush x:Key="CardLayerBrush" Color="{StaticResource BgCardColor}"/>
    <SolidColorBrush x:Key="CardOverMicaBrush" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlueColor}"/>
    <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreenColor}"/>
    <SolidColorBrush x:Key="AccentYellowBrush" Color="{StaticResource AccentYellowColor}"/>
    <SolidColorBrush x:Key="AccentRedBrush" Color="{StaticResource AccentRedColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}"/>
    <SolidColorBrush x:Key="DisabledBrush" Color="{StaticResource DisabledColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent"/>

    <!-- Windows 11 control layers. The fills are translucent white, the way WinUI defines
         them, so a button or input reads correctly on the window base AND on a card without
         needing a second colour for each surface. -->
    <SolidColorBrush x:Key="TextOnAccentBrush"      Color="#000000"/>   <!-- text on accent fills -->
    <SolidColorBrush x:Key="ControlFillBrush"       Color="#0FFFFFFF"/> <!-- buttons, inputs      -->
    <SolidColorBrush x:Key="ControlFillHoverBrush"  Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="ControlStrokeBrush"     Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="NavHoverBrush"          Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="NavSelectedBrush"       Color="#15FFFFFF"/>
    <SolidColorBrush x:Key="SubtleSelectedBrush"    Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="PopupBrush"             Color="#2C2C2C"/>   <!-- menus, dropdowns, tooltips -->
    <SolidColorBrush x:Key="PopupStrokeBrush"       Color="#3A3A3A"/>
    <SolidColorBrush x:Key="PopupItemHoverBrush"    Color="#16FFFFFF"/>
    <SolidColorBrush x:Key="InputFocusBrush"        Color="#1F1F1F"/>   <!-- a focused input darkens -->
    <SolidColorBrush x:Key="ToggleOffStrokeBrush"   Color="#9A9A9A"/>
    <!-- Hover / press layer on ghost and expander buttons (shown at low opacity). -->
    <SolidColorBrush x:Key="StateLayerBrush"        Color="#FFFFFF"/>
    <!-- Keyboard focus ring (Win11FocusVisual). -->
    <SolidColorBrush x:Key="FocusStrokeOuterBrush"  Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FocusStrokeInnerBrush"  Color="#B3000000"/>
    <!-- WPF's own popups (e.g. a ComboBox's) read the system Window colour. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#2C2C2C"/>

    <!-- Scroll bars (overlay style, see Dark.xaml). -->
    <SolidColorBrush x:Key="ScrollInkBrush"         Color="#8BFFFFFF"/>
    <SolidColorBrush x:Key="ScrollInkHoverBrush"    Color="#C5FFFFFF"/>
    <SolidColorBrush x:Key="ScrollInkPressedBrush"  Color="#E6FFFFFF"/>
    <SolidColorBrush x:Key="ScrollTrackBrush"       Color="#2C2C2C"/>

    <!-- Neutral overlays: translucent white on dark (translucent black on light). -->
    <SolidColorBrush x:Key="OverlaySubtleBrush"     Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="OverlayStrokeBrush"     Color="#18FFFFFF"/>
    <SolidColorBrush x:Key="OverlayLightBrush"      Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="OverlayStrongBrush"     Color="#22FFFFFF"/>

    <!-- Accent tints (info bars, selection, the memory graph). ThemeManager rebuilds these from
         the user's accent; these values are the default blue. -->
    <SolidColorBrush x:Key="AccentAlpha09Brush"     Color="#1760CDFF"/>
    <SolidColorBrush x:Key="AccentAlpha10Brush"     Color="#1A60CDFF"/>
    <SolidColorBrush x:Key="AccentAlpha18Brush"     Color="#2E60CDFF"/>
    <SolidColorBrush x:Key="AccentAlpha20Brush"     Color="#3360CDFF"/>
    <SolidColorBrush x:Key="AccentAlpha30Brush"     Color="#4D60CDFF"/>
    <SolidColorBrush x:Key="AccentAlpha40Brush"     Color="#6660CDFF"/>

    <!-- Status tints (success / caution / critical backgrounds and strokes). -->
    <SolidColorBrush x:Key="SuccessAlpha05Brush"    Color="#0C22C55E"/>
    <SolidColorBrush x:Key="SuccessAlpha10Brush"    Color="#1A22C55E"/>
    <SolidColorBrush x:Key="SuccessAlpha13Brush"    Color="#2222C55E"/>
    <SolidColorBrush x:Key="SuccessAlpha20Brush"    Color="#3322C55E"/>
    <SolidColorBrush x:Key="CautionAlpha08Brush"    Color="#14F59E0B"/>
    <SolidColorBrush x:Key="CautionAlpha10Brush"    Color="#1AF59E0B"/>
    <SolidColorBrush x:Key="CautionAlpha13Brush"    Color="#22F59E0B"/>
    <SolidColorBrush x:Key="CautionAlpha23Brush"    Color="#3AF59E0B"/>
    <SolidColorBrush x:Key="CriticalAlpha10Brush"   Color="#1AEF4444"/>
    <SolidColorBrush x:Key="CriticalAlpha13Brush"   Color="#22EF4444"/>

    <!-- Small status badges and pills (Systema Engine's process table and log, status pills). -->
    <SolidColorBrush x:Key="BadgeNappingBrush"      Color="#332B1A"/>   <!-- amber -->
    <SolidColorBrush x:Key="BadgeActiveBrush"       Color="#1F2A35"/>   <!-- blue  -->
    <SolidColorBrush x:Key="BadgePendingBrush"      Color="#1F1F2A"/>   <!-- violet grey -->
    <SolidColorBrush x:Key="BadgeNeutralBrush"      Color="#1F1F22"/>
    <SolidColorBrush x:Key="BadgeGoodBrush"         Color="#1A2620"/>   <!-- green -->
    <SolidColorBrush x:Key="BadgeBadBrush"          Color="#2A1A1C"/>   <!-- red   -->
    <SolidColorBrush x:Key="PillGoodBrush"          Color="#16231B"/>
    <SolidColorBrush x:Key="PillBadBrush"           Color="#251A1C"/>
    <SolidColorBrush x:Key="TextInfoBrush"          Color="#7395B5"/>   <!-- muted blue labels -->
    <!-- Game Booster's "what boosting does" banner. -->
    <SolidColorBrush x:Key="InfoBannerBrush"        Color="#16232A"/>
    <SolidColorBrush x:Key="InfoBannerStrokeBrush"  Color="#2C4C57"/>
</ResourceDictionary>
