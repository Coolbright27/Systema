<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>Systema</AssemblyName>
    <RootNamespace>Systema</RootNamespace>
    <Version>0.7.298</Version>
    <Company>Systema</Company>
    <Product>Systema Optimization Suite</Product>
    <Description>High-performance Windows optimization suite</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <Platforms>x64</Platforms>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    Single-file publish so the app ships as ONE Systema.exe instead of a folder full
    of separate DLLs. Smart App Control (Windows 11 25H2 kernel-level WDAC policy)
    rates each unsigned binary independently and was blocking Systema.dll on its
    own. Bundling everything inside Systema.exe removes that surface entirely —
    SAC and SmartScreen only see one file to evaluate.

    These properties are publish-time only (dotnet build ignores them, dotnet publish
    honours them), so they're safe to leave unconditional.

    COMPRESSION IS ON (known-good config that ran cleanly on v0.7.9/v0.7.10).
    Turning it OFF was tried in v0.7.13 to dodge a "packer" heuristic, but it
    backfired: an uncompressed bundle stores every managed DLL in the open and
    extracts the full set as loose files to {app}\runtime at launch, giving
    Defender many individually-scannable files — one got quarantined ("part of
    the app was blocked"). The compressed bundle keeps managed assemblies inside
    Systema.exe (loaded from memory) so there are far fewer loose files on disk.
    Do NOT flip this back to false.
  -->
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Native libs MUST extract (they can't load from a bundle in memory). -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- IncludeAllContentForSelfExtract is DELIBERATELY OFF. When true, .NET
         extracts EVERY file — including the unsigned managed Systema.dll — to
         disk before running. That loose Systema.dll is precisely what Smart App
         Control blocks ("Some parts of this app have been blocked"). With it off,
         managed assemblies stay inside Systema.exe and load from memory, so the
         only files that ever touch disk are the Microsoft-signed native runtime
         DLLs — which SAC trusts. This is the entire reason single-file publish
         was adopted; do NOT set this to true. -->
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Systema.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="System.Management" Version="10.0.3" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.3" />
    <PackageReference Include="TaskScheduler" Version="2.12.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embed the icon in the assembly so the system-tray icon (TrayService.LoadIcon) always loads the
         current build's logo straight from memory. We no longer copy it loose next to the exe: single-file
         publish doesn't deploy it reliably, and a stale {app}\Assets\logo.ico left by an old installer was
         being read instead, so the tray kept the old logo. The taskbar/exe icon still comes from
         <ApplicationIcon> above, which reads the same file at build time. -->
    <EmbeddedResource Include="Assets\logo.ico" />
  </ItemGroup>

</Project>
